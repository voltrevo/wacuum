// What both fixture runners need: reading execution-spec-tests' JSON — numbers, bytes, a pre-state — and
// saying how a world differs from the post-state a fixture expects.

import { Map } from "core";
import { Sys } from "std";
import { json.JsonValue, json.JsonObject } from "wac";
import { U256 } from "../src/u256.wac";
import { hexToBytes, bytesToHex } from "../src/hex.wac";
import { World, Account, hashU256, eqU256 } from "../src/state/world.wac";

export U256 num(JsonValue? v) {
  if (v is null) { return U256.zero(); }
  string? s = v!.text();
  if (s is null) { return U256.zero(); }
  if (s! == "0x" || s! == "") { return U256.zero(); }
  U256? n = U256.fromHex(s!);
  return n is null ? U256.zero() : n!;
}

export u8[] bytes(JsonValue? v) {
  if (v is null) { return u8[].filled(0, 0); }
  string? s = v!.text();
  if (s is null) { return u8[].filled(0, 0); }
  u8[]? b = hexToBytes(s!);
  return b is null ? u8[].filled(0, 0) : b!;
}

export World worldFrom(JsonValue pre) {
  World w = World.create();
  JsonObject accounts = pre.object()!;
  for (i32 i = 0; i < accounts.len(); i++) {
    U256 addr = U256.fromHex(accounts.at(i).keyStr())!;
    JsonValue a = accounts.at(i).value;
    Account acct = w.touch(addr);
    acct.nonce = num(a.member("nonce")).low();
    acct.balance = num(a.member("balance"));
    JsonObject st = a.member("storage")!.object()!;
    for (i32 k = 0; k < st.len(); k++) {
      U256 v = num(st.at(k).value);
      if (!v.isZero()) { acct.storage.set(U256.fromHex(st.at(k).keyStr())!, v); }
    }
    w.setCode(addr, bytes(a.member("code")));
  }
  // The pre-state is the world before the transaction, not part of it: nothing above may be undone.
  w.endTransaction();
  return w;
}

/** Which accounts differ from the fixture's post-state, and how. */
export void diffState(Sys sys, World w, JsonValue? want) {
  if (want is null) { return; }
  JsonObject accounts = want!.object()!;
  Map<U256, bool> seen = Map.create(hashU256, eqU256);
  for (i32 i = 0; i < accounts.len(); i++) {
    U256 addr = U256.fromHex(accounts.at(i).keyStr())!;
    seen.set(addr, true);
    JsonValue a = accounts.at(i).value;
    Account? got = w.get(addr);
    string where = "  \{addr.toHex()}";
    if (got is null) { sys.log(where + ": missing"); continue; }
    Account g = got!;
    if (g.nonce != num(a.member("nonce")).low()) { sys.log(where + ": nonce \{g.nonce}, want \{num(a.member("nonce")).toDecimal()}"); }
    if (!g.balance.eq(num(a.member("balance")))) {
      sys.log(where + ": balance \{g.balance.toDecimal()}, want \{num(a.member("balance")).toDecimal()}");
    }
    if (bytesToHex(g.code) != bytesToHex(bytes(a.member("code")))) { sys.log(where + ": code differs"); }
    JsonObject st = a.member("storage")!.object()!;
    Map<U256, bool> keys = Map.create(hashU256, eqU256);
    for (i32 k = 0; k < st.len(); k++) {
      U256 key = U256.fromHex(st.at(k).keyStr())!;
      keys.set(key, true);
      U256 v = num(st.at(k).value);
      U256 have = g.storage.getOr(key, U256.zero());
      if (!have.eq(v)) { sys.log(where + ": slot \{key.toHex()} = \{have.toHex()}, want \{v.toHex()}"); }
    }
    U256[] mine = g.storage.keys();
    for (i32 k = 0; k < mine.len(); k++) {
      if (!keys.has(mine[k])) { sys.log(where + ": slot \{mine[k].toHex()} = \{g.storage.get(mine[k])!.toHex()}, want nothing"); }
    }
  }
  U256[] all = w.accounts.keys();
  for (i32 i = 0; i < all.len(); i++) {
    if (!seen.has(all[i])) { sys.log("  \{all[i].toHex()}: present, want absent"); }
  }
}

