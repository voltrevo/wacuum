{
  // Every unit test, in wac.
  test: "wac test test",
  // Regenerate test/u256_vectors.wac — U256 against JavaScript's BigInt.
  vectors: "node tools/u256-vectors.mjs",
  // execution-spec-tests' fixtures into fixtures/, once.
  fixtures: "sh tools/fetch-fixtures.sh",
  // Every state test for Cancun; the log of the run is dist/statetests.log.
  statetests: "sh tools/statetests.sh",
  // Every blockchain test for Cancun, importing each block from its RLP; the log is dist/blocktests.log.
  blocktests: "sh tools/blocktests.sh",
  // Every engine test for Cancun, through engine_newPayload and engine_forkchoiceUpdated.
  enginetests: "sh tools/enginetests.sh",
  // Block building, rebuilding every engine fixture's payloads from the mempool.
  buildtests: "sh tools/buildtests.sh",
  // The node, as one executable file.
  build: "wac app --allow-read --allow-write --allow-net cmd/wacuum.wac -o dist/wacuum",
}
