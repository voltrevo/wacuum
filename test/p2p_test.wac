// devp2p's pieces against vectors from independent implementations: secp256k1 against ethers (whose
// signer is also RFC 6979, so the signatures must agree byte for byte), and RLPx against EIP-8.

import { U256 } from "../src/u256.wac";
import { hexToBytes, bytesToHex } from "../src/hex.wac";
import { publicKey, ecdh, sign, recover } from "../src/p2p/secp.wac";
import { Hello, Session, readAuth, readAck, makeAuth, makeAck, secrets, session, writeFrame, readFrameHeader,
         readFrameBody } from "../src/p2p/rlpx.wac";
import { snappyEncode, snappyDecode } from "../src/p2p/snappy.wac";
import { Check } from "./check.wac";

static string KEY_A = "1111111111111111111111111111111111111111111111111111111111111111";
static string KEY_B = "4b4b4b4b4b4b4b4b4b4b4b4b4b4b4b4ba7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7";

export string test_secp256k1_agrees_with_ethers() {
  Check t = Check.create();
  u8[] a = hexToBytes(KEY_A)!;
  u8[] b = hexToBytes(KEY_B)!;
  string pubA = "0x4f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa385b6b1b8ead809ca67454d9683fcf2ba03456d6fe2c4abe2b07f0fbdbb2f1c1";
  string pubB = "0xddf30d4315b1de35221b5b259ef4872094531b18337a7eef12507a6c5fa8e048f4936241e4aeb5e28706ee0148fb95fbed9ddc257d92b6133e77d3351d865621";
  t.eqStr(bytesToHex(publicKey(a)), pubA, "a public key");
  t.eqStr(bytesToHex(publicKey(b)), pubB, "another");
  u8[] h = hexToBytes("f2aca0a8236f9e5864e111dfa343cf2b23ca10fb1bd1efc34d1c5390737ff144")!;
  u8[] sig = sign(h, a);
  t.eqStr(bytesToHex(sig), "0xbd57fd611e4d986f382b669e0ba28a28d7c085c3eb800403bf5bd7be11340007680be64eacbe3bd08ae0b9f02fe30577c4c0cc71f89c89f8c973776d35b7ac2e01", "an RFC 6979 signature");
  t.eqStr(bytesToHex(recover(h, sig) ?? u8[].filled(0, 0)), pubA, "recovers to its signer");
  t.eqStr(bytesToHex(ecdh(a, publicKey(b))!), "0xae5c1efb1767a4772ea99a972b1ab79faf645efa7eac1187fc605a745b3fc8c0", "ECDH");
  t.eqStr(bytesToHex(ecdh(b, publicKey(a))!), bytesToHex(ecdh(a, publicKey(b))!), "both ways");
  return t.report();
}

// RLPx's handshake against EIP-8's test vectors: A dials B. Each auth and ack, in the old form and in
// EIP-8's (with and without extra list elements), must open with the receiver's key and say who sent it;
// and B's secrets for (Auth₂, Ack₂) and its ingress MAC must be the ones the EIP gives.

static string AUTH1 = "";
static string AUTH2 = "";
static string AUTH3 = "";
static string ACK1 = "";
static string ACK2 = "";
static string ACK3 = "";
static string STATIC_A = "49a7b37aa6f6645917e7b807e9d1c00d4fa71f18343b0d4122a4d2df64dd6fee";
static string STATIC_B = "b71c71a67e1177ad4e901695e1b4b9ee17ae16c6668d313eac2f96dbcda3f291";
static string EPH_A = "869d6ecf5211f1cc60418a13b9d870b22959d0c16f02bec714c960dd2298a32d";
static string EPH_B = "e238eb8e04fee6511ab04c6dd3c89ce097b11f25d584863ac2b6d5b35b1847e4";
static string NONCE_A = "0x7e968bba13b6c50e2c4cd7f241cc0d64d1ac25c7f5952df231ac6a2bda8ee5d6";
static string NONCE_B = "0x559aead08264d5795d3909718cdd05abd49572e84fe55590eef31a88a08fdffd";

export string test_rlpx_handshake_matches_eip8() {
  Check t = Check.create();
  u8[] a = hexToBytes(STATIC_A)!;
  u8[] b = hexToBytes(STATIC_B)!;
  string[] auths = [AUTH1, AUTH2, AUTH3];
  for (i32 i = 0; i < 3; i++) {
    Hello h = readAuth(b, hexToBytes(auths[i])!);
    t.eqStr(h.error, "", "auth \{i + 1} opens");
    t.eqStr(bytesToHex(h.staticKey), bytesToHex(publicKey(a)), "auth \{i + 1} is from A");
    t.eqStr(bytesToHex(h.ephemeralKey), bytesToHex(publicKey(hexToBytes(EPH_A)!)), "with A's ephemeral key");
    t.eqStr(bytesToHex(h.nonce), NONCE_A, "and A's nonce");
  }
  string[] acks = [ACK1, ACK2, ACK3];
  for (i32 i = 0; i < 3; i++) {
    Hello h = readAck(a, hexToBytes(acks[i])!);
    t.eqStr(h.error, "", "ack \{i + 1} opens");
    t.eqStr(bytesToHex(h.ephemeralKey), bytesToHex(publicKey(hexToBytes(EPH_B)!)), "ack \{i + 1} has B's ephemeral key");
    t.eqStr(bytesToHex(h.nonce), NONCE_B, "and B's nonce");
  }
  u8[][] sec = secrets(hexToBytes(EPH_B)!, publicKey(hexToBytes(EPH_A)!), hexToBytes(NONCE_A)!, hexToBytes(NONCE_B)!);
  t.eqStr(bytesToHex(sec[0]), "0x80e8632c05fed6fc2a13b0f8d31a3cf645366239170ea067065aba8e28bac487", "aes-secret");
  t.eqStr(bytesToHex(sec[1]), "0x2ea74ec5dae199227dff1af715362700e989d889d7a493cb0639691efb8e5f98", "mac-secret");
  Session s = session(false, hexToBytes(EPH_B)!, publicKey(hexToBytes(EPH_A)!), hexToBytes(NONCE_A)!, hexToBytes(NONCE_B)!,
                      hexToBytes(AUTH2)!, hexToBytes(ACK2)!, publicKey(a));
  s.ingressMac.update("foo".toBytes());
  t.eqStr(bytesToHex(s.ingressMac.peek()), "0x0c7ec6340062cc46f5e9f1e3cf86f8c8c403c5a0964f5df0ebd34a75ddc86db5", "ingress-mac(foo)");
  return t.report();
}

export string test_rlpx_both_ends_agree() {
  Check t = Check.create();
  u8[] a = hexToBytes(STATIC_A)!;
  u8[] b = hexToBytes(STATIC_B)!;
  u8[] ea = hexToBytes(EPH_A)!;
  u8[] eb = hexToBytes(EPH_B)!;
  u8[] na = hexToBytes(NONCE_A)!;
  u8[] nb = hexToBytes(NONCE_B)!;
  u8[] iv = u8[].filled(16, 7);
  u8[] auth = makeAuth(a, publicKey(b), ea, na, u8[].filled(150, 0), eb, iv);
  Hello ha = readAuth(b, auth);
  t.eqStr(ha.error, "", "our auth opens");
  u8[] ack = makeAck(ha.staticKey, eb, nb, u8[].filled(120, 0), ea, iv);
  Hello hb = readAck(a, ack);
  t.eqStr(hb.error, "", "our ack opens");
  Session sa = session(true, ea, hb.ephemeralKey, na, hb.nonce, auth, ack, publicKey(b));
  Session sb = session(false, eb, ha.ephemeralKey, ha.nonce, nb, auth, ack, ha.staticKey);
  for (i32 i = 0; i < 3; i++) {
    u8[] msg = "frame \{i}, a little longer than a block so that it pads".toBytes();
    u8[] f = writeFrame(sa, msg);
    i32 size = readFrameHeader(sb, f);
    t.ok(size == msg.len(), "frame \{i}'s header");
    u8[] rest = u8[].filled(f.len() - 32, 0);
    for (i32 k = 0; k < rest.len(); k++) { rest[k] = f[32 + k]; }
    u8[]? got = readFrameBody(sb, rest, size);
    t.ok(got is not null && string.fromBytes(got!) == string.fromBytes(msg), "frame \{i}'s body");
    u8[] back = writeFrame(sb, msg);
    t.ok(readFrameHeader(sa, back) == msg.len(), "and the other way");
    u8[] rest2 = u8[].filled(back.len() - 32, 0);
    for (i32 k = 0; k < rest2.len(); k++) { rest2[k] = back[32 + k]; }
    t.ok(readFrameBody(sa, rest2, msg.len()) is not null, "with its body");
  }
  return t.report();
}

/** What snappyjs makes of "", "a", a sentence twenty times, and 300 x's. */
static string[] SNAPPED = ["0x00", "0x010061",
  "0x88041c77616375756d20760507307320757020626c6f636b732c20fe1a00fe1a00fe1a00fe1a00fe1a00fe1a00fe1a00b61a00",
  "0xac020078fe0100fe0100fe0100fe0100aa0100"];

string repeat(string s, i32 n) {
  string out = "";
  for (i32 i = 0; i < n; i++) { out += s; }
  return out;
}

export string test_snappy_reads_the_reference_and_round_trips() {
  Check t = Check.create();
  string[] plain = ["", "a", repeat("wacuum vacuums up blocks, ", 20), repeat("x", 300)];
  for (i32 i = 0; i < plain.len(); i++) {
    u8[]? d = snappyDecode(hexToBytes(SNAPPED[i])!);
    t.ok(d is not null && string.fromBytes(d!) == plain[i], "snappyjs's encoding \{i} decodes");
    u8[]? back = snappyDecode(snappyEncode(plain[i].toBytes()));
    t.ok(back is not null && string.fromBytes(back!) == plain[i], "ours \{i} round-trips");
  }
  u8[] bin = u8[].filled(70000, 0);
  for (i32 i = 0; i < bin.len(); i++) { bin[i] = (((i * 7919) >> 3) & 0xff) as! u8; }
  u8[] packed = snappyEncode(bin);
  u8[]? back = snappyDecode(packed);
  t.ok(back is not null && bytesToHex(back!) == bytesToHex(bin), "70,000 bytes round-trip");
  t.ok(packed.len() < 20000, "and compress: \{packed.len()} bytes");
  t.ok(snappyDecode(hexToBytes("0x0a0100")!) is null, "a short output is refused");
  t.ok(snappyDecode(hexToBytes("0x040d01")!) is null, "a copy from before the start is refused");
  return t.report();
}
