// Osaka's cell proofs against micro-eth-signer's: the blob whose element i is i² + 1, two of its cells
// (3 and 100) with their proofs, verified together and refused when anything is changed.

import { hexToBytes } from "../src/hex.wac";
import { verifyCellProofs, computeCells } from "../src/crypto/cells.wac";
import { U256 } from "../src/u256.wac";
import { bytesToHex } from "../src/hex.wac";
import { Check } from "./check.wac";

static string COMMITMENT = "0xb7c82ff57d986aa2622ffefb910b85ea77d9da8fccd2634bd6a125d2705a334525c781e9f58f0026123e02ef0eaa76dc";
static string CELL_3 = "";
static string CELL_100 = "";
static string PROOF_3 = "0xa6795c1cf203fd6a78a3bb3316b98f3d5488289a251cca8148edd3de84fe9119261fbb5437e2ef4489b70663013f3a15";
static string PROOF_100 = "0x94fe3f77ff1f573df163e81b5ae16174da06d6f51b66a540552f3575855d73a490f0d258ad3fa399af6ba7d4493a4321";

export string test_cell_proofs_verify_and_forgeries_do_not() {
  Check t = Check.create();
  u8[] c = hexToBytes(COMMITMENT)!;
  u8[][] cells = [hexToBytes(CELL_3)!, hexToBytes(CELL_100)!];
  u8[][] proofs = [hexToBytes(PROOF_3)!, hexToBytes(PROOF_100)!];
  t.ok(verifyCellProofs([c, c], [3, 100], cells, proofs), "two cells of one blob verify together");
  t.ok(verifyCellProofs([c], [100], [cells[1]], [proofs[1]]), "and one alone");
  t.ok(!verifyCellProofs([c, c], [100, 3], cells, proofs), "not under each other's indices");
  t.ok(!verifyCellProofs([c, c], [3, 100], cells, [proofs[1], proofs[0]]), "nor with their proofs swapped");
  u8[] bent = hexToBytes(CELL_3)!;
  bent[40] = bent[40] ^ 1;
  t.ok(!verifyCellProofs([c], [3], [bent], [proofs[0]]), "nor with a cell changed");
  u8[] point = u8[].filled(48, 0);
  point[0] = 0xc0;
  t.ok(verifyCellProofs([point], [77], [u8[].filled(2048, 0)], [point]), "the zero blob's cells are proved by the identity");
  return t.report();
}

export string test_a_blob_extends_to_the_same_cells() {
  Check t = Check.create();
  u8[] blob = u8[].filled(131072, 0);
  for (i32 i = 0; i < 4096; i++) { U256.ofI32(i * i + 1).writeBytes(blob, 32 * i); }
  u8[][]? cells = computeCells(blob);
  t.ok(cells is not null && cells!.len() == 128, "128 cells");
  t.eqStr(bytesToHex(cells![3]), "0x" + CELL_3.slice(2, CELL_3.len()), "cell 3 is micro-eth-signer's");
  t.eqStr(bytesToHex(cells![100]), "0x" + CELL_100.slice(2, CELL_100.len()), "and cell 100");
  return t.report();
}
