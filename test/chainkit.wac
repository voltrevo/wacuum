// What the engine tests share: a Prague-or-later chain from a genesis with the system contracts in it and
// one funded account (key 0x11…11, address 0x19e7…ff2a), and the JSON plumbing of calling the engine.

import { json.parse, json.JsonValue, json.JsonArray } from "wac";
import { genesisFrom, Genesis } from "../src/chain/genesis.wac";
import { Engine } from "../src/engine/engine.wac";

// The system contracts a Prague block calls (EIP-4788, EIP-2935, EIP-7002, EIP-7251): without them a block
// cannot be built at all.
static string WITHDRAWALS = "";
static string CONSOLIDATIONS = "";
static string HISTORY = "0x3373fffffffffffffffffffffffffffffffffffffffe14604657602036036042575f35600143038111604257611fff81430311604257611fff9006545f5260205ff35b5f5ffd5b5f35611fff60014303065500";
static string BEACON_ROOTS = "0x3373fffffffffffffffffffffffffffffffffffffffe14604d57602036146024575f5ffd5b5f35801560495762001fff810690815414603c575f5ffd5b62001fff01545f5260205ff35b5f5ffd5b62001fff42064281555f359062001fff015500";

export Engine? engineFor(string forks) {
  string g = "{\"config\": {\"chainId\": 1, \{forks}}, \"gasLimit\": \"0x1c9c380\", \"baseFeePerGas\": \"0x3b9aca00\", " +
             "\"alloc\": {\"0x19E7E376E7C213B7E7e7e46cc70A5dD086DAff2A\": {\"balance\": \"0x56bc75e2d63100000\"}" + ", \"0x00000961ef480eb55e80d19ad83579a64c007002\": {\"nonce\": \"0x1\", \"code\": \"" + WITHDRAWALS + "\"}" + ", \"0x0000bbddc7ce488642fb579f8b00f3a590007251\": {\"nonce\": \"0x1\", \"code\": \"" + CONSOLIDATIONS + "\"}" + ", \"0x0000f90827f1c53a10cb7a02335b175320002935\": {\"nonce\": \"0x1\", \"code\": \"" + HISTORY + "\"}" + ", \"0x000f3df6d732807ef1319fb7b8bb8522d0beac02\": {\"nonce\": \"0x1\", \"code\": \"" + BEACON_ROOTS + "\"}" + "}}";
  string[] why = [""];
  match (parse(g.toBytes())) {
    Ok(doc): {
      Genesis gen = genesisFrom(doc, why)!;
      return Engine.create(gen.config, gen.header, gen.world);
    }
    Err(e): { return null; }
  }
}

export JsonValue str(string s) { return JsonValue.Str(s.toBytes()); }

export JsonValue one(JsonValue v) {
  JsonArray a = JsonArray.create();
  a.push(v);
  return JsonValue.Array(a);
}

