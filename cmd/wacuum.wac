// wacuum: the execution client, serving the Engine API to a consensus client.
//
//     wac run --allow-read --allow-write --allow-net cmd/wacuum.wac -- --genesis genesis.json --jwt-secret jwt.hex \
//         [--datadir DIR] [--port 8551]
//
// It starts from a geth-format genesis, listens on 127.0.0.1 (the Engine API is for a consensus client on
// the same machine, and is not meant to face a network), and executes whatever payloads it is sent.
//
// With `--public-rpc`, a request without a token may call everything but the Engine API: the `eth_`,
// `net_` and `web3_` methods a wallet or a library uses.
//
// With `--peer enode://…` (as many as wanted) it dials those nodes and keeps dialling them, and with
// `--p2p-port` it accepts others: it answers their requests for headers and bodies, swaps transactions
// with them, and fetches from them any chain the consensus client names that it has not got.
//
// With `--datadir`, it keeps `chain.log` there: every block it imports and every fork choice, appended
// before the answer that reports it goes out, so a block this node has called VALID is one it still has
// after a restart. Starting, it replays the log onto the genesis. That re-executes the chain, which is
// simple and slow to start for a long one; a state snapshot to start from is the obvious next step. The
// append is a write the operating system has taken, not one it has flushed to the disk, so a crash of the
// process loses nothing and a crash of the machine may lose the last few records.

import { Sys, Output, Socket } from "std";
import { Vec } from "core";
import { json.parse } from "wac";
import { rlp.encode } from "wac";
import { crypto.keccak256 } from "wac";
import { U256 } from "../src/u256.wac";
import { hexToBytes } from "../src/hex.wac";
import { Genesis, genesisFrom } from "../src/chain/genesis.wac";
import { Engine, Replayed } from "../src/engine/engine.wac";
import { headerItem } from "../src/chain/block.wac";
import { HttpRequest, headersEnd, parseHead, answerHttp } from "../src/engine/rpc.wac";
import { Network, dial, listen, tend } from "../src/p2p/node.wac";
import { validKey } from "../src/p2p/secp.wac";

string usage() { return "usage: wacuum --genesis FILE --jwt-secret FILE [--datadir DIR] [--public-rpc] [--peer ENODE]... [--p2p-port N] [--addr 127.0.0.1] [--port 8551]"; }

export async i32 main(Sys sys) {
  string[] args = sys.args();
  string genesisPath = "";
  string secretPath = "";
  string addr = "127.0.0.1";
  string datadir = "";
  bool publicRpc = false;
  Vec<string> peers = Vec.create();
  i32 p2pPort = 0;
  i32 port = 8551;
  for (i32 i = 0; i < args.len(); i += 2) {
    if (args[i] == "--public-rpc") {
      publicRpc = true;
      i--;
      continue;
    }
    if (i + 1 >= args.len()) {
      sys.warn(usage());
      return 2;
    }
    if (args[i] == "--genesis") { genesisPath = args[i + 1]; }
    else if (args[i] == "--jwt-secret") { secretPath = args[i + 1]; }
    else if (args[i] == "--addr") { addr = args[i + 1]; }
    else if (args[i] == "--datadir") { datadir = args[i + 1]; }
    else if (args[i] == "--peer") { peers.push(args[i + 1]); }
    else if (args[i] == "--p2p-port") {
      i32 n = 0;
      u8[] d = args[i + 1].toBytes();
      for (i32 k = 0; k < d.len(); k++) { n = n * 10 + ((d[k] - 48) as i32); }
      p2pPort = n;
    }
    else if (args[i] == "--port") {
      i32 n = 0;
      u8[] d = args[i + 1].toBytes();
      for (i32 k = 0; k < d.len(); k++) { n = n * 10 + ((d[k] - 48) as i32); }
      port = n;
    } else {
      sys.warn(usage());
      return 2;
    }
  }
  if (genesisPath == "" || secretPath == "") {
    sys.warn(usage());
    return 2;
  }

  u8[] secret = u8[].filled(0, 0);
  match (await sys.readFile(secretPath)) {
    Err(e): { sys.warn("wacuum: \{secretPath}: \{e}"); return 1; }
    Ok(b): {
      // The secret file is hex, with or without 0x, and maybe a trailing newline.
      string text = string.fromBytes(b);
      while (text.len() > 0 && (text.slice(text.len() - 1, text.len()) == "\n" || text.slice(text.len() - 1, text.len()) == "\r")) {
        text = text.slice(0, text.len() - 1);
      }
      u8[]? s = hexToBytes(text);
      if (s is null || s!.len() != 32) { sys.warn("wacuum: the JWT secret must be 32 bytes of hex"); return 1; }
      secret = s!;
    }
  }

  Genesis? g = null;
  match (await sys.readFile(genesisPath)) {
    Err(e): { sys.warn("wacuum: \{genesisPath}: \{e}"); return 1; }
    Ok(b): {
      match (parse(b)) {
        Err(e): { sys.warn("wacuum: \{genesisPath} is not JSON"); return 1; }
        Ok(doc): {
          string[] why = [""];
          g = genesisFrom(doc, why);
          if (g is null) { sys.warn("wacuum: \{genesisPath}: \{why[0]}"); return 1; }
        }
      }
    }
  }
  Genesis gen = g!;
  gen.header.hash = U256.fromBytes(keccak256(encode(headerItem(gen.spec, gen.header))), 0, 32);
  Engine e = Engine.create(gen.config, gen.header, gen.world);
  sys.log("wacuum: \{gen.spec.name}, chain \{gen.config.chainId.toDecimal()}, genesis \{gen.header.hash.toHex()}");

  // The node's devp2p identity: kept in the data directory so it is the same node after a restart.
  u8[] nodeKey = (await sys.random().bytes(32)).ok()!;
  if (datadir != "") {
    string keyPath = datadir + "/nodekey";
    await sys.files().mkdir(datadir, true);
    match (await sys.readFile(keyPath)) {
      Ok(b): {
        u8[]? k = hexToBytes(string.fromBytes(b));
        if (k is not null && validKey(k!)) { nodeKey = k!; }
      }
      Err(err): {
        string hex = "";
        u8[] digits = "0123456789abcdef".toBytes();
        for (i32 i = 0; i < 32; i++) {
          hex += string.fromBytes([digits[(nodeKey[i] >> 4) as i32], digits[(nodeKey[i] & 15) as i32]]);
        }
        await sys.writeFile(keyPath, hex.toBytes());
      }
    }
  }

  Output? log = null;
  if (datadir != "") {
    string path = datadir + "/chain.log";
    await sys.files().mkdir(datadir, true);
    bool exists = false;
    match (await sys.files().stat(path)) {
      Ok(st): { exists = st.exists; }
      Err(e): {}
    }
    if (exists) {
      match (await sys.readFile(path)) {
        Err(e): { sys.warn("wacuum: \{path}: \{e}"); return 1; }
        Ok(bytes): {
          Replayed r = e.replay(bytes);
          if (r.error != "") {
            sys.warn("wacuum: \{path} does not replay on this genesis: \{r.error}");
            return 1;
          }
          if (r.good < bytes.len()) {
            // The last record was cut short when the process stopped; the log goes on from before it.
            u8[] keep = u8[].filled(r.good, 0);
            for (i32 i = 0; i < keep.len(); i++) { keep[i] = bytes[i]; }
            match (await sys.writeFile(path, keep)) {
              Err(err): { sys.warn("wacuum: \{path}: \{err}"); return 1; }
              Ok(_): {}
            }
            sys.warn("wacuum: dropped \{bytes.len() - r.good} bytes of a record cut short at the end of \{path}");
          }
          sys.log("wacuum: replayed \{r.blocks} blocks from \{path}; head \{e.head.toHex()}");
        }
      }
    }
    match (await sys.files().openAppend(path)) {
      Err(err): { sys.warn("wacuum: \{path}: \{err}"); return 1; }
      Ok(out): { log = out; }
    }
  }

  Network net = Network.create(e, nodeKey, gen.header.hash, gen.forkBlocks, gen.forkTimes);
  for (i32 i = 0; i < peers.len(); i++) { dial(sys, net, peers.get(i)); }
  if (p2pPort > 0) { listen(sys, net, "0.0.0.0", p2pPort); }
  tend(sys, net, () => flush(sys, e, log));
  serveEngine(sys, e, addr, port, secret, publicRpc, log);
  await sys.drain();
  return 0;
}

/** Append what the engine has recorded since last time to the chain log. */
async void flush(Sys sys, Engine e, Output? log) {
  if (log is not null) {
    for (i32 i = 0; i < e.records.len(); i++) {
      match (await log!.write(e.records.get(i))) {
        Err(err): { sys.warn("wacuum: the chain log cannot be written: \{err}"); }
        Ok(_): {}
      }
    }
  }
  e.records = Vec.create();
}

async void serveEngine(Sys sys, Engine e, string addr, i32 port, u8[] secret, bool publicRpc, Output? log) {
  match (await sys.net().listen(addr, port)) {
    Err(err): { sys.warn("wacuum: cannot listen on \{addr}:\{port}: \{err}"); }
    Ok(listener): {
      sys.log("wacuum: Engine API on \{listener.addr}");
      while (true) {
        match (await listener.accept()) {
          Err(err): { sys.warn("wacuum: accept: \{err}"); }
          Ok(sock): { answer(sys, e, sock, secret, publicRpc, log); }
        }
      }
    }
  }
}

/** One HTTP request on its own connection: read it whole, answer it, close. */
async void answer(Sys sys, Engine e, Socket sock, u8[] secret, bool publicRpc, Output? log) {
  // Read until the headers are complete, then until the body is.
  u8[] buf = u8[].filled(4096, 0);
  i32 len = 0;
  i32 end = -1;
  HttpRequest? req = null;
  bool done = false;
  while (!done) {
    match (await sock.recv()) {
      Err(err): { done = true; }
      Ok(r): {
        match (r) {
          End: { done = true; }
          Data(bytes): {
            if (len + bytes.len() > buf.len()) {
              i32 cap = buf.len() * 2;
              while (cap < len + bytes.len()) { cap = cap * 2; }
              u8[] grown = u8[].filled(cap, 0);
              for (i32 i = 0; i < len; i++) { grown[i] = buf[i]; }
              buf = grown;
            }
            for (i32 i = 0; i < bytes.len(); i++) { buf[len + i] = bytes[i]; }
            len += bytes.len();
            if (end < 0) {
              end = headersEnd(buf, len);
              if (end >= 0) {
                req = parseHead(buf, end);
                if (req is null) { done = true; }
              }
            }
            if (req is not null && len - end >= req!.contentLength) { done = true; }
          }
        }
      }
    }
  }
  if (req is not null && len - end >= req!.contentLength) {
    HttpRequest rq = req!;
    u8[] body = u8[].filled(rq.contentLength, 0);
    for (i32 i = 0; i < body.len(); i++) { body[i] = buf[end + i]; }
    rq.body = body;
    i64 now = (await sys.clock().nowMillis()).orElse(0 as i64) / 1000;
    u8[] answer = answerHttp(e, rq, secret, now, publicRpc);
    // What the answer reports goes to the log first.
    await flush(sys, e, log);
    await sock.send(answer);
  }
  sock.close();
}
