// A running Keccak-256: absorb in pieces and take the digest so far without ending the hash, which is what
// RLPx's frame MACs are. wac's crypto package has this shape for SHA3-256 (`Sha3_256`) but not for
// Ethereum's Keccak, whose padding differs; this is here until it does (docs/wac-asks.md).

static u64[] RC = [0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,
                   0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
                   0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,
                   0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,
                   0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,
                   0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008];
static i32[] ROT = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14];

u64 rotl(u64 x, i32 n) { return n == 0 ? x : (x << n) | (x >> (64 - n)); }

void keccakF(u64[] a) {
  u64[] c = u64[].filled(5, 0);
  u64[] b = u64[].filled(25, 0);
  for (i32 round = 0; round < 24; round++) {
    for (i32 x = 0; x < 5; x++) { c[x] = a[x] ^ a[x + 5] ^ a[x + 10] ^ a[x + 15] ^ a[x + 20]; }
    for (i32 x = 0; x < 5; x++) {
      u64 d = c[(x + 4) % 5] ^ rotl(c[(x + 1) % 5], 1);
      for (i32 y = 0; y < 25; y += 5) { a[y + x] = a[y + x] ^ d; }
    }
    // ρ and π: lane (x, y) rotates by its offset and moves to (y, 2x + 3y).
    for (i32 x = 0; x < 5; x++) {
      for (i32 y = 0; y < 5; y++) { b[y + 5 * ((2 * x + 3 * y) % 5)] = rotl(a[x + 5 * y], ROT[x + 5 * y]); }
    }
    for (i32 y = 0; y < 25; y += 5) {
      for (i32 x = 0; x < 5; x++) { a[y + x] = b[y + x] ^ ((~b[y + (x + 1) % 5]) & b[y + (x + 2) % 5]); }
    }
    a[0] = a[0] ^ RC[round];
  }
}

void absorbBlock(u64[] state, u8[] block) {
  for (i32 i = 0; i < 17; i++) {
    u64 w = 0;
    for (i32 k = 7; k >= 0; k--) { w = (w << 8) | (block[8 * i + k] as u64); }
    state[i] = state[i] ^ w;
  }
  keccakF(state);
}

export struct Keccak256 {
  u64[] state;
  u8[] pending;
  i32 pendingLen;

  Keccak256 create() { return Keccak256(u64[].filled(25, 0), u8[].filled(136, 0), 0); }

  void update(this, u8[] data) {
    for (i32 i = 0; i < data.len(); i++) {
      this.pending[this.pendingLen] = data[i];
      this.pendingLen++;
      if (this.pendingLen == 136) {
        absorbBlock(this.state, this.pending);
        this.pendingLen = 0;
      }
    }
  }

  /** The digest of everything so far; the hash goes on. */
  u8[] peek(this) {
    u64[] s = u64[].filled(25, 0);
    for (i32 i = 0; i < 25; i++) { s[i] = this.state[i]; }
    u8[] block = u8[].filled(136, 0);
    for (i32 i = 0; i < this.pendingLen; i++) { block[i] = this.pending[i]; }
    block[this.pendingLen] = block[this.pendingLen] | 0x01;
    block[135] = block[135] | 0x80;
    absorbBlock(s, block);
    u8[] out = u8[].filled(32, 0);
    for (i32 i = 0; i < 32; i++) { out[i] = ((s[i / 8] >> ((i % 8) * 8)) & 0xFF) as! u8; }
    return out;
  }
}
