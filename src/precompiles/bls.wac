  609, 608, 606, 604, 603, 601, 599, 598, 596, 595, 593, 592, 591, 589, 588, 586, 585, 584, 582, 581, 580, 579, 577,
  576, 575, 574, 573, 572, 570, 569, 568, 567, 566, 565, 564, 563, 562, 561, 560, 559, 558, 557, 556, 555, 554, 553,
  552, 551, 550, 549, 548, 547, 547, 546, 545, 544, 543, 542, 541, 540, 540, 539, 538, 537, 536, 536, 535, 534, 533,
  532, 532, 531, 530, 529, 528, 528, 527, 526, 525, 525, 524, 523, 522, 522, 521, 520, 520, 519];
static i64[] G2_DISCOUNT = [1000, 1000, 923, 884, 855, 832, 812, 796, 782, 770, 759, 749, 740, 732, 724, 717, 711,
  704, 699, 693, 688, 683, 679, 674, 670, 666, 663, 659, 655, 652, 649, 646, 643, 640, 637, 634, 632, 629, 627, 624,
  622, 620, 618, 615, 613, 611, 609, 607, 606, 604, 602, 600, 598, 597, 595, 593, 592, 590, 589, 587, 586, 584, 583,
  582, 580, 579, 578, 576, 575, 574, 573, 571, 570, 569, 568, 567, 566, 565, 563, 562, 561, 560, 559, 558, 557, 556,
  555, 554, 553, 552, 552, 551, 550, 549, 548, 547, 546, 545, 545, 544, 543, 542, 541, 541, 540, 539, 538, 537, 537,
  536, 535, 535, 534, 533, 532, 532, 531, 530, 530, 529, 528, 528, 527, 526, 526, 525, 524, 524];

/** An MSM's price: floor(len / per) pairs, each a multiplication at the discount for that many. */
export i64 msmGas(i32 len, bool g2) {
  i64 k = (len / (g2 ? 288 : 160)) as i64;
  if (k == 0) { return 0; }
  const i64[] table = g2 ? G2_DISCOUNT : G1_DISCOUNT;
  i64 discount = k > 128 ? table[127] : table[(k - 1) as! i32];
  return k * (g2 ? 22500 : 12000) * discount / 1000;
}

export i64 pairingGas(i32 len) { return 32600 * ((len / 384) as i64) + 37700; }

// ── Fp to G1: RFC 9380's simplified SWU onto an 11-isogenous curve, then the isogeny ─────────────
//
// The real curve has A = 0, which simplified SWU cannot use, so the map lands on E' (whose A' and B'
// are below) and an 11-isogeny carries the point to E. The constants are RFC 9380 §8.8.1 and appendix
// E.2, coefficients in ascending powers; @noble/curves has the same table.

u32[] fpHex(string h) {
  u8[] b = hexToBytes(h)!;
  u8[] v = u8[].filled(48, 0);
  for (i32 i = 0; i < b.len(); i++) { v[48 - b.len() + i] = b[i]; }
  return fpFromBytes(v)!;
}

u32[] fpSmall(i32 n) {
  u8[] v = u8[].filled(48, 0);
  v[47] = n as@ u8;
  return fpFromBytes(v)!;
}

u32[] inv0(u32[] a) { return fpInvert(a) ?? fpZero(); }

