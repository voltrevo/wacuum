// The BLS12-381 precompiles: EIP-2537's seven (0x0b to 0x11, from Prague) and EIP-4844's point
// evaluation (0x0a, from Cancun), all on wac's `bls` package.
//
// `bls` was written to verify consensus signatures, so it has the curves, the pairing and the G2
// hash-to-curve, and lacks two things the EVM asks for: EIP-2537's 64-byte uncompressed encoding,
// and the map from Fp to G1, whose SSWU and 11-isogeny are here. Each function returns null for an
// input the EIP calls an error, which the caller turns into a failure that consumes all the gas.

import { bls.G1, bls.G2, bls.Fp2, bls.Fp12, bls.Pair, bls.g1Infinity, bls.g1IsInfinity, bls.g1Generator, bls.g1Negate,
         bls.g1Add, bls.g1Mul, bls.g1IsOnCurve, bls.g1InSubgroup, bls.g1AffineX, bls.g1AffineY, bls.g1FromBytes,
         bls.g2Infinity, bls.g2IsInfinity, bls.g2Generator, bls.g2Negate, bls.g2Add, bls.g2Mul, bls.g2IsOnCurve,
         bls.g2InSubgroup, bls.g2AffineX, bls.g2AffineY, bls.g2FromBytes, bls.mapToCurveG2, bls.clearCofactorG2,
         bls.fpZero, bls.fpOne, bls.fpIsZero, bls.fpAdd, bls.fpMul, bls.fpSquare, bls.fpNeg, bls.fpInvert,
         bls.fpSqrt, bls.fpSgn0, bls.fpFromBytes, bls.fpToBytes, bls.millerLoopMulti, bls.finalExponentiate,
         bls.fp12IsOne } from "wac";
import { crypto.sha256 } from "wac";
import { hexToBytes } from "../hex.wac";

// ── EIP-2537's encodings ─────────────────────────────────────────────────────────────────────────
//
// A field element is 64 bytes, big-endian, whose top 16 must be zero and whose value must be below p;
// a point is x then y, and all zeros is infinity, since (0, 0) is on neither curve.

u32[]? fpAt(u8[] b, i32 at) {
  for (i32 i = 0; i < 16; i++) {
    if (b[at + i] != 0) { return null; }
  }
  u8[] v = u8[].filled(48, 0);
  for (i32 i = 0; i < 48; i++) { v[i] = b[at + 16 + i]; }
  return fpFromBytes(v);
}

/** Fp2 is c0 then c1. */
Fp2? fp2At(u8[] b, i32 at) {
  u32[]? c0 = fpAt(b, at);
  u32[]? c1 = fpAt(b, at + 64);
  if (c0 is null || c1 is null) { return null; }
  return Fp2(c0!, c1!);
}

bool zeros(u8[] b, i32 at, i32 n) {
  for (i32 i = 0; i < n; i++) {
    if (b[at + i] != 0) { return false; }
  }
  return true;
}

/** A G1 point on the curve, or null. The subgroup is the caller's to check, because G1ADD does not. */
G1? g1At(u8[] b, i32 at) {
  if (zeros(b, at, 128)) { return g1Infinity(); }
  u32[]? x = fpAt(b, at);
  u32[]? y = fpAt(b, at + 64);
  if (x is null || y is null) { return null; }
  G1 p = G1(x!, y!, fpOne());
  return g1IsOnCurve(p) ? p : null;
}

G2? g2At(u8[] b, i32 at) {
  if (zeros(b, at, 256)) { return g2Infinity(); }
  Fp2? x = fp2At(b, at);
  Fp2? y = fp2At(b, at + 128);
  if (x is null || y is null) { return null; }
  G2 p = G2(x!, y!, Fp2(fpOne(), fpZero()));
  return g2IsOnCurve(p) ? p : null;
}

void putFp(u8[] out, i32 at, u32[] v) {
  u8[] b = fpToBytes(v);
  for (i32 i = 0; i < 48; i++) { out[at + 16 + i] = b[i]; }
}

u8[] g1Bytes(G1 p) {
  u8[] out = u8[].filled(128, 0);
  if (g1IsInfinity(p)) { return out; }
  putFp(out, 0, g1AffineX(p)!);
  putFp(out, 64, g1AffineY(p)!);
  return out;
}

u8[] g2Bytes(G2 p) {
  u8[] out = u8[].filled(256, 0);
  if (g2IsInfinity(p)) { return out; }
  Fp2 x = g2AffineX(p)!;
  Fp2 y = g2AffineY(p)!;
  putFp(out, 0, x.c0);
  putFp(out, 64, x.c1);
  putFp(out, 128, y.c0);
  putFp(out, 192, y.c1);
  return out;
}

/** A 32-byte big-endian scalar as `bls` takes one: 32-bit limbs, least significant first. Not reduced. */
export u32[] scalarAt(u8[] b, i32 at) {
  u32[] k = u32[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) {
    i32 o = at + 28 - 4 * i;
    k[i] = ((b[o] as u32) << 24) | ((b[o + 1] as u32) << 16) | ((b[o + 2] as u32) << 8) | (b[o + 3] as u32);
  }
  return k;
}

bool scalarIsZero(u32[] k) {
  for (i32 i = 0; i < k.len(); i++) {
    if (k[i] != 0) { return false; }
  }
  return true;
}

// ── The seven operations ─────────────────────────────────────────────────────────────────────────

export u8[]? g1AddOp(u8[] input) {
  if (input.len() != 256) { return null; }
  G1? a = g1At(input, 0);
  G1? b = g1At(input, 128);
  if (a is null || b is null) { return null; }
  return g1Bytes(g1Add(a!, b!));
}

export u8[]? g2AddOp(u8[] input) {
  if (input.len() != 512) { return null; }
  G2? a = g2At(input, 0);
  G2? b = g2At(input, 256);
  if (a is null || b is null) { return null; }
  return g2Bytes(g2Add(a!, b!));
}

// The MSMs are a sum of single multiplications. The gas schedule prices them as if Pippenger's
// algorithm ran, which is cheaper per point at large k, so this is slower than the price assumes;
// it is correct, and Pippenger is a speed-up for later.

export u8[]? g1MsmOp(u8[] input) {
  if (input.len() == 0 || input.len() % 160 != 0) { return null; }
  G1 acc = g1Infinity();
  for (i32 at = 0; at < input.len(); at += 160) {
    G1? p = g1At(input, at);
    if (p is null || !g1InSubgroup(p!)) { return null; }
    u32[] k = scalarAt(input, at + 128);
    if (g1IsInfinity(p!) || scalarIsZero(k)) { continue; }
    acc = g1Add(acc, g1Mul(p!, k));
  }
  return g1Bytes(acc);
}

export u8[]? g2MsmOp(u8[] input) {
  if (input.len() == 0 || input.len() % 288 != 0) { return null; }
  G2 acc = g2Infinity();
  for (i32 at = 0; at < input.len(); at += 288) {
    G2? p = g2At(input, at);
    if (p is null || !g2InSubgroup(p!)) { return null; }
    u32[] k = scalarAt(input, at + 256);
    if (g2IsInfinity(p!) || scalarIsZero(k)) { continue; }
    acc = g2Add(acc, g2Mul(p!, k));
  }
  return g2Bytes(acc);
}

/** Whether the product of the pairings of `g1s[i]` with `g2s[i]` is one; a pair with infinity in it is one. */
bool pairingIsOne(G1[] g1s, G2[] g2s) {
  i32 n = 0;
  for (i32 i = 0; i < g1s.len(); i++) {
    if (!g1IsInfinity(g1s[i]) && !g2IsInfinity(g2s[i])) { n++; }
  }
  if (n == 0) { return true; }
  Pair[] pairs = Pair[].defaulted(n);
  i32 j = 0;
  for (i32 i = 0; i < g1s.len(); i++) {
    if (g1IsInfinity(g1s[i]) || g2IsInfinity(g2s[i])) { continue; }
    pairs[j] = Pair(g1AffineX(g1s[i])!, g1AffineY(g1s[i])!, g2AffineX(g2s[i])!, g2AffineY(g2s[i])!);
    j++;
  }
  Fp12? f = finalExponentiate(millerLoopMulti(pairs));
  return f is not null && fp12IsOne(f!);
}

export u8[]? pairingOp(u8[] input) {
  if (input.len() == 0 || input.len() % 384 != 0) { return null; }
  i32 n = input.len() / 384;
  G1[] g1s = G1[].defaulted(n);
  G2[] g2s = G2[].defaulted(n);
  for (i32 i = 0; i < n; i++) {
    G1? p = g1At(input, 384 * i);
    G2? q = g2At(input, 384 * i + 128);
    if (p is null || q is null || !g1InSubgroup(p!) || !g2InSubgroup(q!)) { return null; }
    g1s[i] = p!;
    g2s[i] = q!;
  }
  u8[] out = u8[].filled(32, 0);
  if (pairingIsOne(g1s, g2s)) { out[31] = 1; }
  return out;
}

export u8[]? mapFpToG1Op(u8[] input) {
  if (input.len() != 64) { return null; }
  u32[]? u = fpAt(input, 0);
  if (u is null) { return null; }
  return g1Bytes(clearCofactorG1(mapToCurveG1(u!)));
}

export u8[]? mapFp2ToG2Op(u8[] input) {
  if (input.len() != 128) { return null; }
  Fp2? u = fp2At(input, 0);
  if (u is null) { return null; }
  return g2Bytes(clearCofactorG2(mapToCurveG2(u!)));
}

// ── Gas ──────────────────────────────────────────────────────────────────────────────────────────

/** EIP-2537's MSM discounts, per mille, for k = 1 to 128; beyond that the last one holds. */
static i64[] G1_DISCOUNT = [1000, 949, 848, 797, 764, 750, 738, 728, 719, 712, 705, 698, 692, 687, 682, 677, 673,
