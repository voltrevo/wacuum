/** The polynomial with coefficients `k` (ascending) at `x`, by Horner. */
u32[] poly(const string[] k, u32[] x) {
  u32[] acc = fpHex(k[k.len() - 1]);
  for (i32 i = k.len() - 2; i >= 0; i--) { acc = fpAdd(fpMul(acc, x), fpHex(k[i])); }
  return acc;
}

/** RFC 9380 §6.6.2, step for step: the same shape as `bls`'s G2 map, in Fp. */
G1 mapToCurveG1(u32[] u) {
  u32[] a = fpHex(SWU_A);
  u32[] b = fpHex(SWU_B);
  u32[] z = fpSmall(11);
  u32[] tv1 = fpMul(z, fpSquare(u));                   // Z·u²
  u32[] tv2 = fpSquare(tv1);                           // Z²·u⁴
  u32[] x1 = inv0(fpAdd(tv1, tv2));
  // When Z²u⁴ + Zu² is zero, x1 = B/(Z·A), which is (−1/Z)·(−B/A).
  x1 = fpIsZero(x1) ? fpNeg(inv0(z)) : fpAdd(x1, fpOne());
  x1 = fpMul(x1, fpNeg(fpMul(b, inv0(a))));
  u32[] gx1 = fpAdd(fpMul(fpAdd(fpSquare(x1), a), x1), b);
  u32[] x2 = fpMul(tv1, x1);
  u32[] gx2 = fpMul(gx1, fpMul(tv1, tv2));
  u32[] x = x1;
  u32[]? y = fpSqrt(gx1);
  if (y is null) {
    x = x2;
    y = fpSqrt(gx2);
  }
  u32[] yy = y!;
  if (fpSgn0(yy) != fpSgn0(u)) { yy = fpNeg(yy); }

  // The 11-isogeny back to E. A vanishing denominator is RFC 9380's exceptional case, the identity.
  u32[]? xd = fpInvert(poly(X_DEN, x));
  u32[]? yd = fpInvert(poly(Y_DEN, x));
  if (xd is null || yd is null) { return g1Infinity(); }
  return G1(fpMul(poly(X_NUM, x), xd!), fpMul(fpMul(yy, poly(Y_NUM, x)), yd!), fpOne());
}

/** h_eff = 1 − x = 0xd201000000010001, as RFC 9380 §8.8.1 clears G1's cofactor. */
G1 clearCofactorG1(G1 p) {
  u32[] h = u32[].filled(2, 0);
  h[0] = 0x00010001;
  h[1] = 0xd2010000;
  return g1Mul(p, h);
}

// ── Point evaluation (EIP-4844) ──────────────────────────────────────────────────────────────────

/** BLS_MODULUS, r, big-endian: z and y must be below it, and the precompile returns it. */
static string BLS_MODULUS = "73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001";

/** [τ]G2 from the KZG ceremony's setup: the one G2 point beyond the generator that verification needs. */
static string TAU_G2 = "b5bfd7dd8cdeb128843bc287230af38926187075cbfbefa81009a2ce615ac53d2914e5870cb452d2afaaab24f3499f72185cbfee53492714734429b7b38608e23926c911cceceac9a36851477ba4c60b087041de621000edc98edada20c1def2";

bool belowModulus(u8[] b, i32 at) {
  u8[] r = hexToBytes(BLS_MODULUS)!;
  for (i32 i = 0; i < 32; i++) {
    if (b[at + i] != r[i]) { return b[at + i] < r[i]; }
  }
  return false;
}

/**
 * Whether `proof` shows that the polynomial `commitment` commits to is `y` at `z` (both below r, as `bls`
 * scalars): e(C − [y]G1, −G2) · e(π, [τ]G2 − [z]G2) = 1. False too for a commitment or proof that is not
 * the compressed encoding of a point in G1.
 */
export bool kzgProofHolds(u8[] commitment, u32[] z, u32[] y, u8[] proof) {
  G1? c = g1FromBytes(commitment);
  G1? pi = g1FromBytes(proof);
  if (c is null || pi is null) { return false; }
  G2 tau = g2FromBytes(hexToBytes(TAU_G2)!)!;
  G1[] g1s = [g1Add(c!, g1Negate(g1Mul(g1Generator(), y))), pi!];
  G2[] g2s = [g2Negate(g2Generator()), g2Add(tau, g2Negate(g2Mul(g2Generator(), z)))];
  return pairingIsOne(g1s, g2s);
}

/**
 * 192 bytes: a versioned hash, z, y, a commitment and a proof. The output is FIELD_ELEMENTS_PER_BLOB and
 * BLS_MODULUS as two 32-byte words, when the proof shows the committed polynomial is y at z.
 */
export u8[]? pointEvaluation(u8[] input) {
  if (input.len() != 192) { return null; }
  u8[] commitment = u8[].filled(48, 0);
  u8[] proof = u8[].filled(48, 0);
  for (i32 i = 0; i < 48; i++) {
    commitment[i] = input[96 + i];
    proof[i] = input[144 + i];
  }
  // The versioned hash is 0x01 then the commitment's sha256 after its first byte.
  u8[] h = sha256(commitment);
  if (input[0] != 0x01) { return null; }
  for (i32 i = 1; i < 32; i++) {
    if (input[i] != h[i]) { return null; }
  }
  if (!belowModulus(input, 32) || !belowModulus(input, 64)) { return null; }
  if (!kzgProofHolds(commitment, scalarAt(input, 32), scalarAt(input, 64), proof)) { return null; }

  u8[] out = u8[].filled(64, 0);
  out[30] = 0x10;                                       // 4096
  u8[] r = hexToBytes(BLS_MODULUS)!;
  for (i32 i = 0; i < 32; i++) { out[32 + i] = r[i]; }
  return out;
}
