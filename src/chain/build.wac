// Building a block: what a consensus client asks for when its validator is due to propose. It names the
// parent, the timestamp, the randomness, who gets the fees, the withdrawals and the beacon root; this fills
// in everything else by running the candidates on the parent's state and keeping those that fit.
//
// A built block goes through exactly the code an imported one does — `executeBody` — so the header it gets
// is the header import would demand. The consensus client sends it back through `engine_newPayload`, which
// checks that from scratch.

import { Map } from "core";
import { crypto.keccak256 } from "wac";
import { rlp.Item, rlp.encode } from "wac";
import { U256 } from "../u256.wac";
import { World } from "../state/world.wac";
import { BlockEnv } from "../evm/evm.wac";
import { Spec } from "../evm/spec.wac";
import { blobGasPrice } from "../tx/process.wac";
import { Header, Block, Withdrawal, Body, executeBody, headerItem, nextBaseFee, nextExcessBlobGas, EMPTY_OMMERS } from "./block.wac";

export struct Attributes {
  U256 timestamp;
  U256 prevRandao;
  U256 feeRecipient;
  Withdrawal[] withdrawals;
  U256 parentBeaconBlockRoot;
}

export struct Built {
  Block block;
  Body body;
}

/**
 * A block on `parent` from `candidates`, run on `w` — the parent's state, which this changes. The gas
 * limit stays the parent's. A candidate that does not fit, or is not valid on this state, is left out;
 * the candidates are tried until a pass includes nothing new, so a transaction that arrived before the
 * one whose nonce it follows still gets in.
 */
export Built buildBlock(Spec spec, World w, Header parent, Attributes a, Item[] candidates, U256 chainId, Map<U256, U256> hashes) {
  Header h = Header(parent.hash, U256.fromHex(EMPTY_OMMERS)!, a.feeRecipient, U256.zero(), U256.zero(), U256.zero(),
                    u8[].filled(256, 0), U256.zero(), parent.number.add(U256.one()), parent.gasLimit, U256.zero(),
                    a.timestamp, "wacuum".toBytes(), a.prevRandao, u8[].filled(8, 0), nextBaseFee(parent), U256.zero(),
                    U256.zero(), nextExcessBlobGas(spec, parent), a.parentBeaconBlockRoot, U256.zero(), U256.zero());
  BlockEnv env = BlockEnv(h.coinbase, h.number, h.timestamp, h.gasLimit, h.prevRandao, h.baseFee,
                          blobGasPrice(spec, h.excessBlobGas), chainId, hashes);
  // Order the candidates by repeated passes on a scratch copy, then run the chosen order for real: the
  // scratch runs would otherwise leave their system calls and transactions applied twice.
  Item[] order = orderCandidates(spec, w, env, h, candidates, a.withdrawals);
  Body body = executeBody(spec, w, env, h, order, a.withdrawals, true);
  h.gasUsed = U256.ofU64(body.gasUsed as! u64);
  h.blobGasUsed = U256.ofU64(body.blobGasUsed as! u64);
  h.bloom = body.bloom;
  h.txRoot = body.txRoot;
  h.receiptsRoot = body.receiptsRoot;
  h.withdrawalsRoot = body.withdrawalsRoot;
  h.stateRoot = body.stateRoot;
  h.requestsHash = body.requestsHash;
  h.hash = U256.fromBytes(keccak256(encode(headerItem(spec, h))), 0, 32);
  return Built(Block(h, body.included, false, a.withdrawals), body);
}

/** The candidates in an order that includes as many as will go: whatever each pass took, then the rest again. */
Item[] orderCandidates(Spec spec, World w, BlockEnv env, Header h, Item[] candidates, Withdrawal[] withdrawals) {
  Item[] chosen = Item[].filled(0, Item.Bytes(u8[].filled(0, 0)));
  Item[] left = candidates;
  while (left.len() > 0) {
    Item[] attempt = concat(chosen, left);
    Body b = executeBody(spec, w.clone(), env, h, attempt, withdrawals, true);
    if (b.included.len() == chosen.len()) { break; }
    chosen = b.included;
    // What did not get in this time may now follow something that did.
    Item[] rest = Item[].filled(0, Item.Bytes(u8[].filled(0, 0)));
    for (i32 i = 0; i < left.len(); i++) {
      if (!contains(chosen, left[i])) { rest = concat(rest, [left[i]]); }
    }
    if (rest.len() == left.len()) { break; }
    left = rest;
  }
  return chosen;
}

Item[] concat(Item[] a, Item[] b) {
  Item[] out = Item[].filled(a.len() + b.len(), Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}

bool contains(Item[] xs, Item x) {
  for (i32 i = 0; i < xs.len(); i++) {
    if (xs[i] is x) { return true; }
  }
  return false;
}
