// A block: its header checked against its parent's, its body executed, and every commitment the header
// makes about the result checked against what execution produced.
//
// This follows execution-specs' `validate_header` and `apply_body` for Cancun and Prague, in their order:
// the system calls that begin a block (EIP-4788's beacon root, and from Prague EIP-2935's parent hash),
// the transactions, the withdrawals, and from Prague the requests of EIP-7685. Anything wrong anywhere
// makes the whole block invalid, and the caller runs it on a copy of the world so that an invalid block
// leaves no trace.

import { Map, Vec } from "core";
import { crypto.keccak256, crypto.sha256 } from "wac";
import { rlp.Item, rlp.encode, rlp.decode, rlp.Decoded, rlp.bytesOf, rlp.itemsOf, rlp.isList } from "wac";
import { U256 } from "../u256.wac";
import { World, Log, hashU256, eqU256 } from "../state/world.wac";
import { stateRoot, u256Bytes } from "../state/root.wac";
import { trieRoot } from "../trie/trie.wac";
import { BlockEnv, TxEnv, Evm, Message, processMessage, addressBytes } from "../evm/evm.wac";
import { Outcome } from "../evm/interp.wac";
import { OpTable } from "../evm/table.wac";
import { Spec } from "../evm/spec.wac";
import { precompileAddresses } from "../evm/precompiles.wac";
import { Transaction, Processed, processTransaction, blobGasPrice, GAS_PER_BLOB } from "../tx/process.wac";
import { DecodedTx, decodeTransaction } from "../tx/decode.wac";

export struct Header {
  U256 parentHash;
  U256 ommersHash;
  U256 coinbase;
  U256 stateRoot;
  U256 txRoot;
  U256 receiptsRoot;
  u8[] bloom;
  U256 difficulty;
  U256 number;
  U256 gasLimit;
  U256 gasUsed;
  U256 timestamp;
  u8[] extraData;
  U256 prevRandao;
  u8[] nonce;
  U256 baseFee;
  U256 withdrawalsRoot;
  U256 blobGasUsed;
  U256 excessBlobGas;
  U256 parentBeaconBlockRoot;
  /** Prague's EIP-7685 commitment; zero before it. */
  U256 requestsHash;
  /** keccak256 of the header's RLP. */
  U256 hash;
}

export struct Withdrawal {
  U256 index;
  U256 validator;
  U256 address;
  /** In gwei. */
  U256 amount;
}

export struct Block {
  Header header;
  Item[] txs;
  bool hasOmmers;
  Withdrawal[] withdrawals;
}

/** What decoding produced: a block, or why there is none. */
export struct BlockDecode {
  Block? block;
  string error;
}

Header emptyHeader() {
  return Header(U256.zero(), U256.zero(), U256.zero(), U256.zero(), U256.zero(), U256.zero(), u8[].filled(0, 0),
                U256.zero(), U256.zero(), U256.zero(), U256.zero(), U256.zero(), u8[].filled(0, 0), U256.zero(),
                u8[].filled(0, 0), U256.zero(), U256.zero(), U256.zero(), U256.zero(), U256.zero(), U256.zero(), U256.zero());
}

/** Reads header fields in order, keeping the first problem. */
struct Reader {
  Item[] items;
  i32 at;
  string error;

  u8[] bytes(this) {
    if (this.at >= this.items.len()) {
      if (this.error == "") { this.error = "too few header fields"; }
      return u8[].filled(0, 0);
    }
    Item it = this.items[this.at];
    this.at++;
    if (isList(it)) {
      if (this.error == "") { this.error = "a list in a header field"; }
      return u8[].filled(0, 0);
    }
    return bytesOf(it);
  }
  U256 int(this) {
    u8[] b = this.bytes();
    if (b.len() > 32 || (b.len() > 0 && b[0] == 0)) {
      if (this.error == "") { this.error = "a header integer that is not canonical"; }
      return U256.zero();
    }
    return U256.fromBytes(b, 0, b.len());
  }
  U256 fixed(this, i32 n) {
    u8[] b = this.bytes();
    if (b.len() != n && this.error == "") { this.error = "a header field of the wrong length"; }
    return U256.fromBytes(b, 0, n);
  }
}

/** A header from its RLP item: twenty fields for Cancun, twenty-one with Prague's requests hash. */
export Header? headerOf(Spec spec, Item it, string[] why) {
  if (!isList(it)) {
    why[0] = "the header is not a list";
    return null;
  }
  Item[] f = itemsOf(it);
  i32 want = spec.isPrague ? 21 : 20;
  if (f.len() != want) {
    why[0] = "a header with \{f.len()} fields, want \{want}";
    return null;
  }
  Reader r = Reader(f, 0, "");
  Header h = emptyHeader();
  h.parentHash = r.fixed(32);
  h.ommersHash = r.fixed(32);
  h.coinbase = r.fixed(20);
  h.stateRoot = r.fixed(32);
  h.txRoot = r.fixed(32);
  h.receiptsRoot = r.fixed(32);
  h.bloom = r.bytes();
  h.difficulty = r.int();
  h.number = r.int();
  h.gasLimit = r.int();
  h.gasUsed = r.int();
  h.timestamp = r.int();
  h.extraData = r.bytes();
  h.prevRandao = r.fixed(32);
  h.nonce = r.bytes();
  h.baseFee = r.int();
  h.withdrawalsRoot = r.fixed(32);
  h.blobGasUsed = r.int();
  h.excessBlobGas = r.int();
  h.parentBeaconBlockRoot = r.fixed(32);
  if (spec.isPrague) { h.requestsHash = r.fixed(32); }
  if (h.bloom.len() != 256 && r.error == "") { r.error = "a bloom that is not 256 bytes"; }
  if (h.nonce.len() != 8 && r.error == "") { r.error = "a nonce that is not 8 bytes"; }
  if (r.error != "") {
    why[0] = r.error;
    return null;
  }
  h.hash = U256.fromBytes(keccak256(encode(it)), 0, 32);
  return h;
}

/** A block from its RLP: header, transactions, ommers and withdrawals. */
export BlockDecode decodeBlock(Spec spec, u8[] rlpBytes) {
  Decoded d = decode(rlpBytes);
  if (!d.ok) { return BlockDecode(null, "block RLP: " + d.error); }
  if (!isList(d.item)) { return BlockDecode(null, "a block that is not a list"); }
  Item[] parts = itemsOf(d.item);
  if (parts.len() != 4) { return BlockDecode(null, "a block with \{parts.len()} parts, want 4"); }
  string[] why = [""];
  Header? h = headerOf(spec, parts[0], why);
  if (h is null) { return BlockDecode(null, why[0]); }
  if (!isList(parts[1]) || !isList(parts[2]) || !isList(parts[3])) { return BlockDecode(null, "a block body part that is not a list"); }
  Item[] ws = itemsOf(parts[3]);
  Withdrawal[] withdrawals = Withdrawal[].filled(ws.len(), Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero()));
  for (i32 i = 0; i < ws.len(); i++) {
    if (!isList(ws[i]) || itemsOf(ws[i]).len() != 4) { return BlockDecode(null, "a malformed withdrawal"); }
    Reader r = Reader(itemsOf(ws[i]), 0, "");
    withdrawals[i] = Withdrawal(r.int(), r.int(), r.fixed(20), r.int());
    if (r.error != "") { return BlockDecode(null, "withdrawal: " + r.error); }
  }
  return BlockDecode(Block(h!, itemsOf(parts[1]), itemsOf(parts[2]).len() > 0, withdrawals), "");
}

// ── Header rules ────────────────────────────────────────────────────────────────

static string EMPTY_OMMERS = "0x1dcc4de8dec75d7aab85b567b6ccd41ad312451b948a7413f0a142fd40d49347";

/** EIP-1559's base fee for a child of `parent`, which moves by at most an eighth toward the gas target. */
export U256 nextBaseFee(Header parent) {
  U256 target = parent.gasLimit.div(U256.ofU64(2));
  U256 used = parent.gasUsed;
  U256 base = parent.baseFee;
  U256 eight = U256.ofU64(8);
  if (target.isZero() || used.eq(target)) { return base; }
  if (used.gt(target)) {
    U256 delta = base.mul(used.sub(target)).div(target).div(eight);
    if (delta.isZero()) { delta = U256.one(); }
    return base.add(delta);
  }
  return base.sub(base.mul(target.sub(used)).div(target).div(eight));
}

/** EIP-4844's excess blob gas for a child of `parent`. */
export U256 nextExcessBlobGas(Spec spec, Header parent) {
  U256 total = parent.excessBlobGas.add(parent.blobGasUsed);
  U256 target = U256.ofU64(spec.targetBlobGasPerBlock as! u64);
  return total.lt(target) ? U256.zero() : total.sub(target);
}

/** The header's own rules and its relation to its parent's. "" when it may follow it. */
export string checkHeader(Spec spec, Header h, Header parent) {
  if (!h.parentHash.eq(parent.hash)) { return "parent hash does not match"; }
  if (!h.number.eq(parent.number.add(U256.one()))) { return "number is not the parent's plus one"; }
  if (!h.timestamp.gt(parent.timestamp)) { return "timestamp does not advance"; }
  if (h.gasUsed.gt(h.gasLimit)) { return "gas used exceeds the gas limit"; }
  // The gas limit moves by less than 1/1024 of the parent's, and never below 5000.
  U256 delta = parent.gasLimit.div(U256.ofU64(1024));
  if (h.gasLimit.ge(parent.gasLimit.add(delta))) { return "gas limit rises too far"; }
  if (h.gasLimit.add(delta).le(parent.gasLimit)) { return "gas limit falls too far"; }
  if (h.gasLimit.lt(U256.ofU64(5000))) { return "gas limit below 5000"; }
  if (!h.baseFee.eq(nextBaseFee(parent))) { return "base fee \{h.baseFee.toDecimal()}, want \{nextBaseFee(parent).toDecimal()}"; }
  if (!h.excessBlobGas.eq(nextExcessBlobGas(spec, parent))) { return "excess blob gas is wrong"; }
  if (h.extraData.len() > 32) { return "extra data over 32 bytes"; }
  if (!h.difficulty.isZero()) { return "nonzero difficulty after the merge"; }
  for (i32 i = 0; i < 8; i++) {
    if (h.nonce[i] != 0) { return "nonzero nonce after the merge"; }
  }
  if (!h.ommersHash.eq(U256.fromHex(EMPTY_OMMERS)!)) { return "ommers hash is not the empty list's"; }
  return "";
}

// ── Execution ───────────────────────────────────────────────────────────────────

export static string SYSTEM_ADDRESS = "0xfffffffffffffffffffffffffffffffffffffffe";
export static string BEACON_ROOTS = "0x000f3df6d732807ef1319fb7b8bb8522d0beac02";
export static string HISTORY_STORAGE = "0x0000f90827f1c53a10cb7a02335b175320002935";
export static string WITHDRAWAL_REQUESTS = "0x00000961ef480eb55e80d19ad83579a64c007002";
export static string CONSOLIDATION_REQUESTS = "0x0000bbddc7ce488642fb579f8b00f3a590007251";
export static string DEPOSIT_CONTRACT = "0x00000000219ab540356cbb839cbe05303d7705fa";
export static string DEPOSIT_EVENT = "0x649bbc62d0e31342afea4e5cd82d4049e7e1ee912fc0889aa790803be39038c5";

/**
 * A system call: a message from the system address with 30 million gas that no one pays for and that does
 * not count toward the block's gas. Its logs are discarded; its state changes are kept.
 */
Outcome systemCall(Spec spec, World w, BlockEnv env, U256 target, u8[] data) {
  U256 sys = U256.fromHex(SYSTEM_ADDRESS)!;
  Evm evm = Evm(w, env, TxEnv(sys, U256.zero(), U256[].filled(0, U256.zero())), OpTable.cancun(), spec, null);
  w.warmAddress(sys);
  w.warmAddress(target);
  U256[] pre = precompileAddresses(spec);
  for (i32 i = 0; i < pre.len(); i++) { w.warmAddress(pre[i]); }
  Outcome o = processMessage(evm, Message(sys, target, target, U256.zero(), data, 30000000, false, 0, true, false));
  w.logs.clear();
  w.endTransaction();
  return o;
}

/** A Prague request contract's call: it must have code and must succeed, or the block is invalid. */
u8[]? requestCall(Spec spec, World w, BlockEnv env, string address) {
  U256 target = U256.fromHex(address)!;
  if (w.code(target).len() == 0) { return null; }
  Outcome o = systemCall(spec, w, env, target, u8[].filled(0, 0));
  if (!o.succeeded()) { return null; }
  return o.output();
}

/** The trie of a list keyed by each entry's index, RLP-encoded: transactions, receipts, withdrawals. */
u8[] indexedRoot(u8[][] values) {
  u8[][] keys = u8[][].defaulted(values.len());
  for (i32 i = 0; i < values.len(); i++) { keys[i] = encode(Item.Bytes(u256Bytes(U256.ofI32(i)))); }
  return trieRoot(keys, values);
}

/** Set the three bloom bits for `data`: pairs of the first six bytes of its hash, each picking one of 2048. */
void bloomAdd(u8[] bloom, u8[] data) {
  u8[] h = keccak256(data);
  for (i32 i = 0; i < 6; i += 2) {
    i32 bit = (((h[i] as i32) << 8) | (h[i + 1] as i32)) & 2047;
    bloom[255 - bit / 8] = bloom[255 - bit / 8] | ((1 << (bit % 8)) as@ u8);
  }
}

/** A receipt's encoding: rlp([status, cumulative gas, bloom, logs]), after its type byte for a typed one. */
u8[] receiptOf(i32 txType, bool ok, i64 cumulative, u8[] bloom, Log[] logs) {
  Item[] ls = Item[].filled(logs.len(), Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < logs.len(); i++) {
    Item[] topics = Item[].filled(logs[i].topics.len(), Item.Bytes(u8[].filled(0, 0)));
    for (i32 t = 0; t < topics.len(); t++) { topics[t] = Item.Bytes(logs[i].topics[t].toBytes()); }
    Item[] fields = [Item.Bytes(addressBytes(logs[i].address)), Item.List(topics), Item.Bytes(logs[i].data)];
    ls[i] = Item.List(fields);
  }
  Item[] fields = [Item.Bytes(ok ? u8[].filled(1, 1) : u8[].filled(0, 0)), Item.Bytes(u256Bytes(U256.ofU64(cumulative as! u64))),
                   Item.Bytes(bloom), Item.List(ls)];
  u8[] body = encode(Item.List(fields));
  if (txType == 0) { return body; }
  u8[] out = u8[].filled(body.len() + 1, 0);
  out[0] = txType as! u8;
  for (i32 i = 0; i < body.len(); i++) { out[i + 1] = body[i]; }
  return out;
}

/**
 * EIP-6110: a deposit's 192 bytes from a DepositEvent's ABI encoding, whose layout is fixed — five offsets,
 * then five length-prefixed fields. Anything else is refused, and the block with it.
 */
u8[]? depositOf(u8[] data) {
  if (data.len() != 576) { return null; }
  i32[] offsets = [160, 256, 320, 384, 512];
  i32[] sizes = [48, 32, 8, 96, 8];
  u8[] out = u8[].filled(192, 0);
  i32 at = 0;
  for (i32 f = 0; f < 5; f++) {
    if (!U256.fromBytes(data, f * 32, 32).eq(U256.ofI32(offsets[f]))) { return null; }
    if (!U256.fromBytes(data, offsets[f], 32).eq(U256.ofI32(sizes[f]))) { return null; }
    for (i32 i = 0; i < sizes[f]; i++) { out[at + i] = data[offsets[f] + 32 + i]; }
    at += sizes[f];
  }
  return out;
}

/**
 * Execute `b` on `w` as the child of `parent`. "" when the block is valid; otherwise why not, and `w` is
 * in no state anyone should keep — run this on a clone.
 */
export string applyBlock(Spec spec, World w, Block b, Header parent, U256 chainId, Map<U256, U256> hashes) {
  Header h = b.header;
  string bad = checkHeader(spec, h, parent);
  if (bad != "") { return bad; }
  if (b.hasOmmers) { return "a block with ommers after the merge"; }

  BlockEnv env = BlockEnv(h.coinbase, h.number, h.timestamp, h.gasLimit, h.prevRandao, h.baseFee,
                          blobGasPrice(spec, h.excessBlobGas), chainId, hashes);
  systemCall(spec, w, env, U256.fromHex(BEACON_ROOTS)!, h.parentBeaconBlockRoot.toBytes());
  if (spec.isPrague) { systemCall(spec, w, env, U256.fromHex(HISTORY_STORAGE)!, h.parentHash.toBytes()); }

  i64 gasLimit = h.gasLimit.low() as@ i64;
  i64 used = 0;
  i64 blobUsed = 0;
  u8[][] txRaw = u8[][].defaulted(b.txs.len());
  u8[][] receipts = u8[][].defaulted(b.txs.len());
  u8[] blockBloom = u8[].filled(256, 0);
  Vec<u8[]> deposits = Vec.create();
  for (i32 i = 0; i < b.txs.len(); i++) {
    DecodedTx d = decodeTransaction(b.txs[i], chainId);
    if (d.error != "") { return "transaction \{i}: \{d.error}"; }
    Transaction tx = d.tx;
    Processed p = processTransaction(spec, w, env, tx, gasLimit - used, spec.maxBlobGasPerBlock - blobUsed, null);
    if (p.invalid != "") { return "transaction \{i}: \{p.invalid}"; }
    used += p.gasUsed;
    blobUsed += GAS_PER_BLOB * (tx.blobHashes.len() as i64);
    u8[] bloom = u8[].filled(256, 0);
    for (i32 l = 0; l < p.logs.len(); l++) {
      Log log = p.logs[l];
      bloomAdd(bloom, addressBytes(log.address));
      for (i32 t = 0; t < log.topics.len(); t++) { bloomAdd(bloom, log.topics[t].toBytes()); }
      if (spec.isPrague && log.address.eq(U256.fromHex(DEPOSIT_CONTRACT)!) && log.topics.len() > 0 &&
          log.topics[0].eq(U256.fromHex(DEPOSIT_EVENT)!)) {
        u8[]? dep = depositOf(log.data);
        if (dep is null) { return "transaction \{i}: a malformed deposit event"; }
        deposits.push(dep!);
      }
    }
    for (i32 k = 0; k < 256; k++) { blockBloom[k] = blockBloom[k] | bloom[k]; }
    txRaw[i] = d.raw;
    receipts[i] = receiptOf(tx.txType, p.success, used, bloom, p.logs);
  }

  // Withdrawals credit gwei, and an account a zero withdrawal created is removed again.
  u8[][] wsRaw = u8[][].defaulted(b.withdrawals.len());
  U256 gwei = U256.ofU64(1000000000);
  for (i32 i = 0; i < b.withdrawals.len(); i++) {
    Withdrawal wd = b.withdrawals[i];
    w.addBalance(wd.address, wd.amount.mul(gwei));
    Item[] fields = [Item.Bytes(u256Bytes(wd.index)), Item.Bytes(u256Bytes(wd.validator)), Item.Bytes(addressBytes(wd.address)),
                     Item.Bytes(u256Bytes(wd.amount))];
    wsRaw[i] = encode(Item.List(fields));
  }
  w.endTransaction();

  if (spec.isPrague) {
    u8[]? withdrawalRequests = requestCall(spec, w, env, WITHDRAWAL_REQUESTS);
    if (withdrawalRequests is null) { return "the withdrawal request contract failed"; }
    u8[]? consolidations = requestCall(spec, w, env, CONSOLIDATION_REQUESTS);
    if (consolidations is null) { return "the consolidation request contract failed"; }
    u8[][] depositList = deposits.toArray();
    i32 n = 0;
    for (i32 i = 0; i < depositList.len(); i++) { n += depositList[i].len(); }
    u8[] depositBytes = u8[].filled(n, 0);
    i32 at = 0;
    for (i32 i = 0; i < depositList.len(); i++) {
      for (i32 k = 0; k < depositList[i].len(); k++) { depositBytes[at + k] = depositList[i][k]; }
      at += depositList[i].len();
    }
    U256 requestsHash = requestsHashOf([depositBytes, withdrawalRequests!, consolidations!]);
    if (!requestsHash.eq(h.requestsHash)) { return "requests hash does not match"; }
  }

  if (!U256.ofU64(used as! u64).eq(h.gasUsed)) { return "gas used \{used}, header says \{h.gasUsed.toDecimal()}"; }
  if (!U256.ofU64(blobUsed as! u64).eq(h.blobGasUsed)) { return "blob gas used does not match"; }
  if (!U256.fromBytes(indexedRoot(txRaw), 0, 32).eq(h.txRoot)) { return "transactions root does not match"; }
  if (!U256.fromBytes(indexedRoot(receipts), 0, 32).eq(h.receiptsRoot)) { return "receipts root does not match"; }
  for (i32 k = 0; k < 256; k++) {
    if (blockBloom[k] != h.bloom[k]) { return "logs bloom does not match"; }
  }
  if (!U256.fromBytes(indexedRoot(wsRaw), 0, 32).eq(h.withdrawalsRoot)) { return "withdrawals root does not match"; }
  if (!U256.fromBytes(stateRoot(w), 0, 32).eq(h.stateRoot)) { return "state root does not match"; }
  return "";
}

/** EIP-7685: sha256 over the sha256 of each non-empty request list, its type byte first. */
U256 requestsHashOf(u8[][] byType) {
  Vec<u8> all = Vec.create();
  for (i32 t = 0; t < byType.len(); t++) {
    if (byType[t].len() == 0) { continue; }
    u8[] typed = u8[].filled(byType[t].len() + 1, 0);
    typed[0] = t as! u8;
    for (i32 i = 0; i < byType[t].len(); i++) { typed[i + 1] = byType[t][i]; }
    u8[] h = sha256(typed);
    for (i32 i = 0; i < 32; i++) { all.push(h[i]); }
  }
  return U256.fromBytes(sha256(all.toArray()), 0, 32);
}
