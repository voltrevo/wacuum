// U256 — the EVM's word: 256 bits, unsigned, arithmetic modulo 2^256.
//
// Four u64 words, least significant first. A value is immutable, so aliasing one is the same as copying it
// and the interpreter can hand the same object to the stack, to memory and to storage without care.
//
// ## EVM semantics, not mathematics
//
// The methods are the EVM's, because the EVM is the only reason this type exists: `div` and `mod` by zero
// are 0 rather than a trap, every operation wraps, and a shift by 256 or more gives 0. A caller wanting the
// mathematical answer has to ask for it, and nothing in this repository does.
//
// They are named methods rather than operators because an operator method on a struct is not found from
// any file but the one declaring it, at wac a473e07 — `docs/wac-asks.md` has the reproduction.
//
// ## Wide arithmetic
//
// wasm has no 64x64->128 multiply, so multiplication and division work in 32-bit limbs held in u64s: a
// limb product plus two limbs is at most 2^64 - 1 and never overflows. Division is Knuth's algorithm D over
// those limbs, and it takes any length of dividend, which is what lets MULMOD divide a 512-bit product
// directly instead of reducing step by step.

import { DivMod, divmod, mulFull, modLimbs } from "./limbs.wac";

static u64 MASK32 = 0xFFFFFFFF;

export const struct U256 {
  u64 w0;
  u64 w1;
  u64 w2;
  u64 w3;

  // ── Construction ────────────────────────────────────────────────────────────

  U256 zero() { return U256(0, 0, 0, 0); }
  U256 one() { return U256(1, 0, 0, 0); }
  U256 max() { return U256(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF); }
  U256 ofU64(u64 v) { return U256(v, 0, 0, 0); }
  U256 ofI32(i32 v) { return U256((v as@ u32) as u64, 0, 0, 0); }

  /**
   * The big-endian number spelled by `len` bytes of `b` from `off`, for `len` up to 32. Bytes past the end
   * of `b` read as zero, which is exactly what CALLDATALOAD and PUSH at the end of code want.
   */
  U256 fromBytes(const u8[] b, i32 off, i32 len) {
    u64[] w = u64[].filled(4, 0);
    for (i32 i = 0; i < len; i++) {
      i32 at = off + i;
      u64 byte = at >= 0 && at < b.len() ? b[at] as u64 : 0;
      i32 bit = (len - 1 - i) * 8;
      w[bit / 64] = w[bit / 64] | (byte << (bit % 64));
    }
    return U256(w[0], w[1], w[2], w[3]);
  }

  /** `0x`-prefixed or bare hex, up to 64 digits. Null for anything else. */
  U256? fromHex(string s) {
    i32 start = s.len() >= 2 && s.slice(0, 2) == "0x" ? 2 : 0;
    i32 digits = s.len() - start;
    if (digits == 0 || digits > 64) { return null; }
    u64[] w = u64[].filled(4, 0);
    for (i32 i = 0; i < digits; i++) {
      i32 v = hexDigit(s.toBytes()[s.len() - 1 - i]);
      if (v < 0) { return null; }
      i32 bit = i * 4;
      w[bit / 64] = w[bit / 64] | ((v as@ u32) as u64 << (bit % 64));
    }
    return U256(w[0], w[1], w[2], w[3]);
  }

  // ── Reading it back ─────────────────────────────────────────────────────────

  u64 word(this, i32 i) {
    switch (i) {
      case 0: { return this.w0; }
      case 1: { return this.w1; }
      case 2: { return this.w2; }
      default: { return this.w3; }
    }
  }

  /** A fresh reference to the same value. */
  U256 copy(this) { return U256(this.w0, this.w1, this.w2, this.w3); }

  bool isZero(this) { return (this.w0 | this.w1 | this.w2 | this.w3) == 0; }

  /** Whether the value fits a u64 — the question every offset, length and gas amount asks first. */
  bool fitsU64(this) { return (this.w1 | this.w2 | this.w3) == 0; }

  /** The low 64 bits. Callers that care about the rest ask `fitsU64` first. */
  u64 low(this) { return this.w0; }

  /** The 32 big-endian bytes. */
  u8[] toBytes(this) {
    u8[] out = u8[].filled(32, 0);
    this.writeBytes(out, 0);
    return out;
  }

  /** The 32 big-endian bytes, written into `out` at `off`. */
  void writeBytes(this, u8[] out, i32 off) {
    for (i32 i = 0; i < 32; i++) {
      i32 bit = (31 - i) * 8;
      out[off + i] = (this.word(bit / 64) >> (bit % 64)) as@ u8;
    }
  }

  /** Lower-case hex with `0x` and no leading zeros; zero is `0x0`, as JSON-RPC writes quantities. */
  string toHex(this) {
    string digits = "0123456789abcdef";
    string out = "";
    bool started = false;
    for (i32 i = 63; i >= 0; i--) {
      i32 bit = i * 4;
      i32 d = ((this.word(bit / 64) >> (bit % 64)) & 15) as@ i32;
      if (d != 0) { started = true; }
      if (started) { out += digits.slice(d, d + 1); }
    }
    return started ? "0x" + out : "0x0";
  }

  /** Decimal, for messages and test failures. */
  string toDecimal(this) {
    if (this.isZero()) { return "0"; }
    string out = "";
    U256 n = this.copy();
    U256 ten = U256.ofU64(10);
    while (!n.isZero()) {
      U256 q = n.div(ten);
      u64 d = n.sub(q.mul(ten)).w0;
      out = "0123456789".slice(d as! i32, (d as! i32) + 1) + out;
      n = q;
    }
    return out;
  }

  // ── Comparison ──────────────────────────────────────────────────────────────

  bool eq(this, U256 rhs) {
    return this.w0 == rhs.w0 && this.w1 == rhs.w1 && this.w2 == rhs.w2 && this.w3 == rhs.w3;
  }
  bool ne(this, U256 rhs) { return !this.eq(rhs); }

  /** -1, 0 or 1, unsigned. */
  i32 compare(this, U256 rhs) {
    for (i32 i = 3; i >= 0; i--) {
      u64 a = this.word(i);
      u64 b = rhs.word(i);
      if (a < b) { return -1; }
      if (a > b) { return 1; }
    }
    return 0;
  }
  bool lt(this, U256 rhs) { return this.compare(rhs) < 0; }
  bool le(this, U256 rhs) { return this.compare(rhs) <= 0; }
  bool gt(this, U256 rhs) { return this.compare(rhs) > 0; }
  bool ge(this, U256 rhs) { return this.compare(rhs) >= 0; }

  /** Whether the two's-complement reading is negative. */
  bool isNegative(this) { return (this.w3 >> 63) == 1; }

  /** -1, 0 or 1, reading both as two's complement — SLT and SGT. */
  i32 compareSigned(this, U256 rhs) {
    bool an = this.isNegative();
    bool bn = rhs.isNegative();
    if (an && !bn) { return -1; }
    if (bn && !an) { return 1; }
    return this.compare(rhs);
  }

  // ── Arithmetic, modulo 2^256 ────────────────────────────────────────────────

  U256 add(this, U256 rhs) {
    u64 r0 = this.w0 + rhs.w0;
    u64 c = r0 < this.w0 ? 1 : 0;
    u64 s1 = this.w1 + rhs.w1;
    u64 c1 = s1 < this.w1 ? 1 : 0;
    u64 r1 = s1 + c;
    c = c1 + (r1 < s1 ? 1 : 0);
    u64 s2 = this.w2 + rhs.w2;
    u64 c2 = s2 < this.w2 ? 1 : 0;
    u64 r2 = s2 + c;
    c = c2 + (r2 < s2 ? 1 : 0);
    return U256(r0, r1, r2, this.w3 + rhs.w3 + c);
  }

  U256 sub(this, U256 rhs) {
    return this.add(rhs.negate());
  }

  /** Two's-complement negation: 0 - this. */
  U256 negate(this) {
    return this.inverted().add(U256.one());
  }

  U256 mul(this, U256 rhs) {
    u64[] p = mulLimbs(toLimbs(this), toLimbs(rhs));
    return fromLimbs(p, 0);
  }

  /** Unsigned division; zero when `rhs` is zero, as DIV has it. */
  U256 div(this, U256 rhs) {
    if (rhs.isZero()) { return U256.zero(); }
    if (this.lt(rhs)) { return U256.zero(); }
    DivMod d = divmod(toLimbs(this), toLimbs(rhs));
    return fromLimbs(d.quotient, 0);
  }

  /** Unsigned remainder; zero when `rhs` is zero, as MOD has it. */
  U256 mod(this, U256 rhs) {
    if (rhs.isZero()) { return U256.zero(); }
    if (this.lt(rhs)) { return this.copy(); }
    DivMod d = divmod(toLimbs(this), toLimbs(rhs));
    return fromLimbs(d.remainder, 0);
  }

  /** SDIV: truncating division of the two's-complement readings, zero by zero, and MIN / -1 is MIN. */
  U256 sdiv(this, U256 rhs) {
    if (rhs.isZero()) { return U256.zero(); }
    bool an = this.isNegative();
    bool bn = rhs.isNegative();
    U256 q = this.abs().div(rhs.abs());
    return an != bn ? q.negate() : q;
  }

  /** SMOD: the remainder takes the sign of the dividend. */
  U256 smod(this, U256 rhs) {
    if (rhs.isZero()) { return U256.zero(); }
    U256 r = this.abs().mod(rhs.abs());
    return this.isNegative() ? r.negate() : r;
  }

  U256 abs(this) { return this.isNegative() ? this.negate() : this.copy(); }

  /** ADDMOD: (this + b) mod n over the full 257-bit sum, zero when n is zero. */
  U256 addmod(this, U256 b, U256 n) {
    if (n.isZero()) { return U256.zero(); }
    u64[] x = toLimbs(this);
    u64[] y = toLimbs(b);
    u64[] s = u64[].filled(9, 0);
    u64 carry = 0;
    for (i32 i = 0; i < 8; i++) {
      u64 t = x[i] + y[i] + carry;
      s[i] = t & MASK32;
      carry = t >> 32;
    }
    s[8] = carry;
    return fromLimbs(modLimbs(s, toLimbs(n)), 0);
  }

  /** MULMOD: (this * b) mod n over the full 512-bit product, zero when n is zero. */
  U256 mulmod(this, U256 b, U256 n) {
    if (n.isZero()) { return U256.zero(); }
    return fromLimbs(modLimbs(mulFull(toLimbs(this), toLimbs(b)), toLimbs(n)), 0);
  }

  /** EXP: this ^ e modulo 2^256, square and multiply. */
  U256 exp(this, U256 e) {
    U256 result = U256.one();
    U256 base = this.copy();
    for (i32 i = 0; i < 4; i++) {
      u64 w = e.word(i);
      for (i32 bit = 0; bit < 64; bit++) {
        if ((w & 1) == 1) { result = result.mul(base); }
        w = w >> 1;
        base = base.mul(base);
      }
    }
    return result;
  }

  /** How many bytes the value needs — EXP's gas is priced on the exponent's. */
  i32 byteLen(this) {
    for (i32 i = 3; i >= 0; i--) {
      u64 w = this.word(i);
      if (w != 0) {
        i32 n = 8;
        while ((w >> 56) == 0) { w = w << 8; n--; }
        return i * 8 + n;
      }
    }
    return 0;
  }

  /** SIGNEXTEND: extend the sign of byte `b` (counting from the least significant) through the rest. */
  U256 signextend(this, U256 b) {
    if (!b.fitsU64() || b.w0 >= 31) { return this.copy(); }
    i32 bit = (b.w0 as! i32) * 8 + 7;
    bool neg = ((this.word(bit / 64) >> (bit % 64)) & 1) == 1;
    U256 mask = U256.one().shl(bit + 1).sub(U256.one());
    return neg ? this.or(mask.inverted()) : this.and(mask);
  }

  // ── Bits ────────────────────────────────────────────────────────────────────

  U256 and(this, U256 rhs) {
    return U256(this.w0 & rhs.w0, this.w1 & rhs.w1, this.w2 & rhs.w2, this.w3 & rhs.w3);
  }
  U256 or(this, U256 rhs) {
    return U256(this.w0 | rhs.w0, this.w1 | rhs.w1, this.w2 | rhs.w2, this.w3 | rhs.w3);
  }
  U256 xor(this, U256 rhs) {
    return U256(this.w0 ^ rhs.w0, this.w1 ^ rhs.w1, this.w2 ^ rhs.w2, this.w3 ^ rhs.w3);
  }
  U256 inverted(this) {
    return U256(~this.w0, ~this.w1, ~this.w2, ~this.w3);
  }

  /** Shift left by `n` bits; 256 or more gives zero. */
  U256 shl(this, i32 n) {
    if (n <= 0) { return n == 0 ? this.copy() : U256.zero(); }
    if (n >= 256) { return U256.zero(); }
    u64[] w = u64[].filled(4, 0);
    i32 words = n / 64;
    i32 bits = n % 64;
    for (i32 i = 3; i >= words; i--) {
      u64 v = this.word(i - words) << bits;
      if (bits != 0 && i - words - 1 >= 0) { v = v | (this.word(i - words - 1) >> (64 - bits)); }
      w[i] = v;
    }
    return U256(w[0], w[1], w[2], w[3]);
  }

  /** Logical shift right by `n` bits; 256 or more gives zero. */
  U256 shr(this, i32 n) {
    if (n <= 0) { return n == 0 ? this.copy() : U256.zero(); }
    if (n >= 256) { return U256.zero(); }
    u64[] w = u64[].filled(4, 0);
    i32 words = n / 64;
    i32 bits = n % 64;
    for (i32 i = 0; i + words < 4; i++) {
      u64 v = this.word(i + words) >> bits;
      if (bits != 0 && i + words + 1 < 4) { v = v | (this.word(i + words + 1) << (64 - bits)); }
      w[i] = v;
    }
    return U256(w[0], w[1], w[2], w[3]);
  }

  /** Arithmetic shift right by `n` bits: the sign fills in, and 256 or more gives 0 or all ones. */
  U256 sar(this, i32 n) {
    if (!this.isNegative()) { return this.shr(n); }
    if (n >= 256) { return U256.max(); }
    return this.inverted().shr(n).inverted();
  }

  /** The shift amount an EVM shift takes from the stack, clamped: anything 256 or above is 256. */
  i32 shiftAmount(this) {
    return this.fitsU64() && this.w0 < 256 ? this.w0 as! i32 : 256;
  }

  /** BYTE: the `i`th byte counting from the most significant, or zero past the 32nd. */
  U256 byteAt(this, U256 i) {
    if (!i.fitsU64() || i.w0 >= 32) { return U256.zero(); }
    i32 bit = (31 - (i.w0 as! i32)) * 8;
    return U256.ofU64((this.word(bit / 64) >> (bit % 64)) & 0xFF);
  }
}

i32 hexDigit(u8 c) {
  if (c >= 48 && c <= 57) { return (c as i32) - 48; }
  if (c >= 97 && c <= 102) { return (c as i32) - 87; }
  if (c >= 65 && c <= 70) { return (c as i32) - 55; }
  return -1;
}

// ── Limbs ─────────────────────────────────────────────────────────────────────
//
// A limb array is 32-bit digits in u64s, least significant first.

u64[] toLimbs(U256 x) {
  u64[] l = u64[].filled(8, 0);
  for (i32 i = 0; i < 4; i++) {
    u64 w = x.word(i);
    l[2 * i] = w & MASK32;
    l[2 * i + 1] = w >> 32;
  }
  return l;
}

/** The U256 in limbs `off..off+8`, missing limbs reading as zero. */
U256 fromLimbs(const u64[] l, i32 off) {
  u64[] w = u64[].filled(4, 0);
  for (i32 i = 0; i < 4; i++) {
    i32 lo = off + 2 * i;
    u64 a = lo < l.len() ? l[lo] : 0;
    u64 b = lo + 1 < l.len() ? l[lo + 1] : 0;
    w[i] = a | (b << 32);
  }
  return U256(w[0], w[1], w[2], w[3]);
}

/** The low eight limbs of the product. */
u64[] mulLimbs(const u64[] a, const u64[] b) {
  u64[] r = u64[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) {
    if (a[i] == 0) { continue; }
    u64 carry = 0;
    for (i32 j = 0; i + j < 8; j++) {
      u64 t = r[i + j] + a[i] * b[j] + carry;
      r[i + j] = t & MASK32;
      carry = t >> 32;
    }
  }
  return r;
}

