// JSON-RPC 2.0 over HTTP/1.1, as much of each as the Engine API needs.
//
// A request is read in full before anything is answered: headers up to the blank line, then exactly
// Content-Length bytes of body. Each response closes its connection, which every consensus client
// handles; keeping connections alive is an optimisation for later. A request without a valid JWT is
// answered 401 and never reaches the engine.

import { Vec } from "core";
import { json.parse, json.stringify, json.JsonValue, json.JsonObject, json.JsonArray } from "wac";
import { Engine, Answer } from "./engine.wac";
import { checkJwt } from "./jwt.wac";

export struct HttpRequest {
  string method;
  string path;
  string authorization;
  i32 contentLength;
  u8[] body;
}

/** Where the headers end (the index just past the blank line), or -1 when they have not all arrived. */
export i32 headersEnd(u8[] buf, i32 len) {
  for (i32 i = 3; i < len; i++) {
    if (buf[i - 3] == 13 && buf[i - 2] == 10 && buf[i - 1] == 13 && buf[i] == 10) { return i + 1; }
  }
  return -1;
}

/** The request line and the two headers that matter, from the bytes before the blank line. */
export HttpRequest? parseHead(u8[] buf, i32 end) {
  u8[] head = u8[].filled(end, 0);
  for (i32 i = 0; i < end; i++) { head[i] = buf[i]; }
  string text = string.fromBytes(head);
  i32 eol = text.indexOf("\r\n");
  if (eol < 0) { return null; }
  string line = text.slice(0, eol);
  i32 sp1 = line.indexOf(" ");
  if (sp1 < 0) { return null; }
  string afterMethod = line.slice(sp1 + 1, line.len());
  i32 sp2 = afterMethod.indexOf(" ");
  HttpRequest r = HttpRequest(line.slice(0, sp1), sp2 < 0 ? afterMethod : afterMethod.slice(0, sp2), "", 0, u8[].filled(0, 0));
  string rest = text.slice(eol + 2, text.len());
  while (rest.len() > 0) {
    i32 e = rest.indexOf("\r\n");
    if (e <= 0) { break; }
    string h = rest.slice(0, e);
    rest = rest.slice(e + 2, rest.len());
    i32 colon = h.indexOf(":");
    if (colon < 0) { continue; }
    string name = lower(h.slice(0, colon));
    string value = trim(h.slice(colon + 1, h.len()));
    if (name == "content-length") {
      i32 n = 0;
      u8[] d = value.toBytes();
      for (i32 i = 0; i < d.len(); i++) {
        if (d[i] < 48 || d[i] > 57 || n > 100000000) { return null; }
        n = n * 10 + ((d[i] - 48) as i32);
      }
      r.contentLength = n;
    }
    if (name == "authorization") { r.authorization = value; }
  }
  return r;
}

string lower(string s) {
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] >= 65 && b[i] <= 90) { b[i] = b[i] + 32; }
  }
  return string.fromBytes(b);
}

string trim(string s) {
  i32 a = 0;
  i32 b = s.len();
  while (a < b && (s.slice(a, a + 1) == " " || s.slice(a, a + 1) == "\t")) { a++; }
  while (b > a && (s.slice(b - 1, b) == " " || s.slice(b - 1, b) == "\t")) { b--; }
  return s.slice(a, b);
}

export u8[] httpResponse(i32 code, string reason, u8[] body) {
  string head = "HTTP/1.1 \{code} \{reason}\r\nContent-Type: application/json\r\nContent-Length: \{body.len()}\r\nConnection: close\r\n\r\n";
  u8[] h = head.toBytes();
  u8[] out = u8[].filled(h.len() + body.len(), 0);
  for (i32 i = 0; i < h.len(); i++) { out[i] = h[i]; }
  for (i32 i = 0; i < body.len(); i++) { out[h.len() + i] = body[i]; }
  return out;
}

/** The whole HTTP answer to a request: 401 without a valid token, otherwise the JSON-RPC response. */
export u8[] answerHttp(Engine e, HttpRequest r, u8[] secret, i64 nowSeconds) {
  string auth = r.authorization;
  if (auth.indexOf("Bearer ") != 0) { return httpResponse(401, "Unauthorized", "{\"error\":\"missing bearer token\"}".toBytes()); }
  string why = checkJwt(auth.slice(7, auth.len()), secret, nowSeconds);
  if (why != "") { return httpResponse(401, "Unauthorized", ("{\"error\":\"" + why + "\"}").toBytes()); }
  return httpResponse(200, "OK", answerRpc(e, r.body));
}

/** A JSON-RPC response body: one answer, or an array of them for a batch. */
export u8[] answerRpc(Engine e, u8[] body) {
  JsonValue? doc = parse(body).ok();
  if (doc is null) { return stringify(rpcError(JsonValue.Null, -32700, "parse error")); }
  JsonArray? batch = doc!.array();
  if (batch is null) { return stringify(one(e, doc!)); }
  JsonArray out = JsonArray.create();
  for (i32 i = 0; i < batch!.len(); i++) { out.push(one(e, batch!.get(i))); }
  return stringify(JsonValue.Array(out));
}

JsonValue one(Engine e, JsonValue req) {
  JsonValue id = req.member("id") ?? JsonValue.Null;
  string? method = req.member("method")?.text();
  if (method is null) { return rpcError(id, -32600, "invalid request"); }
  Answer a = e.call(method!, req.member("params") ?? JsonValue.Array(JsonArray.create()));
  if (a.result is null) { return rpcError(id, a.code, a.message); }
  JsonObject o = JsonObject.create();
  o.push("jsonrpc".toBytes(), JsonValue.Str("2.0".toBytes()));
  o.push("id".toBytes(), id);
  o.push("result".toBytes(), a.result!);
  return JsonValue.Object(o);
}

JsonValue rpcError(JsonValue id, i32 code, string message) {
  JsonObject err = JsonObject.create();
  err.push("code".toBytes(), JsonValue.Number(code as f64, "\{code}".toBytes()));
  err.push("message".toBytes(), JsonValue.Str(message.toBytes()));
  JsonObject o = JsonObject.create();
  o.push("jsonrpc".toBytes(), JsonValue.Str("2.0".toBytes()));
  o.push("id".toBytes(), id);
  o.push("error".toBytes(), JsonValue.Object(err));
  return JsonValue.Object(o);
}
