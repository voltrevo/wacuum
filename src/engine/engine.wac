// The Engine API: how a consensus client drives an execution client. It hands over blocks as execution
// payloads (`engine_newPayloadV*`) and says which one is the head (`engine_forkchoiceUpdatedV*`), and
// this answers whether each payload is VALID, INVALID, or cannot be judged yet because its parent is
// unknown (SYNCING).
//
// This layer takes a method name and JSON params and gives back a JSON result or a JSON-RPC error. It
// knows nothing of HTTP or of the JWT that authenticates a caller — `server.wac` wraps it in those — so
// execution-spec-tests' engine fixtures can call it directly.
//
// ## From payload to block
//
// A payload is a block with its header flattened into fields and its transactions as opaque bytes. Two
// header fields are not sent at all and are derived: the transactions root and the withdrawals root, and
// from Prague the requests hash, from the execution requests sent beside the payload. The block hash the
// consensus client sends must equal the hash of the header rebuilt that way, which is what makes the
// payload's own fields binding.

import { Map, Vec } from "core";
import { crypto.keccak256, crypto.sha256 } from "wac";
import { json.JsonValue, json.JsonObject, json.JsonArray } from "wac";
import { rlp.Item, rlp.encode, rlp.decode, rlp.Decoded } from "wac";
import { U256 } from "../u256.wac";
import { hexToBytes, bytesToHex } from "../hex.wac";
import { World, hashU256, eqU256 } from "../state/world.wac";
import { u256Bytes } from "../state/root.wac";
import { trieRoot } from "../trie/trie.wac";
import { addressBytes, Evm, BlockEnv, TxEnv, Message, processMessage } from "../evm/evm.wac";
import { Outcome } from "../evm/interp.wac";
import { OpTable } from "../evm/table.wac";
import { blobGasPrice } from "../tx/process.wac";
import { Spec, ChainConfig } from "../evm/spec.wac";
import { Header, Block, Withdrawal, applyBlock, headerItem, nextBaseFee, nextExcessBlobGas, EMPTY_OMMERS, requestsHashOf,
         indexedRoot } from "../chain/block.wac";
import { decodeTransaction, DecodedTx } from "../tx/decode.wac";
import { Attributes, Built, buildBlock } from "../chain/build.wac";

/** A block this client has executed, with the state after it. */
struct Node {
  Header header;
  World world;
}

/** A JSON-RPC answer: a result, or an error with its code. */
export struct Answer {
  JsonValue? result;
  i32 code;
  string message;

  Answer ok(JsonValue v) { return Answer(v, 0, ""); }
  Answer error(i32 code, string message) { return Answer(null, code, message); }
}

export struct Engine {
  /** The chain's forks: each payload runs under the one its timestamp has reached. */
  ChainConfig config;
  U256 chainId;
  Map<U256, Node> blocks;
  /** Block number to hash along the canonical chain, for BLOCKHASH. */
  Map<U256, U256> canonical;
  U256 head;
  U256 safe;
  U256 finalized;
  /** Transactions sent with eth_sendRawTransaction, waiting for a block, in arrival order. */
  Vec<Item> mempool;
  /** Blocks built for a payload id, waiting for engine_getPayload. */
  Map<U256, Built> payloads;
  u64 nextPayloadId;

  /** An engine whose chain starts at `genesis`, with `world` its state. */
  Engine create(ChainConfig config, Header genesis, World world) {
    Engine e = Engine(config, config.chainId, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256), genesis.hash, genesis.hash,
                      genesis.hash, Vec.create(), Map.create(hashU256, eqU256), 1);
    e.blocks.set(genesis.hash, Node(genesis, world));
    e.canonical.set(genesis.number, genesis.hash);
    return e;
  }

  Answer call(this, string method, JsonValue params) {
    JsonArray? ps = params.array();
    if (ps is null) { return Answer.error(-32602, "params must be an array"); }
    if (method == "engine_newPayloadV1") { return this.newPayload(1, ps!); }
    if (method == "engine_newPayloadV2") { return this.newPayload(2, ps!); }
    if (method == "engine_newPayloadV3") { return this.newPayload(3, ps!); }
    if (method == "engine_newPayloadV4") { return this.newPayload(4, ps!); }
    if (method == "engine_forkchoiceUpdatedV1" || method == "engine_forkchoiceUpdatedV2" ||
        method == "engine_forkchoiceUpdatedV3") {
      return this.forkchoiceUpdated(ps!);
    }
    if (method == "engine_getPayloadV3") { return this.getPayload(3, ps!); }
    if (method == "engine_getPayloadV4") { return this.getPayload(4, ps!); }
    if (method == "eth_sendRawTransaction") { return this.sendRawTransaction(ps!); }
    if (method == "eth_getBalance") { return Answer.ok(str(this.headState().balance(hexU256(arg(ps!, 0))).toHex())); }
    if (method == "eth_getTransactionCount") {
      return Answer.ok(str(U256.ofU64(this.headState().nonce(hexU256(arg(ps!, 0)))).toHex()));
    }
    if (method == "eth_getCode") { return Answer.ok(str(bytesToHex(this.headState().code(hexU256(arg(ps!, 0)))))); }
    if (method == "eth_getStorageAt") {
      return Answer.ok(str(hex32(this.headState().storage(hexU256(arg(ps!, 0)), hexU256(arg(ps!, 1))))));
    }
    if (method == "eth_call") { return this.ethCall(ps!); }
    if (method == "engine_exchangeCapabilities") { return Answer.ok(capabilities()); }
    if (method == "eth_chainId") { return Answer.ok(str(this.chainId.toHex())); }
    if (method == "eth_blockNumber") { return Answer.ok(str(this.blocks.get(this.head)!.header.number.toHex())); }
    return Answer.error(-32601, "method not found: " + method);
  }

  // ── engine_newPayload ──

  Answer newPayload(this, i32 version, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no payload"); }
    JsonValue p = ps.get(0);
    if (p.object() is null) { return Answer.error(-32602, "the payload is not an object"); }
    bool hasWithdrawals = p.member("withdrawals") is not null && !p.member("withdrawals")!.isNull();
    bool hasBlobFields = p.member("blobGasUsed") is not null || p.member("excessBlobGas") is not null;
    // Each version names exactly the fields its fork has; a payload that disagrees is a malformed call.
    if (version == 2 && hasBlobFields) { return Answer.error(-32602, "blob fields before V3"); }
    if (version >= 3) {
      if (!hasWithdrawals || p.member("blobGasUsed") is null || p.member("excessBlobGas") is null) {
        return Answer.error(-32602, "a V\{version} payload needs withdrawals, blobGasUsed and excessBlobGas");
      }
      if (ps.len() < 3 || ps.get(1).array() is null || ps.get(2).text() is null) {
        return Answer.error(-32602, "V\{version} needs expected blob hashes and a parent beacon root");
      }
    }
    u8[][] requests = u8[][].defaulted(0);
    if (version >= 4) {
      if (ps.len() < 4 || ps.get(3).array() is null) { return Answer.error(-32602, "V4 needs execution requests"); }
      JsonArray rs = ps.get(3).array()!;
      requests = u8[][].defaulted(rs.len());
      i32 lastType = -1;
      for (i32 i = 0; i < rs.len(); i++) {
        u8[]? r = hexToBytes(rs.get(i).text() ?? "x");
        // Each request list is its type byte and then its data: types strictly ascending, none empty.
        if (r is null || r!.len() < 2 || (r![0] as i32) <= lastType) { return Answer.error(-32602, "malformed execution requests"); }
        lastType = r![0] as i32;
        requests[i] = r!;
      }
    }

    Header h = headerFrom(p);
    U256 claimed = hexU256(p.member("blockHash"));
    Vec<Item> txs = Vec.create();
    JsonArray rawTxs = p.member("transactions")?.array() ?? JsonArray.create();
    Vec<U256> blobHashes = Vec.create();
    u8[][] txBytes = u8[][].defaulted(rawTxs.len());
    for (i32 i = 0; i < rawTxs.len(); i++) {
      u8[] raw = hexToBytes(rawTxs.get(i).text() ?? "x") ?? u8[].filled(0, 0);
      txBytes[i] = raw;
      Item? it = txItem(raw);
      if (it is null) { return this.invalid(h, "transaction \{i} does not decode"); }
      txs.push(it!);
      DecodedTx d = decodeTransaction(it!, this.chainId);
      for (i32 k = 0; k < d.tx.blobHashes.len(); k++) { blobHashes.push(d.tx.blobHashes[k]); }
    }
    Withdrawal[] withdrawals = withdrawalsFrom(p.member("withdrawals"));

    // The header the payload describes, with the fields the payload does not carry derived.
    h.txRoot = U256.fromBytes(indexedRoot(txBytes), 0, 32);
    u8[][] wsRaw = u8[][].defaulted(withdrawals.len());
    for (i32 i = 0; i < withdrawals.len(); i++) {
      Withdrawal wd = withdrawals[i];
      Item[] fields = [Item.Bytes(u256Bytes(wd.index)), Item.Bytes(u256Bytes(wd.validator)), Item.Bytes(addressBytes(wd.address)),
                       Item.Bytes(u256Bytes(wd.amount))];
      wsRaw[i] = encode(Item.List(fields));
    }
    h.withdrawalsRoot = U256.fromBytes(indexedRoot(wsRaw), 0, 32);
    if (version >= 3) { h.parentBeaconBlockRoot = hexU256(ps.get(2)); }
    if (version >= 4) {
      // The requests hash is over each list's data with its type byte; the payload already has them so.
      u8[][] byType = u8[][].defaulted(3);
      for (i32 t = 0; t < 3; t++) { byType[t] = u8[].filled(0, 0); }
      for (i32 i = 0; i < requests.len(); i++) {
        i32 t = requests[i][0] as i32;
        if (t < 3) {
          u8[] data = u8[].filled(requests[i].len() - 1, 0);
          for (i32 k = 0; k < data.len(); k++) { data[k] = requests[i][k + 1]; }
          byType[t] = data;
        }
      }
      h.requestsHash = requestsHashOf(byType);
    }
    Spec spec = this.config.specAt(h.timestamp);
    h.hash = U256.fromBytes(keccak256(encode(headerItem(spec, h))), 0, 32);
    if (!h.hash.eq(claimed)) { return this.invalidNoAncestor("block hash \{claimed.toHex()} is not the payload's, \{h.hash.toHex()}"); }

    // EIP-4844: the blob hashes the consensus layer expects must be exactly the transactions', in order.
    if (version >= 3) {
      JsonArray expected = ps.get(1).array()!;
      U256[] got = blobHashes.toArray();
      bool same = expected.len() == got.len();
      for (i32 i = 0; same && i < got.len(); i++) { same = hexU256(expected.get(i)).eq(got[i]); }
      if (!same) { return this.invalidNoAncestor("the versioned hashes do not match the transactions'"); }
    }

    if (this.blocks.has(h.hash)) { return status("VALID", h.hash.toHex(), ""); }
    Node? parent = this.blocks.get(h.parentHash);
    if (parent is null) { return status("SYNCING", "", ""); }
    World w = parent!.world.clone();
    Block b = Block(h, txs.toArray(), false, withdrawals);
    string err = applyBlock(spec, w, b, parent!.header, this.chainId, this.ancestorHashes(parent!.header));
    if (err != "") { return this.invalid(h, err); }
    this.blocks.set(h.hash, Node(h, w));
    return status("VALID", h.hash.toHex(), "");
  }

  /** INVALID, naming the parent as the latest valid ancestor when this client has it. */
  Answer invalid(this, Header h, string why) {
    return status("INVALID", this.blocks.has(h.parentHash) ? h.parentHash.toHex() : "", why);
  }

  Answer invalidNoAncestor(this, string why) { return status("INVALID", "", why); }

  /** Number to hash for the chain ending at `tip`, back as far as BLOCKHASH can see. */
  Map<U256, U256> ancestorHashes(this, Header tip) {
    Map<U256, U256> m = Map.create(hashU256, eqU256);
    Header cur = tip;
    for (i32 i = 0; i < 256; i++) {
      m.set(cur.number, cur.hash);
      Node? p = this.blocks.get(cur.parentHash);
      if (p is null) { break; }
      cur = p!.header;
    }
    return m;
  }

  // ── engine_forkchoiceUpdated ──

  Answer forkchoiceUpdated(this, JsonArray ps) {
    if (ps.len() < 1 || ps.get(0).object() is null) { return Answer.error(-32602, "no forkchoice state"); }
    JsonValue fc = ps.get(0);
    U256 head = hexU256(fc.member("headBlockHash"));
    if (!this.blocks.has(head)) { return Answer.ok(forkchoiceResult(status("SYNCING", "", "").result!)); }
    this.head = head;
    this.safe = hexU256(fc.member("safeBlockHash"));
    this.finalized = hexU256(fc.member("finalizedBlockHash"));
    // Walk back from the new head, rewriting the canonical number-to-hash map until it agrees.
    Header cur = this.blocks.get(head)!.header;
    while (true) {
      U256? known = this.canonical.get(cur.number);
      if (known is not null && known!.eq(cur.hash)) { break; }
      this.canonical.set(cur.number, cur.hash);
      Node? p = this.blocks.get(cur.parentHash);
      if (p is null) { break; }
      cur = p!.header;
    }
    this.prune();
    JsonValue payloadId = JsonValue.Null;
    if (ps.len() >= 2 && ps.get(1).object() is not null) {
      JsonValue at = ps.get(1);
      Header parent = this.blocks.get(head)!.header;
      if (!hexU256(at.member("timestamp")).gt(parent.timestamp)) { return Answer.error(-38003, "invalid payload attributes: timestamp"); }
      Attributes attrs = Attributes(hexU256(at.member("timestamp")), hexU256(at.member("prevRandao")),
                                    hexU256(at.member("suggestedFeeRecipient")), withdrawalsFrom(at.member("withdrawals")),
                                    hexU256(at.member("parentBeaconBlockRoot")));
      Built built = buildBlock(this.config.specAt(attrs.timestamp), this.blocks.get(head)!.world.clone(), parent, attrs, this.mempool.toArray(),
                               this.chainId, this.ancestorHashes(parent));
      U256 id = U256.ofU64(this.nextPayloadId);
      this.nextPayloadId++;
      this.payloads.set(id, built);
      payloadId = str(hex8(id));
    }
    JsonObject o = JsonObject.create();
    o.push("payloadStatus".toBytes(), status("VALID", head.toHex(), "").result!);
    o.push("payloadId".toBytes(), payloadId);
    return Answer.ok(JsonValue.Object(o));
  }

  /** Drop what the head's state has made stale: a transaction whose nonce its sender has already used. */
  void prune(this) {
    World w = this.headState();
    Vec<Item> keep = Vec.create();
    Item[] all = this.mempool.toArray();
    for (i32 i = 0; i < all.len(); i++) {
      DecodedTx d = decodeTransaction(all[i], this.chainId);
      if (d.error != "") { continue; }
      if (d.tx.nonce.lt(U256.ofU64(w.nonce(d.tx.sender)))) { continue; }
      keep.push(all[i]);
    }
    this.mempool = keep;
  }

  // ── eth_sendRawTransaction ──

  Answer sendRawTransaction(this, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no transaction"); }
    u8[]? raw = hexToBytes(ps.get(0).text() ?? "x");
    if (raw is null) { return Answer.error(-32602, "the transaction is not hex"); }
    Item? it = txItem(raw!);
    if (it is null) { return Answer.error(-32602, "the transaction does not decode"); }
    DecodedTx d = decodeTransaction(it!, this.chainId);
    if (d.error != "") { return Answer.error(-32000, d.error); }
    if (d.tx.nonce.lt(U256.ofU64(this.headState().nonce(d.tx.sender)))) { return Answer.error(-32000, "nonce too low"); }
    this.mempool.push(it!);
    return Answer.ok(str(bytesToHex(keccak256(d.raw))));
  }

  // ── engine_getPayload ──

  Answer getPayload(this, i32 version, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no payload id"); }
    Built? b = this.payloads.get(hexU256(ps.get(0)));
    if (b is null) { return Answer.error(-38001, "unknown payload"); }
    Built built = b!;
    Header h = built.block.header;
    JsonObject p = JsonObject.create();
    p.push("parentHash".toBytes(), str(hex32(h.parentHash)));
    p.push("feeRecipient".toBytes(), str(bytesToHex(addressBytes(h.coinbase))));
    p.push("stateRoot".toBytes(), str(hex32(h.stateRoot)));
    p.push("receiptsRoot".toBytes(), str(hex32(h.receiptsRoot)));
    p.push("logsBloom".toBytes(), str(bytesToHex(h.bloom)));
    p.push("prevRandao".toBytes(), str(hex32(h.prevRandao)));
    p.push("blockNumber".toBytes(), str(h.number.toHex()));
    p.push("gasLimit".toBytes(), str(h.gasLimit.toHex()));
    p.push("gasUsed".toBytes(), str(h.gasUsed.toHex()));
    p.push("timestamp".toBytes(), str(h.timestamp.toHex()));
    p.push("extraData".toBytes(), str(bytesToHex(h.extraData)));
    p.push("baseFeePerGas".toBytes(), str(h.baseFee.toHex()));
    p.push("blockHash".toBytes(), str(hex32(h.hash)));
    JsonArray txs = JsonArray.create();
    for (i32 i = 0; i < built.block.txs.len(); i++) {
      DecodedTx d = decodeTransaction(built.block.txs[i], this.chainId);
      txs.push(str(bytesToHex(d.raw)));
    }
    p.push("transactions".toBytes(), JsonValue.Array(txs));
    JsonArray ws = JsonArray.create();
    for (i32 i = 0; i < built.block.withdrawals.len(); i++) {
      Withdrawal wd = built.block.withdrawals[i];
      JsonObject o = JsonObject.create();
      o.push("index".toBytes(), str(wd.index.toHex()));
      o.push("validatorIndex".toBytes(), str(wd.validator.toHex()));
      o.push("address".toBytes(), str(bytesToHex(addressBytes(wd.address))));
      o.push("amount".toBytes(), str(wd.amount.toHex()));
      ws.push(JsonValue.Object(o));
    }
    p.push("withdrawals".toBytes(), JsonValue.Array(ws));
    p.push("blobGasUsed".toBytes(), str(h.blobGasUsed.toHex()));
    p.push("excessBlobGas".toBytes(), str(h.excessBlobGas.toHex()));

    JsonObject bundle = JsonObject.create();
    bundle.push("commitments".toBytes(), JsonValue.Array(JsonArray.create()));
    bundle.push("proofs".toBytes(), JsonValue.Array(JsonArray.create()));
    bundle.push("blobs".toBytes(), JsonValue.Array(JsonArray.create()));
    JsonObject out = JsonObject.create();
    out.push("executionPayload".toBytes(), JsonValue.Object(p));
    out.push("blockValue".toBytes(), str(built.body.fees.toHex()));
    out.push("blobsBundle".toBytes(), JsonValue.Object(bundle));
    out.push("shouldOverrideBuilder".toBytes(), JsonValue.Bool(false));
    if (version >= 4) {
      // Each non-empty request list, its type byte first: the form newPayloadV4 takes back.
      JsonArray rs = JsonArray.create();
      for (i32 t = 0; t < built.body.requests.len(); t++) {
        u8[] data = built.body.requests[t];
        if (data.len() == 0) { continue; }
        u8[] typed = u8[].filled(data.len() + 1, 0);
        typed[0] = t as! u8;
        for (i32 k = 0; k < data.len(); k++) { typed[k + 1] = data[k]; }
        rs.push(str(bytesToHex(typed)));
      }
      out.push("executionRequests".toBytes(), JsonValue.Array(rs));
    }
    return Answer.ok(JsonValue.Object(out));
  }

  /**
   * eth_call: a message run on a copy of the head's state, as if in the next block, and thrown away. Only
   * the head is answered for — a block tag naming another block is not looked at yet.
   */
  Answer ethCall(this, JsonArray ps) {
    if (ps.len() < 1 || ps.get(0).object() is null) { return Answer.error(-32602, "no call object"); }
    JsonValue c = ps.get(0);
    Header h = this.blocks.get(this.head)!.header;
    Spec spec = this.config.specAt(h.timestamp.add(U256.ofU64(12)));
    World w = this.headState().clone();
    BlockEnv env = BlockEnv(h.coinbase, h.number.add(U256.one()), h.timestamp.add(U256.ofU64(12)), h.gasLimit,
                            h.prevRandao, nextBaseFee(h), blobGasPrice(spec, nextExcessBlobGas(spec, h)), this.chainId,
                            this.ancestorHashes(h));
    U256 from = hexU256(c.member("from"));
    U256 to = hexU256(c.member("to"));
    u8[] data = c.member("input") is not null ? hexBytes(c.member("input")) : hexBytes(c.member("data"));
    U256 gas = c.member("gas") is not null ? hexU256(c.member("gas")) : h.gasLimit;
    Evm evm = Evm(w, env, TxEnv(from, U256.zero(), U256[].filled(0, U256.zero())), spec.table, spec, null);
    w.warmAddress(from);
    w.warmAddress(to);
    Message m = Message(from, to, to, hexU256(c.member("value")), data, gas.low() as@ i64, false, 0, true, false);
    Outcome o = processMessage(evm, m);
    if (!o.succeeded()) { return Answer.error(3, "execution reverted: " + bytesToHex(o.output())); }
    return Answer.ok(str(bytesToHex(o.output())));
  }

  /** The state at the head of the chain. */
  World headState(this) { return this.blocks.get(this.head)!.world; }
}

// ── JSON helpers ─────────────────────────────────────────────────────────────────

JsonValue str(string s) { return JsonValue.Str(s.toBytes()); }

Answer status(string st, string latestValid, string why) {
  JsonObject o = JsonObject.create();
  o.push("status".toBytes(), str(st));
  o.push("latestValidHash".toBytes(), latestValid == "" ? JsonValue.Null : str(latestValid));
  o.push("validationError".toBytes(), why == "" ? JsonValue.Null : str(why));
  return Answer.ok(JsonValue.Object(o));
}

JsonValue forkchoiceResult(JsonValue payloadStatus) {
  JsonObject o = JsonObject.create();
  o.push("payloadStatus".toBytes(), payloadStatus);
  o.push("payloadId".toBytes(), JsonValue.Null);
  return JsonValue.Object(o);
}

JsonValue capabilities() {
  string[] names = ["engine_newPayloadV1", "engine_newPayloadV2", "engine_newPayloadV3", "engine_newPayloadV4",
                    "engine_forkchoiceUpdatedV1", "engine_forkchoiceUpdatedV2", "engine_forkchoiceUpdatedV3",
                    "engine_getPayloadV3", "engine_getPayloadV4"];
  JsonArray a = JsonArray.create();
  for (i32 i = 0; i < names.len(); i++) { a.push(str(names[i])); }
  return JsonValue.Array(a);
}

/** A quantity or data field as a number, zero when absent or malformed. */
U256 hexU256(JsonValue? v) {
  if (v is null) { return U256.zero(); }
  string? s = v!.text();
  if (s is null || s! == "0x") { return U256.zero(); }
  return U256.fromHex(s!) ?? U256.zero();
}

u8[] hexBytes(JsonValue? v) {
  if (v is null) { return u8[].filled(0, 0); }
  return hexToBytes(v!.text() ?? "") ?? u8[].filled(0, 0);
}

/** A transaction's bytes as the block body's item: a legacy one is its RLP list, a typed one opaque bytes. */
Item? txItem(u8[] raw) {
  if (raw.len() == 0) { return null; }
  if ((raw[0] as i32) >= 0xc0) {
    Decoded d = decode(raw);
    return d.ok ? d.item : null;
  }
  return Item.Bytes(raw);
}

Withdrawal[] withdrawalsFrom(JsonValue? v) {
  JsonArray a = v?.array() ?? JsonArray.create();
  Withdrawal[] out = Withdrawal[].filled(a.len(), Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero()));
  for (i32 i = 0; i < a.len(); i++) {
    JsonValue w = a.get(i);
    out[i] = Withdrawal(hexU256(w.member("index")), hexU256(w.member("validatorIndex")), hexU256(w.member("address")),
                        hexU256(w.member("amount")));
  }
  return out;
}

Header headerFrom(JsonValue p) {
  u8[] bloom = hexBytes(p.member("logsBloom"));
  return Header(hexU256(p.member("parentHash")), U256.fromHex(EMPTY_OMMERS)!, hexU256(p.member("feeRecipient")),
                hexU256(p.member("stateRoot")), U256.zero(), hexU256(p.member("receiptsRoot")),
                bloom.len() == 256 ? bloom : u8[].filled(256, 0), U256.zero(), hexU256(p.member("blockNumber")),
                hexU256(p.member("gasLimit")), hexU256(p.member("gasUsed")), hexU256(p.member("timestamp")),
                hexBytes(p.member("extraData")), hexU256(p.member("prevRandao")), u8[].filled(8, 0),
                hexU256(p.member("baseFeePerGas")), U256.zero(), hexU256(p.member("blobGasUsed")),
                hexU256(p.member("excessBlobGas")), U256.zero(), U256.zero(), U256.zero());
}


/** 32 bytes as 0x and 64 digits, leading zeros kept: a hash, not a quantity. */
string hex32(U256 v) { return bytesToHex(v.toBytes()); }

/** A payload id: eight bytes, written in full. */
string hex8(U256 v) {
  u8[] b = v.toBytes();
  u8[] out = u8[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) { out[i] = b[24 + i]; }
  return bytesToHex(out);
}

/** Param `i`, or JSON null when there are fewer. */
JsonValue? arg(JsonArray ps, i32 i) { return i < ps.len() ? ps.get(i) : null; }
