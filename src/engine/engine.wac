// The Engine API: how a consensus client drives an execution client. It hands over blocks as execution
// payloads (`engine_newPayloadV*`) and says which one is the head (`engine_forkchoiceUpdatedV*`), and
// this answers whether each payload is VALID, INVALID, or cannot be judged yet because its parent is
// unknown (SYNCING).
//
// This layer takes a method name and JSON params and gives back a JSON result or a JSON-RPC error. It
// knows nothing of HTTP or of the JWT that authenticates a caller — `server.wac` wraps it in those — so
// execution-spec-tests' engine fixtures can call it directly.
//
// ## From payload to block
//
// A payload is a block with its header flattened into fields and its transactions as opaque bytes. Two
// header fields are not sent at all and are derived: the transactions root and the withdrawals root, and
// from Prague the requests hash, from the execution requests sent beside the payload. The block hash the
// consensus client sends must equal the hash of the header rebuilt that way, which is what makes the
// payload's own fields binding.

import { Map, Vec } from "core";
import { crypto.keccak256, crypto.sha256 } from "wac";
import { json.JsonValue, json.JsonObject, json.JsonArray } from "wac";
import { rlp.Item, rlp.encode, rlp.decode, rlp.Decoded, rlp.bytesOf, rlp.itemsOf, rlp.isList } from "wac";
import { U256 } from "../u256.wac";
import { hexToBytes, bytesToHex } from "../hex.wac";
import { World, ChangeSet, hashU256, eqU256 } from "../state/world.wac";
import { u256Bytes } from "../state/root.wac";
import { trieRoot } from "../trie/trie.wac";
import { addressBytes, Evm, BlockEnv, TxEnv, Message, processMessage } from "../evm/evm.wac";
import { Outcome } from "../evm/interp.wac";
import { OpTable } from "../evm/table.wac";
import { blobGasPrice } from "../tx/process.wac";
import { Spec, ChainConfig } from "../evm/spec.wac";
import { Header, Block, Withdrawal, Receipt, Body, executeBlock, applyBlock, encodeBlock, decodeBlock, BlockDecode, blockTimestamp, headerItem, nextBaseFee, nextExcessBlobGas, EMPTY_OMMERS, requestsHashOf,
         indexedRoot } from "../chain/block.wac";
import { decodeTransaction, DecodedTx } from "../tx/decode.wac";
import { Attributes, Built, buildBlock } from "../chain/build.wac";
import { Sidecar, Unwrapped, unwrap, sidecarsFit, CELLS_PER_BLOB } from "./blobs.wac";
import { blockJson, txJson, receiptJson, logJson, firstLogIndex } from "./eth.wac";
import { Log } from "../state/world.wac";
import { Transaction, AccessEntry, Authorization, processTransaction, Processed, intrinsicGas } from "../tx/process.wac";

/**
 * A block this client has executed, and what executing it changed: enough to move the one world there
 * from its parent and back. Null for the genesis, and for blocks at or below the finalized one, which no
 * fork choice can leave and so which the world never moves across again.
 */
struct Node {
  Header header;
  ChangeSet? changes;
}

/**
 * What the JSON-RPC methods report about a block: its transactions, withdrawals and receipts, and its
 * size. Kept for every canonical block, unlike its change set, and for unfinalized forks until finality
 * rules them out.
 */
struct Archived {
  Header header;
  Item[] txs;
  Withdrawal[] withdrawals;
  Receipt[] receipts;
  i32 size;
}

/** A block waiting for its parent, and the fork it runs under. */
struct Orphan {
  Spec spec;
  Block block;
}

/** Where a canonical transaction is. */
struct TxAt {
  U256 block;
  i32 index;
}

/** The log's two kinds of record, each `rlp([kind, ...])`: a block's RLP, and a fork choice's three hashes. */
static u8 RECORD_BLOCK = 1;
static u8 RECORD_CHOICE = 2;

/** What replaying a log came to: how many bytes of it were whole records, and how many blocks. */
export struct Replayed {
  i32 good;
  i32 blocks;
  string error;
}

/** A JSON-RPC answer: a result, or an error with its code. */
export struct Answer {
  JsonValue? result;
  i32 code;
  string message;

  Answer ok(JsonValue v) { return Answer(v, 0, ""); }
  Answer error(i32 code, string message) { return Answer(null, code, message); }
}

export struct Engine {
  /** The chain's forks: each payload runs under the one its timestamp has reached. */
  ChainConfig config;
  U256 chainId;
  Map<U256, Node> blocks;
  /** Block number to hash along the canonical chain, for BLOCKHASH. */
  Map<U256, U256> canonical;
  U256 head;
  U256 safe;
  U256 finalized;
  /** Transactions sent with eth_sendRawTransaction, waiting for a block, in arrival order. */
  Vec<Item> mempool;
  /** Blocks built for a payload id, waiting for engine_getPayload. */
  Map<U256, Built> payloads;
  u64 nextPayloadId;
  /**
   * The state, at the block `at`. There is one, moved from block to block across their change sets, so
   * what the engine holds grows with what blocks change rather than with the state times the blocks.
   */
  World world;
  U256 at;
  /** The blobs of the blob transactions in the mempool, by versioned hash. */
  Map<U256, Sidecar> sidecars;
  /**
   * Whether a blob transaction may arrive without its blobs. Never for a node: a block it built from one
   * would have blobs nobody can publish. The fixtures' transactions are in block form, so their runners
   * set it, and their payloads' blobs bundles are then short of those blobs.
   */
  bool sidecarsOptional;
  Map<U256, Archived> archive;
  /** Transaction hash to where it is, for the canonical chain; a stale entry is checked away on lookup. */
  Map<U256, TxAt> txIndex;
  /**
   * A block the consensus client has named that this client does not have, to be fetched from peers; null
   * when there is none.
   */
  U256? syncTarget;
  /** Blocks sent with newPayload whose parent is still missing, by hash, to import once it arrives. */
  Map<U256, Orphan> orphans;
  /** Transactions the mempool took that peers have not been told of yet, in their block form. */
  Vec<u8[]> announce;
  /** What the blocks this engine builds say in their header's extra data. */
  u8[] extraData;
  /** The finalized block `forgetBelowFinalized` last pruned for. */
  U256 forgottenAt;
  /**
   * What this engine has done that a restart must redo, as records for the node to append to its log
   * before it answers: each block imported, and each fork choice. `replay` reads them back.
   */
  Vec<u8[]> records;

  /** An engine whose chain starts at `genesis`, with `world` its state. */
  Engine create(ChainConfig config, Header genesis, World world) {
    Engine e = Engine(config, config.chainId, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256), genesis.hash, genesis.hash,
                      genesis.hash, Vec.create(), Map.create(hashU256, eqU256), 1, world, genesis.hash, Map.create(hashU256, eqU256), false, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256),
                      null, Map.create(hashU256, eqU256), Vec.create(), "wacuum".toBytes(), U256.zero(), Vec.create());
    e.blocks.set(genesis.hash, Node(genesis, null));
    e.archive.set(genesis.hash, Archived(genesis, Item[].filled(0, Item.Bytes(u8[].filled(0, 0))),
                                         Withdrawal[].filled(0, Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero())),
                                         Vec<Receipt>.create().toArray(), 0));
    e.canonical.set(genesis.number, genesis.hash);
    return e;
  }

  Answer call(this, string method, JsonValue params) {
    JsonArray? ps = params.array();
    if (ps is null) { return Answer.error(-32602, "params must be an array"); }
    if (method == "engine_newPayloadV1") { return this.newPayload(1, ps!); }
    if (method == "engine_newPayloadV2") { return this.newPayload(2, ps!); }
    if (method == "engine_newPayloadV3") { return this.newPayload(3, ps!); }
    if (method == "engine_newPayloadV4") { return this.newPayload(4, ps!); }
    if (method == "engine_forkchoiceUpdatedV1" || method == "engine_forkchoiceUpdatedV2" ||
        method == "engine_forkchoiceUpdatedV3") {
      return this.forkchoiceUpdated(ps!);
    }
    if (method == "engine_getPayloadV3") { return this.getPayload(3, ps!); }
    if (method == "engine_getPayloadV4") { return this.getPayload(4, ps!); }
    if (method == "engine_getPayloadV5") { return this.getPayload(5, ps!); }
    if (method == "engine_getBlobsV1") { return this.getBlobs(1, ps!); }
    if (method == "engine_getBlobsV2") { return this.getBlobs(2, ps!); }
    if (method == "eth_sendRawTransaction") { return this.sendRawTransaction(ps!); }
    if (method == "eth_getBalance" || method == "eth_getTransactionCount" || method == "eth_getCode") {
      World? w = this.stateAt(arg(ps!, 1));
      if (w is null) { return unavailable(); }
      U256 a = hexU256(arg(ps!, 0));
      if (method == "eth_getBalance") { return Answer.ok(str(w!.balance(a).toHex())); }
      if (method == "eth_getCode") { return Answer.ok(str(bytesToHex(w!.code(a)))); }
      u64 nonce = w!.nonce(a);
      // "pending" counts the sender's transactions waiting in the mempool, as a wallet choosing its next
      // nonce needs.
      if ((arg(ps!, 1)?.text() ?? "") == "pending") { nonce = this.pendingNonce(a, nonce); }
      return Answer.ok(str(U256.ofU64(nonce).toHex()));
    }
    if (method == "eth_getStorageAt") {
      World? w = this.stateAt(arg(ps!, 2));
      if (w is null) { return unavailable(); }
      return Answer.ok(str(hex32(w!.storage(hexU256(arg(ps!, 0)), hexU256(arg(ps!, 1))))));
    }
    if (method == "eth_call") { return this.ethCall(ps!); }
    if (method == "eth_estimateGas") { return this.estimateGas(ps!); }
    if (method == "eth_getBlockByNumber" || method == "eth_getBlockByHash") {
      U256? hash = method == "eth_getBlockByHash" ? hexU256(arg(ps!, 0)) : this.blockFor(arg(ps!, 0));
      Archived? a = hash is null ? null : this.archive.get(hash!);
      if (a is null) { return Answer.ok(JsonValue.Null); }
      bool full = arg(ps!, 1)?.boolean() ?? false;
      return Answer.ok(blockJson(a!.header, a!.txs, a!.withdrawals, a!.receipts, a!.size, full, this.chainId));
    }
    if (method == "eth_getBlockTransactionCountByNumber" || method == "eth_getBlockTransactionCountByHash") {
      U256? hash = method == "eth_getBlockTransactionCountByHash" ? hexU256(arg(ps!, 0)) : this.blockFor(arg(ps!, 0));
      Archived? a = hash is null ? null : this.archive.get(hash!);
      return Answer.ok(a is null ? JsonValue.Null : str(U256.ofI32(a!.txs.len()).toHex()));
    }
    if (method == "eth_getTransactionByHash" || method == "eth_getTransactionReceipt") {
      Archived? a = null;
      i32 i = this.txWhere(hexU256(arg(ps!, 0)));
      if (i >= 0) { a = this.archive.get(this.txIndex.get(hexU256(arg(ps!, 0)))!.block); }
      if (a is null) {
        if (method == "eth_getTransactionByHash") { return this.pendingTx(hexU256(arg(ps!, 0))); }
        return Answer.ok(JsonValue.Null);
      }
      if (method == "eth_getTransactionByHash") { return Answer.ok(txJson(a!.txs[i], this.chainId, a!.header, i)); }
      return Answer.ok(receiptJson(a!.receipts[i], a!.header, a!.receipts, i));
    }
    if (method == "eth_getBlockReceipts") {
      U256? hash = this.blockFor(arg(ps!, 0));
      Archived? a = hash is null ? null : this.archive.get(hash!);
      if (a is null) { return Answer.ok(JsonValue.Null); }
      JsonArray out = JsonArray.create();
      for (i32 i = 0; i < a!.receipts.len(); i++) { out.push(receiptJson(a!.receipts[i], a!.header, a!.receipts, i)); }
      return Answer.ok(JsonValue.Array(out));
    }
    if (method == "eth_getLogs") { return this.getLogs(ps!); }
    if (method == "eth_gasPrice") {
      return Answer.ok(str(nextBaseFee(this.blocks.get(this.head)!.header).add(U256.ofU64(SUGGESTED_TIP)).toHex()));
    }
    if (method == "eth_maxPriorityFeePerGas") { return Answer.ok(str(U256.ofU64(SUGGESTED_TIP).toHex())); }
    if (method == "eth_blobBaseFee") {
      Header h = this.blocks.get(this.head)!.header;
      Spec spec = this.config.specAt(h.timestamp);
      return Answer.ok(str(blobGasPrice(spec, nextExcessBlobGas(spec, h)).toHex()));
    }
    if (method == "eth_feeHistory") { return this.feeHistory(ps!); }
    if (method == "eth_syncing") { return Answer.ok(JsonValue.Bool(false)); }
    if (method == "eth_accounts") { return Answer.ok(JsonValue.Array(JsonArray.create())); }
    if (method == "net_version") { return Answer.ok(str(this.chainId.toDecimal())); }
    if (method == "net_listening") { return Answer.ok(JsonValue.Bool(true)); }
    if (method == "net_peerCount") { return Answer.ok(str("0x0")); }
    if (method == "web3_clientVersion") { return Answer.ok(str("wacuum/v0.1.0")); }
    if (method == "web3_sha3") { return Answer.ok(str(bytesToHex(keccak256(hexBytes(arg(ps!, 0)))))); }
    if (method == "engine_exchangeCapabilities") { return Answer.ok(capabilities()); }
    if (method == "eth_chainId") { return Answer.ok(str(this.chainId.toHex())); }
    if (method == "eth_blockNumber") { return Answer.ok(str(this.blocks.get(this.head)!.header.number.toHex())); }
    return Answer.error(-32601, "method not found: " + method);
  }

  // ── engine_newPayload ──

  Answer newPayload(this, i32 version, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no payload"); }
    JsonValue p = ps.get(0);
    if (p.object() is null) { return Answer.error(-32602, "the payload is not an object"); }
    bool hasWithdrawals = p.member("withdrawals") is not null && !p.member("withdrawals")!.isNull();
    bool hasBlobFields = p.member("blobGasUsed") is not null || p.member("excessBlobGas") is not null;
    // Each version names exactly the fields its fork has; a payload that disagrees is a malformed call.
    if (version == 2 && hasBlobFields) { return Answer.error(-32602, "blob fields before V3"); }
    if (version >= 3) {
      if (!hasWithdrawals || p.member("blobGasUsed") is null || p.member("excessBlobGas") is null) {
        return Answer.error(-32602, "a V\{version} payload needs withdrawals, blobGasUsed and excessBlobGas");
      }
      if (ps.len() < 3 || ps.get(1).array() is null || ps.get(2).text() is null) {
        return Answer.error(-32602, "V\{version} needs expected blob hashes and a parent beacon root");
      }
    }
    u8[][] requests = u8[][].defaulted(0);
    if (version >= 4) {
      if (ps.len() < 4 || ps.get(3).array() is null) { return Answer.error(-32602, "V4 needs execution requests"); }
      JsonArray rs = ps.get(3).array()!;
      requests = u8[][].defaulted(rs.len());
      i32 lastType = -1;
      for (i32 i = 0; i < rs.len(); i++) {
        u8[]? r = hexToBytes(rs.get(i).text() ?? "x");
        // Each request list is its type byte and then its data: types strictly ascending, none empty.
        if (r is null || r!.len() < 2 || (r![0] as i32) <= lastType) { return Answer.error(-32602, "malformed execution requests"); }
        lastType = r![0] as i32;
        requests[i] = r!;
      }
    }

    Header h = headerFrom(p);
    U256 claimed = hexU256(p.member("blockHash"));
    Vec<Item> txs = Vec.create();
    JsonArray rawTxs = p.member("transactions")?.array() ?? JsonArray.create();
    Vec<U256> blobHashes = Vec.create();
    u8[][] txBytes = u8[][].defaulted(rawTxs.len());
    for (i32 i = 0; i < rawTxs.len(); i++) {
      u8[] raw = hexToBytes(rawTxs.get(i).text() ?? "x") ?? u8[].filled(0, 0);
      txBytes[i] = raw;
      Item? it = txItem(raw);
      if (it is null) { return this.invalid(h, "transaction \{i} does not decode"); }
      txs.push(it!);
      DecodedTx d = decodeTransaction(it!, this.chainId);
      for (i32 k = 0; k < d.tx.blobHashes.len(); k++) { blobHashes.push(d.tx.blobHashes[k]); }
    }
    Withdrawal[] withdrawals = withdrawalsFrom(p.member("withdrawals"));

    // The header the payload describes, with the fields the payload does not carry derived.
    h.txRoot = U256.fromBytes(indexedRoot(txBytes), 0, 32);
    u8[][] wsRaw = u8[][].defaulted(withdrawals.len());
    for (i32 i = 0; i < withdrawals.len(); i++) {
      Withdrawal wd = withdrawals[i];
      Item[] fields = [Item.Bytes(u256Bytes(wd.index)), Item.Bytes(u256Bytes(wd.validator)), Item.Bytes(addressBytes(wd.address)),
                       Item.Bytes(u256Bytes(wd.amount))];
      wsRaw[i] = encode(Item.List(fields));
    }
    h.withdrawalsRoot = U256.fromBytes(indexedRoot(wsRaw), 0, 32);
    if (version >= 3) { h.parentBeaconBlockRoot = hexU256(ps.get(2)); }
    if (version >= 4) {
      // The requests hash is over each list's data with its type byte; the payload already has them so.
      u8[][] byType = u8[][].defaulted(3);
      for (i32 t = 0; t < 3; t++) { byType[t] = u8[].filled(0, 0); }
      for (i32 i = 0; i < requests.len(); i++) {
        i32 t = requests[i][0] as i32;
        if (t < 3) {
          u8[] data = u8[].filled(requests[i].len() - 1, 0);
          for (i32 k = 0; k < data.len(); k++) { data[k] = requests[i][k + 1]; }
          byType[t] = data;
        }
      }
      h.requestsHash = requestsHashOf(byType);
    }
    Spec spec = this.config.specAt(h.timestamp);
    h.hash = U256.fromBytes(keccak256(encode(headerItem(spec, h))), 0, 32);
    if (!h.hash.eq(claimed)) { return this.invalidNoAncestor("block hash \{claimed.toHex()} is not the payload's, \{h.hash.toHex()}"); }

    // EIP-4844: the blob hashes the consensus layer expects must be exactly the transactions', in order.
    if (version >= 3) {
      JsonArray expected = ps.get(1).array()!;
      U256[] got = blobHashes.toArray();
      bool same = expected.len() == got.len();
      for (i32 i = 0; same && i < got.len(); i++) { same = hexU256(expected.get(i)).eq(got[i]); }
      if (!same) { return this.invalidNoAncestor("the versioned hashes do not match the transactions'"); }
    }

    return this.importBlock(spec, Block(h, txs.toArray(), false, withdrawals));
  }

  /** Execute a block on its parent's state and keep it: VALID, INVALID, or SYNCING without the parent. */
  Answer importBlock(this, Spec spec, Block b) {
    Header h = b.header;
    if (this.blocks.has(h.hash)) { return status("VALID", h.hash.toHex(), ""); }
    Node? parent = this.blocks.get(h.parentHash);
    if (parent is null) {
      // A block on a chain this client has not got: it waits, and the chain it needs is fetched from peers.
      this.orphans.set(h.hash, Orphan(spec, b));
      this.syncTarget = h.parentHash;
      return status("SYNCING", "", "");
    }
    // A parent this client has but cannot reach the state of is on a fork that finality has ruled out.
    if (!this.moveTo(h.parentHash)) { return status("SYNCING", "", ""); }
    this.world.record();
    Body body = executeBlock(spec, this.world, b, parent!.header, this.chainId, this.ancestorHashes(parent!.header));
    ChangeSet cs = this.world.seal();
    if (body.error != "") {
      this.world.undo(cs);
      return this.invalid(h, body.error);
    }
    this.blocks.set(h.hash, Node(h, cs));
    this.at = h.hash;
    u8[] rlp = encodeBlock(spec, b);
    this.archive.set(h.hash, Archived(h, b.txs, b.withdrawals, body.receipts, rlp.len()));
    this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(rlp)])));
    return status("VALID", h.hash.toHex(), "");
  }

  /** INVALID, naming the parent as the latest valid ancestor when this client has it. */
  Answer invalid(this, Header h, string why) {
    return status("INVALID", this.blocks.has(h.parentHash) ? h.parentHash.toHex() : "", why);
  }

  Answer invalidNoAncestor(this, string why) { return status("INVALID", "", why); }

  /**
   * Move the world to the state after block `target`: back across change sets to the common ancestor of
   * where it is and where it is going, then forward. False, with the world unmoved, when the way crosses a
   * block whose change set has been dropped — a fork below the finalized block.
   */
  bool moveTo(this, U256 target) {
    if (this.at.eq(target)) { return true; }
    Vec<ChangeSet> back = Vec.create();
    Vec<ChangeSet> forward = Vec.create();
    Header a = this.blocks.get(this.at)!.header;
    Node? tn = this.blocks.get(target);
    if (tn is null) { return false; }
    Header b = tn!.header;
    // Step back whichever side is higher (the departure side on a tie) until the two meet.
    while (!a.hash.eq(b.hash)) {
      bool fromHere = !b.number.gt(a.number);
      Header cur = fromHere ? a : b;
      Node n = this.blocks.get(cur.hash)!;
      Node? p = this.blocks.get(cur.parentHash);
      if (n.changes is null || p is null) { return false; }
      if (fromHere) {
        back.push(n.changes!);
        a = p!.header;
      } else {
        forward.push(n.changes!);
        b = p!.header;
      }
    }
    for (i32 i = 0; i < back.len(); i++) { this.world.undo(back.get(i)); }
    for (i32 i = forward.len() - 1; i >= 0; i--) { this.world.redo(forward.get(i)); }
    this.at = target;
    return true;
  }

  /** Number to hash for the chain ending at `tip`, back as far as BLOCKHASH can see. */
  Map<U256, U256> ancestorHashes(this, Header tip) {
    Map<U256, U256> m = Map.create(hashU256, eqU256);
    Header cur = tip;
    for (i32 i = 0; i < 256; i++) {
      m.set(cur.number, cur.hash);
      Node? p = this.blocks.get(cur.parentHash);
      if (p is null) { break; }
      cur = p!.header;
    }
    return m;
  }

  // ── engine_forkchoiceUpdated ──

  Answer forkchoiceUpdated(this, JsonArray ps) {
    if (ps.len() < 1 || ps.get(0).object() is null) { return Answer.error(-32602, "no forkchoice state"); }
    JsonValue fc = ps.get(0);
    U256 head = hexU256(fc.member("headBlockHash"));
    if (!this.choose(head, hexU256(fc.member("safeBlockHash")), hexU256(fc.member("finalizedBlockHash")))) {
      this.syncTarget = head;
      return Answer.ok(forkchoiceResult(status("SYNCING", "", "").result!));
    }
    JsonValue payloadId = JsonValue.Null;
    if (ps.len() >= 2 && ps.get(1).object() is not null) {
      JsonValue at = ps.get(1);
      Header parent = this.blocks.get(head)!.header;
      if (!hexU256(at.member("timestamp")).gt(parent.timestamp)) { return Answer.error(-38003, "invalid payload attributes: timestamp"); }
      Attributes attrs = Attributes(hexU256(at.member("timestamp")), hexU256(at.member("prevRandao")),
                                    hexU256(at.member("suggestedFeeRecipient")), withdrawalsFrom(at.member("withdrawals")),
                                    hexU256(at.member("parentBeaconBlockRoot")));
      Spec spec = this.config.specAt(attrs.timestamp);
      // Built on the head's state and then taken back off it: the block exists only as a payload until the
      // consensus client sends it back with newPayload.
      this.moveTo(head);
      this.world.record();
      Built built = buildBlock(spec, this.world, parent, attrs, this.candidates(spec), this.chainId,
                               this.ancestorHashes(parent), this.extraData);
      this.world.undo(this.world.seal());
      // A body that fails is a chain this client cannot extend at all — a system contract missing or
      // broken — and not something to hand out as an empty block.
      if (built.body.error != "") { return Answer.error(-32603, "cannot build on this head: " + built.body.error); }
      U256 id = U256.ofU64(this.nextPayloadId);
      this.nextPayloadId++;
      this.payloads.set(id, built);
      payloadId = str(hex8(id));
    }
    JsonObject o = JsonObject.create();
    o.push("payloadStatus".toBytes(), status("VALID", head.toHex(), "").result!);
    o.push("payloadId".toBytes(), payloadId);
    return Answer.ok(JsonValue.Object(o));
  }

  /** The bookkeeping of a fork choice: false, changing nothing, when the head is not a block this has. */
  bool choose(this, U256 head, U256 safe, U256 finalized) {
    if (!this.blocks.has(head)) { return false; }
    if (!(head.eq(this.head) && safe.eq(this.safe) && finalized.eq(this.finalized))) {
      this.records.push(encode(Item.List([Item.Bytes([RECORD_CHOICE]), Item.Bytes(head.toBytes()), Item.Bytes(safe.toBytes()),
                                          Item.Bytes(finalized.toBytes())])));
    }
    this.head = head;
    this.safe = safe;
    this.finalized = finalized;
    // Walk back from the new head, rewriting the canonical number-to-hash map until it agrees.
    Header cur = this.blocks.get(head)!.header;
    while (true) {
      U256? known = this.canonical.get(cur.number);
      if (known is not null && known!.eq(cur.hash)) { break; }
      this.canonical.set(cur.number, cur.hash);
      Archived? arc = this.archive.get(cur.hash);
      if (arc is not null) {
        for (i32 i = 0; i < arc!.receipts.len(); i++) { this.txIndex.set(arc!.receipts[i].txHash, TxAt(cur.hash, i)); }
      }
      Node? p = this.blocks.get(cur.parentHash);
      if (p is null) { break; }
      cur = p!.header;
    }
    this.prune();
    this.forgetBelowFinalized();
    return true;
  }

  /**
   * Nothing at or below the finalized block can be reorganised away, so the change sets of the canonical
   * blocks there are dropped, and so are the blocks of forks that branch off below it. Canonical blocks more
   * than 256 below it go too: BLOCKHASH reaches 256 back from a head that is never below the finalized
   * block, and nothing else looks further. This runs when finality moves, so the blocks held stay about the
   * unfinalized ones and 256 more.
   */
  void forgetBelowFinalized(this) {
    if (this.finalized.eq(this.forgottenAt)) { return; }
    Node? f = this.blocks.get(this.finalized);
    if (f is null) { return; }
    this.forgottenAt = this.finalized;
    this.moveTo(this.head);
    U256 fin = f!.header.number;
    U256[] hashes = this.blocks.keys();
    for (i32 i = 0; i < hashes.len(); i++) {
      Node n = this.blocks.get(hashes[i])!;
      if (n.header.number.gt(fin)) { continue; }
      U256? c = this.canonical.get(n.header.number);
      bool canonical = c is not null && c!.eq(hashes[i]);
      if (canonical && n.header.number.add(U256.ofU64(256)).gt(fin)) {
        n.changes = null;
      } else if (!hashes[i].eq(this.at)) {
        this.blocks.remove(hashes[i]);
        if (!canonical) { this.archive.remove(hashes[i]); }
      }
    }
  }

  /** Drop what the head's state has made stale: a transaction whose nonce its sender has already used. */
  void prune(this) {
    World w = this.headState();
    Vec<Item> keep = Vec.create();
    Item[] all = this.mempool.toArray();
    for (i32 i = 0; i < all.len(); i++) {
      DecodedTx d = decodeTransaction(all[i], this.chainId);
      if (d.error != "") { continue; }
      if (d.tx.nonce.lt(U256.ofU64(w.nonce(d.tx.sender)))) { continue; }
      keep.push(all[i]);
    }
    this.mempool = keep;
    // A sidecar goes with the last transaction that names its blob.
    Map<U256, Sidecar> blobs = Map.create(hashU256, eqU256);
    for (i32 i = 0; i < keep.len(); i++) {
      U256[] hashes = decodeTransaction(keep.get(i), this.chainId).tx.blobHashes;
      for (i32 k = 0; k < hashes.len(); k++) {
        Sidecar? sc = this.sidecars.get(hashes[k]);
        if (sc is not null) { blobs.set(hashes[k], sc!); }
      }
    }
    this.sidecars = blobs;
  }

  /**
   * The mempool as a block under `spec` may take it: a blob transaction only with every blob's sidecar,
   * in the form the fork's blobs bundle carries — a transaction sent with blob proofs before Osaka cannot
   * go into an Osaka block, whose bundle needs cell proofs.
   */
  Item[] candidates(this, Spec spec) {
    if (this.sidecarsOptional) { return this.mempool.toArray(); }
    Vec<Item> out = Vec.create();
    for (i32 i = 0; i < this.mempool.len(); i++) {
      U256[] hashes = decodeTransaction(this.mempool.get(i), this.chainId).tx.blobHashes;
      bool ready = true;
      for (i32 k = 0; k < hashes.len(); k++) {
        Sidecar? sc = this.sidecars.get(hashes[k]);
        if (sc is null || sc!.proofs.len() != (spec.isOsaka ? CELLS_PER_BLOB : 1)) { ready = false; }
      }
      if (ready) { out.push(this.mempool.get(i)); }
    }
    return out.toArray();
  }

  // ── eth_sendRawTransaction ──

  Answer sendRawTransaction(this, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no transaction"); }
    u8[]? raw = hexToBytes(ps.get(0).text() ?? "x");
    if (raw is null) { return Answer.error(-32602, "the transaction is not hex"); }
    return this.acceptTransaction(raw!);
  }

  /**
   * A transaction into the mempool, from a user or a peer: `raw` is its network form (a blob transaction
   * with its sidecar). Answers its hash, or why it was refused.
   */
  Answer acceptTransaction(this, u8[] raw) {
    // The sidecar's form is the next block's fork's, taking the next block to be a slot after the head.
    Header h = this.blocks.get(this.head)!.header;
    Unwrapped u = unwrap(raw, this.config.specAt(h.timestamp.add(U256.ofU64(12))).isOsaka);
    if (u.error != "") { return Answer.error(-32000, u.error); }
    Item? it = txItem(u.canonical);
    if (it is null) { return Answer.error(-32602, "the transaction does not decode"); }
    DecodedTx d = decodeTransaction(it!, this.chainId);
    if (d.error != "") { return Answer.error(-32000, d.error); }
    if (d.tx.nonce.lt(U256.ofU64(this.headState().nonce(d.tx.sender)))) { return Answer.error(-32000, "nonce too low"); }
    if (d.tx.txType == 3) {
      if (!u.wrapped && !this.sidecarsOptional) { return Answer.error(-32000, "a blob transaction without its blobs"); }
      if (u.wrapped && !sidecarsFit(u.sidecars, d.tx.blobHashes)) {
        return Answer.error(-32000, "the sidecar's commitments are not the transaction's blobs");
      }
      for (i32 k = 0; k < u.sidecars.len(); k++) { this.sidecars.set(d.tx.blobHashes[k], u.sidecars[k]); }
    }
    U256 hash = U256.fromBytes(keccak256(d.raw), 0, 32);
    for (i32 i = 0; i < this.mempool.len(); i++) {
      if (U256.fromBytes(keccak256(rawOf(this.mempool.get(i))), 0, 32).eq(hash)) { return Answer.ok(str(hex32(hash))); }
    }
    this.mempool.push(it!);
    // Peers hear of it — all but blob transactions, whose network form this does not rebuild yet.
    if (d.tx.txType != 3) { this.announce.push(d.raw); }
    return Answer.ok(str(bytesToHex(keccak256(d.raw))));
  }

  // ── engine_getPayload ──

  Answer getPayload(this, i32 version, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no payload id"); }
    Built? b = this.payloads.get(hexU256(ps.get(0)));
    if (b is null) { return Answer.error(-38001, "unknown payload"); }
    Built built = b!;
    Header h = built.block.header;
    Spec spec = this.config.specAt(h.timestamp);
    i32 wants = spec.isOsaka ? 5 : spec.isPrague ? 4 : 3;
    if (version != wants) { return Answer.error(-38005, "unsupported fork: this payload wants engine_getPayloadV\{wants}"); }
    JsonObject p = JsonObject.create();
    p.push("parentHash".toBytes(), str(hex32(h.parentHash)));
    p.push("feeRecipient".toBytes(), str(bytesToHex(addressBytes(h.coinbase))));
    p.push("stateRoot".toBytes(), str(hex32(h.stateRoot)));
    p.push("receiptsRoot".toBytes(), str(hex32(h.receiptsRoot)));
    p.push("logsBloom".toBytes(), str(bytesToHex(h.bloom)));
    p.push("prevRandao".toBytes(), str(hex32(h.prevRandao)));
    p.push("blockNumber".toBytes(), str(h.number.toHex()));
    p.push("gasLimit".toBytes(), str(h.gasLimit.toHex()));
    p.push("gasUsed".toBytes(), str(h.gasUsed.toHex()));
    p.push("timestamp".toBytes(), str(h.timestamp.toHex()));
    p.push("extraData".toBytes(), str(bytesToHex(h.extraData)));
    p.push("baseFeePerGas".toBytes(), str(h.baseFee.toHex()));
    p.push("blockHash".toBytes(), str(hex32(h.hash)));
    JsonArray txs = JsonArray.create();
    for (i32 i = 0; i < built.block.txs.len(); i++) {
      DecodedTx d = decodeTransaction(built.block.txs[i], this.chainId);
      txs.push(str(bytesToHex(d.raw)));
    }
    p.push("transactions".toBytes(), JsonValue.Array(txs));
    JsonArray ws = JsonArray.create();
    for (i32 i = 0; i < built.block.withdrawals.len(); i++) {
      Withdrawal wd = built.block.withdrawals[i];
      JsonObject o = JsonObject.create();
      o.push("index".toBytes(), str(wd.index.toHex()));
      o.push("validatorIndex".toBytes(), str(wd.validator.toHex()));
      o.push("address".toBytes(), str(bytesToHex(addressBytes(wd.address))));
      o.push("amount".toBytes(), str(wd.amount.toHex()));
      ws.push(JsonValue.Object(o));
    }
    p.push("withdrawals".toBytes(), JsonValue.Array(ws));
    p.push("blobGasUsed".toBytes(), str(h.blobGasUsed.toHex()));
    p.push("excessBlobGas".toBytes(), str(h.excessBlobGas.toHex()));

    // Every blob the block's transactions name, in order, with its commitment and its proof or proofs.
    JsonArray commitments = JsonArray.create();
    JsonArray proofs = JsonArray.create();
    JsonArray blobs = JsonArray.create();
    for (i32 i = 0; i < built.block.txs.len(); i++) {
      U256[] hashes = decodeTransaction(built.block.txs[i], this.chainId).tx.blobHashes;
      for (i32 k = 0; k < hashes.len(); k++) {
        Sidecar? sc = this.sidecars.get(hashes[k]);
        if (sc is null) { continue; }
        commitments.push(str(bytesToHex(sc!.commitment)));
        blobs.push(str(bytesToHex(sc!.blob)));
        for (i32 j = 0; j < sc!.proofs.len(); j++) { proofs.push(str(bytesToHex(sc!.proofs[j]))); }
      }
    }
    JsonObject bundle = JsonObject.create();
    bundle.push("commitments".toBytes(), JsonValue.Array(commitments));
    bundle.push("proofs".toBytes(), JsonValue.Array(proofs));
    bundle.push("blobs".toBytes(), JsonValue.Array(blobs));
    JsonObject out = JsonObject.create();
    out.push("executionPayload".toBytes(), JsonValue.Object(p));
    out.push("blockValue".toBytes(), str(built.body.fees.toHex()));
    out.push("blobsBundle".toBytes(), JsonValue.Object(bundle));
    out.push("shouldOverrideBuilder".toBytes(), JsonValue.Bool(false));
    if (version >= 4) {
      // Each non-empty request list, its type byte first: the form newPayloadV4 takes back.
      JsonArray rs = JsonArray.create();
      for (i32 t = 0; t < built.body.requests.len(); t++) {
        u8[] data = built.body.requests[t];
        if (data.len() == 0) { continue; }
        u8[] typed = u8[].filled(data.len() + 1, 0);
        typed[0] = t as! u8;
        for (i32 k = 0; k < data.len(); k++) { typed[k + 1] = data[k]; }
        rs.push(str(bytesToHex(typed)));
      }
      out.push("executionRequests".toBytes(), JsonValue.Array(rs));
    }
    return Answer.ok(JsonValue.Object(out));
  }

  /**
   * eth_call: a message run on a copy of the head's state, as if in the next block, and thrown away. Only
   * the head is answered for — a block tag naming another block is not looked at yet.
   */
  Answer ethCall(this, JsonArray ps) {
    if (ps.len() < 1 || ps.get(0).object() is null) { return Answer.error(-32602, "no call object"); }
    JsonValue c = ps.get(0);
    Header h = this.blocks.get(this.head)!.header;
    Spec spec = this.config.specAt(h.timestamp.add(U256.ofU64(12)));
    World w = this.headState();
    BlockEnv env = BlockEnv(h.coinbase, h.number.add(U256.one()), h.timestamp.add(U256.ofU64(12)), h.gasLimit,
                            h.prevRandao, nextBaseFee(h), blobGasPrice(spec, nextExcessBlobGas(spec, h)), this.chainId,
                            this.ancestorHashes(h));
    U256 from = hexU256(c.member("from"));
    U256 to = hexU256(c.member("to"));
    u8[] data = c.member("input") is not null ? hexBytes(c.member("input")) : hexBytes(c.member("data"));
    U256 gas = c.member("gas") is not null ? hexU256(c.member("gas")) : h.gasLimit;
    Evm evm = Evm(w, env, TxEnv(from, U256.zero(), U256[].filled(0, U256.zero())), spec.table, spec, null);
    w.warmAddress(from);
    w.warmAddress(to);
    Message m = Message(from, to, to, hexU256(c.member("value")), data, gas.low() as@ i64, false, 0, true, false);
    w.record();
    Outcome o = processMessage(evm, m);
    w.undo(w.seal());
    if (!o.succeeded()) { return Answer.error(3, "execution reverted: " + bytesToHex(o.output())); }
    return Answer.ok(str(bytesToHex(o.output())));
  }

  /**
   * engine_getBlobs: the mempool's blobs, for versioned hashes the consensus client has seen in a block or
   * gossip. V1 answers each hash with its blob and proof or null; V2 (Osaka) answers with each blob's cell
   * proofs, and with null for the whole call if any blob is missing.
   */
  Answer getBlobs(this, i32 version, JsonArray ps) {
    JsonArray? hashes = ps.len() > 0 ? ps.get(0).array() : null;
    if (hashes is null) { return Answer.error(-32602, "no versioned hashes"); }
    if (hashes!.len() > 128) { return Answer.error(-38004, "too large request"); }
    JsonArray out = JsonArray.create();
    for (i32 i = 0; i < hashes!.len(); i++) {
      Sidecar? sc = this.sidecars.get(hexU256(hashes!.get(i)));
      if (sc is not null && sc!.proofs.len() != (version == 2 ? CELLS_PER_BLOB : 1)) { sc = null; }
      if (sc is null) {
        if (version == 2) { return Answer.ok(JsonValue.Null); }
        out.push(JsonValue.Null);
        continue;
      }
      JsonObject o = JsonObject.create();
      o.push("blob".toBytes(), str(bytesToHex(sc!.blob)));
      if (version == 1) {
        o.push("proof".toBytes(), str(bytesToHex(sc!.proofs[0])));
      } else {
        JsonArray cells = JsonArray.create();
        for (i32 j = 0; j < sc!.proofs.len(); j++) { cells.push(str(bytesToHex(sc!.proofs[j]))); }
        o.push("proofs".toBytes(), JsonValue.Array(cells));
      }
      out.push(JsonValue.Object(o));
    }
    return Answer.ok(JsonValue.Array(out));
  }

  /**
   * Redo a log of `records`, written by an earlier run on the same genesis. A record cut short — the
   * process stopped while appending it — ends the replay there, and `good` says how much of the log to
   * keep. A record that is whole and does not apply is an error: the log is not this chain's.
   */
  Replayed replay(this, u8[] log) {
    i32 at = 0;
    i32 blocks = 0;
    while (at < log.len()) {
      i32 n = rlpLength(log, at);
      if (n < 0) { break; }
      u8[] rec = u8[].filled(n, 0);
      for (i32 i = 0; i < n; i++) { rec[i] = log[at + i]; }
      Decoded d = decode(rec);
      if (!d.ok || !isList(d.item) || itemsOf(d.item).len() < 2) { return Replayed(at, blocks, "record at byte \{at} is malformed"); }
      Item[] f = itemsOf(d.item);
      u8[] kind = bytesOf(f[0]);
      if (kind.len() == 1 && kind[0] == RECORD_BLOCK) {
        u8[] raw = bytesOf(f[1]);
        Spec spec = this.config.specAt(blockTimestamp(raw));
        BlockDecode bd = decodeBlock(spec, raw);
        if (bd.block is null) { return Replayed(at, blocks, "block at byte \{at}: \{bd.error}"); }
        Answer a = this.importBlock(spec, bd.block!);
        string st = a.result!.member("status")!.text()!;
        if (st != "VALID") { return Replayed(at, blocks, "block at byte \{at} is \{st} on replay"); }
        blocks++;
      } else if (kind.len() == 1 && kind[0] == RECORD_CHOICE && f.len() == 4) {
        U256 head = U256.fromBytes(bytesOf(f[1]), 0, 32);
        if (!this.choose(head, U256.fromBytes(bytesOf(f[2]), 0, 32), U256.fromBytes(bytesOf(f[3]), 0, 32))) {
          return Replayed(at, blocks, "fork choice at byte \{at} names a block the log has not");
        }
      } else {
        return Replayed(at, blocks, "record at byte \{at} is of no kind this knows");
      }
      at += n;
    }
    // What was replayed is already in the log.
    this.records = Vec.create();
    return Replayed(at, blocks, "");
  }

  /** The block a JSON-RPC block parameter names: a tag, a number on the canonical chain, or `{blockHash}`. */
  U256? blockFor(this, JsonValue? p) {
    if (p is null || p!.isNull()) { return this.head; }
    JsonValue? byHash = p!.member("blockHash");
    if (byHash is not null) { return this.archive.has(hexU256(byHash)) ? hexU256(byHash) : null; }
    JsonValue? byNumber = p!.member("blockNumber");
    string tag = (byNumber ?? p!).text() ?? "latest";
    if (tag == "latest" || tag == "pending") { return this.head; }
    if (tag == "safe") { return this.archive.has(this.safe) ? this.safe : null; }
    if (tag == "finalized") { return this.archive.has(this.finalized) ? this.finalized : null; }
    U256 n = tag == "earliest" ? U256.zero() : (U256.fromHex(tag) ?? U256.ofU64(0xFFFFFFFFFFFFFFFF));
    if (n.gt(this.blocks.get(this.head)!.header.number)) { return null; }
    return this.canonical.get(n);
  }

  /**
   * The state after the block `p` names, which the world is moved to. Null for a block whose state is gone:
   * the world reaches the unfinalized blocks and the finalized one, and nothing older.
   */
  World? stateAt(this, JsonValue? p) {
    U256? b = this.blockFor(p);
    if (b is null || !this.blocks.has(b!) || !this.moveTo(b!)) { return null; }
    return this.world;
  }

  /** The index of a canonical transaction in its block, or −1. */
  i32 txWhere(this, U256 hash) {
    TxAt? t = this.txIndex.get(hash);
    if (t is null) { return -1; }
    Archived? a = this.archive.get(t!.block);
    if (a is null) { return -1; }
    U256? c = this.canonical.get(a!.header.number);
    if (c is null || !c!.eq(t!.block) || a!.header.number.gt(this.blocks.get(this.head)!.header.number)) { return -1; }
    return t!.index;
  }

  /** A transaction still in the mempool, as `eth_getTransactionByHash` reports one: with no block. */
  Answer pendingTx(this, U256 hash) {
    for (i32 i = 0; i < this.mempool.len(); i++) {
      DecodedTx d = decodeTransaction(this.mempool.get(i), this.chainId);
      if (U256.fromBytes(keccak256(d.raw), 0, 32).eq(hash)) { return Answer.ok(txJson(this.mempool.get(i), this.chainId, null, 0)); }
    }
    return Answer.ok(JsonValue.Null);
  }

  /**
   * eth_getLogs over a range of canonical blocks or one block by hash, filtered by address (one or a list)
   * and by topics position by position (null for any, one, or a list of alternatives).
   */
  Answer getLogs(this, JsonArray ps) {
    JsonValue? f = arg(ps, 0);
    if (f is null || f!.object() is null) { return Answer.error(-32602, "no filter"); }
    Vec<U256> blocks = Vec.create();
    if (f!.member("blockHash") is not null) {
      U256 h = hexU256(f!.member("blockHash"));
      if (!this.archive.has(h)) { return Answer.error(-32000, "unknown block"); }
      blocks.push(h);
    } else {
      U256? from = this.blockFor(f!.member("fromBlock"));
      U256? to = this.blockFor(f!.member("toBlock"));
      if (from is null || to is null) { return Answer.ok(JsonValue.Array(JsonArray.create())); }
      U256 lo = this.archive.get(from!)!.header.number;
      U256 hi = this.archive.get(to!)!.header.number;
      if (hi.sub(lo).gt(U256.ofU64(10000)) && !lo.gt(hi)) { return Answer.error(-32005, "query covers more than 10000 blocks"); }
      for (U256 n = lo; !n.gt(hi); n = n.add(U256.one())) {
        U256? h = this.canonical.get(n);
        if (h is not null && this.archive.has(h!)) { blocks.push(h!); }
      }
    }
    U256[] addresses = U256[].filled(0, U256.zero());
    JsonValue? av = f!.member("address");
    if (av is not null && !av!.isNull()) {
      JsonArray? list = av!.array();
      if (list is null) { addresses = [hexU256(av)]; }
      else {
        addresses = U256[].filled(list!.len(), U256.zero());
        for (i32 i = 0; i < list!.len(); i++) { addresses[i] = hexU256(list!.get(i)); }
      }
    }
    JsonArray topics = f!.member("topics")?.array() ?? JsonArray.create();
    JsonArray out = JsonArray.create();
    for (i32 b = 0; b < blocks.len(); b++) {
      Archived a = this.archive.get(blocks.get(b))!;
      i32 logIndex = 0;
      for (i32 t = 0; t < a.receipts.len(); t++) {
        Receipt r = a.receipts[t];
        for (i32 l = 0; l < r.logs.len(); l++) {
          if (logMatches(r.logs[l], addresses, topics)) { out.push(logJson(r.logs[l], a.header, r.txHash, t, logIndex)); }
          logIndex++;
        }
      }
    }
    return Answer.ok(JsonValue.Array(out));
  }

  /**
   * eth_estimateGas: the least gas limit with which the call succeeds, by bisection between the intrinsic
   * cost and the block's gas limit, each try a transaction run on the head's state and undone. The run
   * charges nothing for gas, as geth's does, so the sender needs only the value it sends.
   */
  Answer estimateGas(this, JsonArray ps) {
    JsonValue? c = arg(ps, 0);
    if (c is null || c!.object() is null) { return Answer.error(-32602, "no call object"); }
    Header h = this.blocks.get(this.head)!.header;
    U256 from = hexU256(c!.member("from"));
    World w = this.headState();
    JsonValue? toV = c!.member("to");
    U256? to = toV is null || toV!.isNull() ? null : hexU256(toV);
    u8[] input = c!.member("input") is not null ? hexBytes(c!.member("input")) : hexBytes(c!.member("data"));
    Transaction tx = Transaction(2, U256.ofU64(w.nonce(from)), U256.zero(), U256.zero(), U256.zero(), h.gasLimit, to,
                                 hexU256(c!.member("value")), input, Vec<AccessEntry>.create().toArray(), U256.zero(),
                                 U256[].filled(0, U256.zero()), Vec<Authorization>.create().toArray(), from);
    i64 lo = intrinsicGas(tx) - 1;
    i64 hi = h.gasLimit.low() as@ i64;
    Spec spec = this.config.specAt(h.timestamp.add(U256.ofU64(12)));
    if (spec.isOsaka && hi > 16777216) { hi = 16777216; }
    string why = this.tryGas(spec, h, tx, hi);
    if (why != "") { return Answer.error(3, why); }
    while (hi - lo > 1) {
      i64 mid = lo + (hi - lo) / 2;
      if (this.tryGas(spec, h, tx, mid) == "") { hi = mid; } else { lo = mid; }
    }
    return Answer.ok(str(U256.ofU64(hi as@ u64).toHex()));
  }

  /** "" when `tx` with gas limit `gas` succeeds as the next block's first transaction; otherwise why not. */
  string tryGas(this, Spec spec, Header h, Transaction tx, i64 gas) {
    tx.gasLimit = U256.ofU64(gas as@ u64);
    BlockEnv env = BlockEnv(h.coinbase, h.number.add(U256.one()), h.timestamp.add(U256.ofU64(12)), h.gasLimit,
                            h.prevRandao, U256.zero(), U256.zero(), this.chainId, this.ancestorHashes(h));
    this.world.record();
    Processed p = processTransaction(spec, this.world, env, tx, h.gasLimit.low() as@ i64, spec.maxBlobGasPerBlock, null);
    this.world.undo(this.world.seal());
    if (p.invalid != "") { return p.invalid; }
    return p.success ? "" : "execution reverted";
  }

  /**
   * eth_feeHistory: base fees and gas-used ratios for the last `count` canonical blocks, and the next base
   * fee. Reward percentiles are each block's least effective tip, which is honest for the blocks a devnet
   * makes and short of what a busy chain's distribution would say.
   */
  Answer feeHistory(this, JsonArray ps) {
    U256 count = hexU256(arg(ps, 0));
    if (count.isZero() || count.gt(U256.ofU64(1024))) { count = U256.ofU64(count.isZero() ? 1 : 1024); }
    U256? newest = this.blockFor(arg(ps, 1));
    if (newest is null) { return Answer.error(-32000, "unknown block"); }
    JsonArray? percentiles = arg(ps, 2)?.array();
    U256 top = this.archive.get(newest!)!.header.number;
    U256 oldest = count.gt(top) ? U256.zero() : top.sub(count).add(U256.one());
    JsonArray baseFees = JsonArray.create();
    JsonArray ratios = JsonArray.create();
    JsonArray rewards = JsonArray.create();
    Header last = this.archive.get(newest!)!.header;
    for (U256 n = oldest; !n.gt(top); n = n.add(U256.one())) {
      Archived a = this.archive.get(this.canonical.get(n)!)!;
      Header h = a.header;
      baseFees.push(str(h.baseFee.toHex()));
      f64 ratio = h.gasLimit.isZero() ? 0.0 : (h.gasUsed.low() as~ f64) / (h.gasLimit.low() as~ f64);
      ratios.push(JsonValue.Number(ratio, "\{ratio}".toBytes()));
      if (percentiles is not null) {
        U256 tip = U256.zero();
        for (i32 i = 0; i < a.receipts.len(); i++) {
          U256 t = a.receipts[i].effectiveGasPrice.sub(h.baseFee);
          if (i == 0 || t.lt(tip)) { tip = t; }
        }
        JsonArray r = JsonArray.create();
        for (i32 i = 0; i < percentiles!.len(); i++) { r.push(str(tip.toHex())); }
        rewards.push(JsonValue.Array(r));
      }
      last = h;
    }
    baseFees.push(str(nextBaseFee(last).toHex()));
    JsonObject o = JsonObject.create();
    o.push("oldestBlock".toBytes(), str(oldest.toHex()));
    o.push("baseFeePerGas".toBytes(), JsonValue.Array(baseFees));
    o.push("gasUsedRatio".toBytes(), JsonValue.Array(ratios));
    if (percentiles is not null) { o.push("reward".toBytes(), JsonValue.Array(rewards)); }
    return Answer.ok(JsonValue.Object(o));
  }

  /**
   * Import every orphan whose parent is now here, and their orphans in turn. Answers how many went in. The
   * sync target is cleared once it is a block this has.
   */
  i32 adoptOrphans(this) {
    i32 n = 0;
    bool more = true;
    while (more) {
      more = false;
      U256[] hashes = this.orphans.keys();
      for (i32 i = 0; i < hashes.len(); i++) {
        Orphan o = this.orphans.get(hashes[i])!;
        if (!this.blocks.has(o.block.header.parentHash)) { continue; }
        this.orphans.remove(hashes[i]);
        Answer a = this.importBlock(o.spec, o.block);
        if (a.result!.member("status")!.text()! == "VALID") {
          n++;
          more = true;
        }
      }
    }
    if (this.syncTarget is not null && this.blocks.has(this.syncTarget!)) { this.syncTarget = null; }
    return n;
  }

  /** The nonce after `from`'s run of mempool transactions starting at `nonce`. */
  u64 pendingNonce(this, U256 from, u64 nonce) {
    bool moved = true;
    while (moved) {
      moved = false;
      for (i32 i = 0; i < this.mempool.len(); i++) {
        DecodedTx d = decodeTransaction(this.mempool.get(i), this.chainId);
        if (d.error == "" && d.tx.sender.eq(from) && d.tx.nonce.eq(U256.ofU64(nonce))) {
          nonce++;
          moved = true;
        }
      }
    }
    return nonce;
  }

  /** Whether this client has the block, executed. */
  bool has(this, U256 hash) { return this.blocks.has(hash); }

  /** A canonical block's header by number, or any kept block's by hash, from the archive. */
  Header? headerByNumber(this, u64 n) {
    U256? h = this.canonical.get(U256.ofU64(n));
    if (h is null || U256.ofU64(n).gt(this.blocks.get(this.head)!.header.number)) { return null; }
    Archived? a = this.archive.get(h!);
    return a is null ? null : a!.header;
  }

  Header? headerByHash(this, U256 hash) {
    Archived? a = this.archive.get(hash);
    return a is null ? null : a!.header;
  }

  /** A block's body as eth's BlockBodies carries it — [transactions, ommers, withdrawals] — or null. */
  Item? bodyItem(this, U256 hash) {
    Archived? a = this.archive.get(hash);
    if (a is null) { return null; }
    Item[] ws = Item[].filled(a!.withdrawals.len(), Item.Bytes(u8[].filled(0, 0)));
    for (i32 i = 0; i < ws.len(); i++) {
      Withdrawal wd = a!.withdrawals[i];
      ws[i] = Item.List([Item.Bytes(u256Bytes(wd.index)), Item.Bytes(u256Bytes(wd.validator)), Item.Bytes(addressBytes(wd.address)),
                         Item.Bytes(u256Bytes(wd.amount))]);
    }
    return Item.List([Item.List(a!.txs), Item.List(Item[].filled(0, Item.Bytes(u8[].filled(0, 0)))), Item.List(ws)]);
  }

  /** The head's header. */
  Header headHeader(this) { return this.blocks.get(this.head)!.header; }

  /** The state at the head of the chain. */
  World headState(this) {
    this.moveTo(this.head);
    return this.world;
  }
}

/** The length of the RLP item starting at `at`, header included, or −1 if `b` ends before it does. */
i32 rlpLength(u8[] b, i32 at) {
  if (at >= b.len()) { return -1; }
  i32 p = b[at] as i32;
  i64 n = 0;
  if (p < 0x80) { n = 1; }
  else if (p < 0xb8) { n = 1 + (p - 0x80) as i64; }
  else if (p < 0xc0 || (p >= 0xf8)) {
    i32 ll = p < 0xc0 ? p - 0xb7 : p - 0xf7;
    if (at + ll >= b.len()) { return -1; }
    i64 len = 0;
    for (i32 i = 0; i < ll; i++) { len = len * 256 + (b[at + 1 + i] as i64); }
    n = 1 + (ll as i64) + len;
  } else { n = 1 + (p - 0xc0) as i64; }
  if ((at as i64) + n > (b.len() as i64)) { return -1; }
  return n as! i32;
}

/** The tip `eth_maxPriorityFeePerGas` suggests: 1 gwei, what a block with room to spare needs. */
static u64 SUGGESTED_TIP = 1000000000;

Answer unavailable() { return Answer.error(-32000, "the state of that block is not available"); }

/** Whether a log passes an eth_getLogs filter's addresses and topics. */
bool logMatches(Log l, U256[] addresses, JsonArray topics) {
  if (addresses.len() > 0) {
    bool any = false;
    for (i32 i = 0; i < addresses.len(); i++) { any = any || addresses[i].eq(l.address); }
    if (!any) { return false; }
  }
  for (i32 i = 0; i < topics.len(); i++) {
    JsonValue want = topics.get(i);
    if (want.isNull()) { continue; }
    if (i >= l.topics.len()) { return false; }
    JsonArray? alts = want.array();
    if (alts is null) {
      if (!hexU256(want).eq(l.topics[i])) { return false; }
    } else {
      bool any = alts!.len() == 0;
      for (i32 k = 0; k < alts!.len(); k++) { any = any || alts!.get(k).isNull() || hexU256(alts!.get(k)).eq(l.topics[i]); }
      if (!any) { return false; }
    }
  }
  return true;
}

// ── JSON helpers ─────────────────────────────────────────────────────────────────

JsonValue str(string s) { return JsonValue.Str(s.toBytes()); }

Answer status(string st, string latestValid, string why) {
  JsonObject o = JsonObject.create();
  o.push("status".toBytes(), str(st));
  o.push("latestValidHash".toBytes(), latestValid == "" ? JsonValue.Null : str(latestValid));
  o.push("validationError".toBytes(), why == "" ? JsonValue.Null : str(why));
  return Answer.ok(JsonValue.Object(o));
}

JsonValue forkchoiceResult(JsonValue payloadStatus) {
  JsonObject o = JsonObject.create();
  o.push("payloadStatus".toBytes(), payloadStatus);
  o.push("payloadId".toBytes(), JsonValue.Null);
  return JsonValue.Object(o);
}

JsonValue capabilities() {
  string[] names = ["engine_newPayloadV1", "engine_newPayloadV2", "engine_newPayloadV3", "engine_newPayloadV4",
                    "engine_forkchoiceUpdatedV1", "engine_forkchoiceUpdatedV2", "engine_forkchoiceUpdatedV3",
                    "engine_getPayloadV3", "engine_getPayloadV4", "engine_getPayloadV5", "engine_getBlobsV1",
                    "engine_getBlobsV2"];
  JsonArray a = JsonArray.create();
  for (i32 i = 0; i < names.len(); i++) { a.push(str(names[i])); }
  return JsonValue.Array(a);
}

/** A quantity or data field as a number, zero when absent or malformed. */
U256 hexU256(JsonValue? v) {
  if (v is null) { return U256.zero(); }
  string? s = v!.text();
  if (s is null || s! == "0x") { return U256.zero(); }
  return U256.fromHex(s!) ?? U256.zero();
}

u8[] hexBytes(JsonValue? v) {
  if (v is null) { return u8[].filled(0, 0); }
  return hexToBytes(v!.text() ?? "") ?? u8[].filled(0, 0);
}

/** A transaction's own encoding from its item in a block body: a legacy one's RLP, a typed one's bytes. */
export u8[] rawOf(Item it) { return isList(it) ? encode(it) : bytesOf(it); }

/** A transaction's bytes as the block body's item: a legacy one is its RLP list, a typed one opaque bytes. */
export Item? txItem(u8[] raw) {
  if (raw.len() == 0) { return null; }
  if ((raw[0] as i32) >= 0xc0) {
    Decoded d = decode(raw);
    return d.ok ? d.item : null;
  }
  return Item.Bytes(raw);
}

Withdrawal[] withdrawalsFrom(JsonValue? v) {
  JsonArray a = v?.array() ?? JsonArray.create();
  Withdrawal[] out = Withdrawal[].filled(a.len(), Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero()));
  for (i32 i = 0; i < a.len(); i++) {
    JsonValue w = a.get(i);
    out[i] = Withdrawal(hexU256(w.member("index")), hexU256(w.member("validatorIndex")), hexU256(w.member("address")),
                        hexU256(w.member("amount")));
  }
  return out;
}

Header headerFrom(JsonValue p) {
  u8[] bloom = hexBytes(p.member("logsBloom"));
  return Header(hexU256(p.member("parentHash")), U256.fromHex(EMPTY_OMMERS)!, hexU256(p.member("feeRecipient")),
                hexU256(p.member("stateRoot")), U256.zero(), hexU256(p.member("receiptsRoot")),
                bloom.len() == 256 ? bloom : u8[].filled(256, 0), U256.zero(), hexU256(p.member("blockNumber")),
                hexU256(p.member("gasLimit")), hexU256(p.member("gasUsed")), hexU256(p.member("timestamp")),
                hexBytes(p.member("extraData")), hexU256(p.member("prevRandao")), u8[].filled(8, 0),
                hexU256(p.member("baseFeePerGas")), U256.zero(), hexU256(p.member("blobGasUsed")),
                hexU256(p.member("excessBlobGas")), U256.zero(), U256.zero(), U256.zero());
}


/** 32 bytes as 0x and 64 digits, leading zeros kept: a hash, not a quantity. */
string hex32(U256 v) { return bytesToHex(v.toBytes()); }

/** A payload id: eight bytes, written in full. */
string hex8(U256 v) {
  u8[] b = v.toBytes();
  u8[] out = u8[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) { out[i] = b[24 + i]; }
  return bytesToHex(out);
}

/** Param `i`, or JSON null when there are fewer. */
JsonValue? arg(JsonArray ps, i32 i) { return i < ps.len() ? ps.get(i) : null; }
