// The precompiled contracts, whose "code" is a native function: 0x01 to 0x0a in Cancun, EIP-2537's BLS12-381
// operations at 0x0b to 0x11 from Prague, and P256VERIFY at 0x100 from Osaka.
//
// A precompile that runs out of gas, or is handed input it refuses, fails like any frame: all the gas it
// was given is gone and the caller sees 0.

import { crypto.sha256 } from "wac";
import { ecrecover } from "../precompiles/ecrecover.wac";
import { ripemd160 } from "../precompiles/ripemd160.wac";
import { modexp, modexpGas } from "../precompiles/modexp.wac";
import { blake2f, blake2fRounds } from "../precompiles/blake2f.wac";
import { ecAdd, ecMul, ecPairing } from "../crypto/bn254.wac";
import { crypto.p256VerifyDigest } from "wac";
import { pointEvaluation, g1AddOp, g2AddOp, g1MsmOp, g2MsmOp, pairingOp, mapFpToG1Op, mapFp2ToG2Op, msmGas,
         pairingGas } from "../precompiles/bls.wac";
import { U256 } from "../u256.wac";
import { Outcome, Halt } from "./interp.wac";
import { Spec } from "./spec.wac";

export bool isPrecompile(Spec spec, U256 a) {
  if (!a.fitsU64()) { return false; }
  return (a.low() >= 1 && a.low() <= spec.lastPrecompile) || (spec.isOsaka && a.low() == P256VERIFY);
}

/** EIP-7951's address: the first precompile outside the range the others fill. */
static u64 P256VERIFY = 0x100;

/** The precompile addresses, which every transaction starts with warm (EIP-2929). */
export U256[] precompileAddresses(Spec spec) {
  i32 n = spec.lastPrecompile as! i32;
  U256[] out = U256[].filled(spec.isOsaka ? n + 1 : n, U256.zero());
  for (i32 i = 0; i < n; i++) { out[i] = U256.ofI32(i + 1); }
  if (spec.isOsaka) { out[n] = U256.ofU64(P256VERIFY); }
  return out;
}

i64 words(i32 len) { return ((len as i64) + 31) / 32; }

Outcome charged(i64 gas, i64 cost, u8[] output) {
  if (cost > gas) { return Outcome(Halt.Failure("out of gas in a precompile"), 0); }
  return Outcome(Halt.Return(output), gas - cost);
}

export Outcome runPrecompile(Spec spec, U256 addr, u8[] input, i64 gas) {
  i64 w = words(input.len());
  switch (addr.low() as! i32) {
    case 0x01: {
      if (gas < 3000) { return outOfGas(); }
      return Outcome(Halt.Return(ecrecover(input)), gas - 3000);
    }
    case 0x02: { return charged(gas, 60 + 12 * w, sha256(input)); }
    case 0x03: {
      if (gas < 600 + 120 * w) { return outOfGas(); }
      u8[] h = ripemd160(input);
      u8[] out = u8[].filled(32, 0);
      for (i32 i = 0; i < 20; i++) { out[12 + i] = h[i]; }
      return Outcome(Halt.Return(out), gas - 600 - 120 * w);
    }
    case 0x04: { return charged(gas, 15 + 3 * w, input); }
    case 0x05: {
      i64 cost = modexpGas(input, spec.isOsaka);
      if (cost < 0 || cost > gas) { return outOfGas(); }
      return Outcome(Halt.Return(modexp(input)), gas - cost);
    }
    case 0x06: { return checked(gas, 150, gas < 150 ? null : ecAdd(input)); }
    case 0x07: { return checked(gas, 6000, gas < 6000 ? null : ecMul(input)); }
    case 0x08: {
      i64 cost = 45000 + 34000 * ((input.len() / 192) as i64);
      return checked(gas, cost, gas < cost ? null : ecPairing(input));
    }
    case 0x09: {
      i64 rounds = blake2fRounds(input);
      if (rounds < 0) { return Outcome(Halt.Failure("malformed BLAKE2F input"), 0); }
      if (rounds > gas) { return outOfGas(); }
      return Outcome(Halt.Return(blake2f(input)), gas - rounds);
    }
    case 0x0a: { return checked(gas, 50000, gas < 50000 ? null : pointEvaluation(input)); }
    case 0x0b: { return checked(gas, 375, gas < 375 ? null : g1AddOp(input)); }
    case 0x0c: {
      i64 cost = msmGas(input.len(), false);
      return checked(gas, cost, gas < cost ? null : g1MsmOp(input));
    }
    case 0x0d: { return checked(gas, 600, gas < 600 ? null : g2AddOp(input)); }
    case 0x0e: {
      i64 cost = msmGas(input.len(), true);
      return checked(gas, cost, gas < cost ? null : g2MsmOp(input));
    }
    case 0x0f: {
      i64 cost = pairingGas(input.len());
      return checked(gas, cost, gas < cost ? null : pairingOp(input));
    }
    case 0x10: { return checked(gas, 5500, gas < 5500 ? null : mapFpToG1Op(input)); }
    case 0x11: { return checked(gas, 23800, gas < 23800 ? null : mapFp2ToG2Op(input)); }
    case 0x100: {
      // EIP-7951: a bad signature, key or length is an empty answer, not a failure — the gas is paid either way.
      if (gas < 6900) { return outOfGas(); }
      return Outcome(Halt.Return(p256verify(input)), gas - 6900);
    }
    default: { return Outcome(Halt.Failure("precompile 0x\{addr.low() as! i32} is not implemented"), 0); }
  }
}

Outcome outOfGas() { return Outcome(Halt.Failure("out of gas in a precompile"), 0); }

/** A precompile that may refuse its input: null output is a failure, which consumes everything. */
Outcome checked(i64 gas, i64 cost, u8[]? output) {
  if (cost > gas) { return outOfGas(); }
  if (output is null) { return Outcome(Halt.Failure("precompile refused its input"), 0); }
  return Outcome(Halt.Return(output!), gas - cost);
}

/**
 * P256VERIFY (EIP-7951): 160 bytes — the digest, r, s and the key's x and y — and 32 bytes ending in 1 when
 * the signature verifies. wac's verifier applies the EIP's rules itself: r and s in [1, n), the key on the
 * curve and not at infinity.
 */
u8[] p256verify(u8[] input) {
  u8[] none = u8[].filled(0, 0);
  if (input.len() != 160) { return none; }
  u8[] digest = u8[].filled(32, 0);
  u8[] sig = u8[].filled(64, 0);
  u8[] key = u8[].filled(65, 0);
  key[0] = 0x04;
  for (i32 i = 0; i < 32; i++) { digest[i] = input[i]; }
  for (i32 i = 0; i < 64; i++) { sig[i] = input[32 + i]; }
  for (i32 i = 0; i < 64; i++) { key[1 + i] = input[96 + i]; }
  if (!p256VerifyDigest(key, digest, sig)) { return none; }
  u8[] out = u8[].filled(32, 0);
  out[31] = 1;
  return out;
}
