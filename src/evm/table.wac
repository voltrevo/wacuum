// What each opcode takes from the stack, gives back, and costs before anything dynamic — one row per
// opcode, so the interpreter checks underflow, overflow and static gas once, before dispatch, rather than
// in 140 places.
//
// The costs are the Cancun schedule's. An opcode this interpreter does not implement yet is simply absent,
// and so executes as INVALID — which is the honest answer until it is here, because it is what an opcode
// the fork does not define does.

export struct OpTable {
  /** Static gas, or -1 for an opcode that is not defined. */
  i64[] gas;
  i32[] pops;
  i32[] pushes;
  string[] names;

  OpTable cancun() {
    OpTable t = OpTable(i64[].filled(256, -1), i32[].filled(256, 0), i32[].filled(256, 0), string[].defaulted(256));
    t.def(0x00, "STOP", 0, 0, 0);
    t.def(0x01, "ADD", 3, 2, 1);
    t.def(0x02, "MUL", 5, 2, 1);
    t.def(0x03, "SUB", 3, 2, 1);
    t.def(0x04, "DIV", 5, 2, 1);
    t.def(0x05, "SDIV", 5, 2, 1);
    t.def(0x06, "MOD", 5, 2, 1);
    t.def(0x07, "SMOD", 5, 2, 1);
    t.def(0x08, "ADDMOD", 8, 3, 1);
    t.def(0x09, "MULMOD", 8, 3, 1);
    t.def(0x0a, "EXP", 10, 2, 1);
    t.def(0x0b, "SIGNEXTEND", 5, 2, 1);
    t.def(0x10, "LT", 3, 2, 1);
    t.def(0x11, "GT", 3, 2, 1);
    t.def(0x12, "SLT", 3, 2, 1);
    t.def(0x13, "SGT", 3, 2, 1);
    t.def(0x14, "EQ", 3, 2, 1);
    t.def(0x15, "ISZERO", 3, 1, 1);
    t.def(0x16, "AND", 3, 2, 1);
    t.def(0x17, "OR", 3, 2, 1);
    t.def(0x18, "XOR", 3, 2, 1);
    t.def(0x19, "NOT", 3, 1, 1);
    t.def(0x1a, "BYTE", 3, 2, 1);
    t.def(0x1b, "SHL", 3, 2, 1);
    t.def(0x1c, "SHR", 3, 2, 1);
    t.def(0x1d, "SAR", 3, 2, 1);
    t.def(0x20, "KECCAK256", 30, 2, 1);
    t.def(0x35, "CALLDATALOAD", 3, 1, 1);
    t.def(0x36, "CALLDATASIZE", 2, 0, 1);
    t.def(0x37, "CALLDATACOPY", 3, 3, 0);
    t.def(0x38, "CODESIZE", 2, 0, 1);
    t.def(0x39, "CODECOPY", 3, 3, 0);
    t.def(0x3d, "RETURNDATASIZE", 2, 0, 1);
    t.def(0x3e, "RETURNDATACOPY", 3, 3, 0);
    t.def(0x50, "POP", 2, 1, 0);
    t.def(0x51, "MLOAD", 3, 1, 1);
    t.def(0x52, "MSTORE", 3, 2, 0);
    t.def(0x53, "MSTORE8", 3, 2, 0);
    t.def(0x56, "JUMP", 8, 1, 0);
    t.def(0x57, "JUMPI", 10, 2, 0);
    t.def(0x58, "PC", 2, 0, 1);
    t.def(0x59, "MSIZE", 2, 0, 1);
    t.def(0x5a, "GAS", 2, 0, 1);
    t.def(0x5b, "JUMPDEST", 1, 0, 0);
    t.def(0x5e, "MCOPY", 3, 3, 0);
    t.def(0x5f, "PUSH0", 2, 0, 1);
    for (i32 n = 1; n <= 32; n++) { t.def(0x5f + n, "PUSH\{n}", 3, 0, 1); }
    // DUPn needs n items and leaves n + 1; SWAPn needs n + 1 and leaves as many.
    for (i32 n = 1; n <= 16; n++) {
      t.def(0x7f + n, "DUP\{n}", 3, n, n + 1);
      t.def(0x8f + n, "SWAP\{n}", 3, n + 1, n + 1);
    }
    t.def(0xf3, "RETURN", 0, 2, 0);
    t.def(0xfd, "REVERT", 0, 2, 0);
    return t;
  }

  void def(this, i32 op, string name, i64 gas, i32 pops, i32 pushes) {
    this.gas[op] = gas;
    this.names[op] = name;
    this.pops[op] = pops;
    this.pushes[op] = pushes;
  }

  bool defined(const this, i32 op) { return this.gas[op] >= 0; }
}
