// EIP-4844's blob proofs: `verify_blob_kzg_proof` from the consensus specs' polynomial commitments.
//
// A blob is 4096 field elements mod r, the evaluations of a polynomial at the 4096th roots of unity (in
// bit-reversed order). Its proof is an ordinary KZG opening at a point the verifier derives from the blob
// and commitment by hashing (Fiat–Shamir), so checking it is: derive z, evaluate the polynomial at z from
// its evaluations by the barycentric formula, and check the opening with one pairing. Nothing of the
// ceremony's setup is needed but [τ]G2, which point evaluation already has.
//
// The field arithmetic is U256's MULMOD, which is slow per operation and does about 25,000 of them here;
// that is a few tens of milliseconds, paid once per blob as it enters the mempool.

import { crypto.sha256 } from "wac";
import { U256 } from "../u256.wac";
import { kzgProofHolds, scalarAt } from "../precompiles/bls.wac";

static i32 WIDTH = 4096;

U256 modulus() { return U256.fromHex("73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001")!; }

U256 pow(U256 a, U256 e, U256 r) {
  U256 acc = U256.one();
  for (i32 bit = 255; bit >= 0; bit--) {
    acc = acc.mulmod(acc, r);
    if (!e.shr(bit).and(U256.one()).isZero()) { acc = acc.mulmod(a, r); }
  }
  return acc;
}

/** The 4096th roots of unity, ω = 7^((r−1)/4096) to the powers 0…4095, in bit-reversed order. */
U256[] rootsBitReversed(U256 r) {
  U256 w = pow(U256.ofU64(7), r.sub(U256.one()).div(U256.ofI32(WIDTH)), r);
  U256[] out = U256[].filled(WIDTH, U256.zero());
  U256 x = U256.one();
  for (i32 i = 0; i < WIDTH; i++) {
    i32 rev = 0;
    for (i32 b = 0; b < 12; b++) { rev = rev | (((i >> b) & 1) << (11 - b)); }
    out[rev] = x;
    x = x.mulmod(w, r);
  }
  return out;
}

/**
 * Whether `proof` proves `blob` against `commitment`. False for a blob whose elements are not all below r,
 * and for a commitment or proof that is not a point in G1.
 */
export bool verifyBlobProof(u8[] blob, u8[] commitment, u8[] proof) {
  if (blob.len() != 32 * WIDTH || commitment.len() != 48 || proof.len() != 48) { return false; }
  U256 r = modulus();
  U256[] f = U256[].filled(WIDTH, U256.zero());
  for (i32 i = 0; i < WIDTH; i++) {
    f[i] = U256.fromBytes(blob, 32 * i, 32);
    if (!f[i].lt(r)) { return false; }
  }

  // z = sha256("FSBLOBVERIFY_V1_" ‖ 4096 as 16 bytes ‖ blob ‖ commitment) mod r.
  u8[] domain = "FSBLOBVERIFY_V1_".toBytes();
  u8[] data = u8[].filled(16 + 16 + blob.len() + 48, 0);
  for (i32 i = 0; i < 16; i++) { data[i] = domain[i]; }
  data[30] = 0x10;
  for (i32 i = 0; i < blob.len(); i++) { data[32 + i] = blob[i]; }
  for (i32 i = 0; i < 48; i++) { data[32 + blob.len() + i] = commitment[i]; }
  U256 z = U256.fromBytes(sha256(data), 0, 32).mod(r);

  // y = (z^4096 − 1)/4096 · Σ fᵢ·ωᵢ/(z − ωᵢ), or fᵢ itself when z is a root ωᵢ. The 4096 divisions share
  // one inversion (Montgomery's trick): invert the product, then peel each factor off it.
  U256[] roots = rootsBitReversed(r);
  U256[] d = U256[].filled(WIDTH, U256.zero());
  U256[] prefix = U256[].filled(WIDTH, U256.zero());
  U256 acc = U256.one();
  for (i32 i = 0; i < WIDTH; i++) {
    if (z.eq(roots[i])) { return kzgProofHolds(commitment, scalarAt(z.toBytes(), 0), scalarAt(f[i].toBytes(), 0), proof); }
    d[i] = z.addmod(r.sub(roots[i]), r);
    prefix[i] = acc;
    acc = acc.mulmod(d[i], r);
  }
  U256 inv = pow(acc, r.sub(U256.ofU64(2)), r);
  U256 sum = U256.zero();
  for (i32 i = WIDTH - 1; i >= 0; i--) {
    U256 invD = inv.mulmod(prefix[i], r);
    inv = inv.mulmod(d[i], r);
    sum = sum.addmod(f[i].mulmod(roots[i], r).mulmod(invD, r), r);
  }
  U256 zn = pow(z, U256.ofI32(WIDTH), r).addmod(r.sub(U256.one()), r);
  U256 y = sum.mulmod(zn, r).mulmod(pow(U256.ofI32(WIDTH), r.sub(U256.ofU64(2)), r), r);
  return kzgProofHolds(commitment, scalarAt(z.toBytes(), 0), scalarAt(y.toBytes(), 0), proof);
}
