// EIP-7594's cell proofs: `verify_cell_kzg_proof_batch` from the consensus specs' PeerDAS polynomial
// commitments, for the sidecars Osaka's blob transactions carry.
//
// A blob's polynomial is extended to 8192 evaluations and cut into 128 cells of 64, each the evaluations on
// one coset h·⟨ω₆₄⟩ of the 64th roots of unity, in bit-reversed order. A cell proof is a KZG proof that the
// committed polynomial agrees there with the cell's interpolation polynomial I, of degree below 64:
//
//     e(C − [I(τ)]G1 + h⁶⁴·π, G2) = e(π, [τ⁶⁴]G2)
//
// Many are checked at once by a random linear combination with powers of a Fiat–Shamir challenge r, so a
// whole transaction's cells cost two pairings. Committing to I needs the ceremony's first 64 monomial G1
// points and [τ⁶⁴]G2, which are below; nothing else of the setup is.
//
// The scalar arithmetic is in a Montgomery field mod r; the G1 sums are a multiplication each, which is
// the slow part, and a multi-scalar multiplication would be the thing to change if it matters.

import { crypto.sha256 } from "wac";
import { bls.G1, bls.G2, bls.Pair, bls.Fp12, bls.g1Infinity, bls.g1IsInfinity, bls.g1Add, bls.g1Mul, bls.g1Negate,
         bls.g1FromBytes, bls.g1AffineX, bls.g1AffineY, bls.g2FromBytes, bls.g2Generator, bls.g2Negate, bls.g2AffineX,
         bls.g2AffineY, bls.millerLoopMulti, bls.finalExponentiate, bls.fp12IsOne } from "wac";
import { U256 } from "../u256.wac";
import { hexToBytes } from "../hex.wac";
import { Field } from "./field.wac";

export static i32 CELL_ELEMENTS = 64;
export static i32 CELLS = 128;

