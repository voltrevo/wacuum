/** [τ⁶⁴]G2. */
static string TAU64_G2 = "92dcc5a1c8c3e1b28b1524e3dd6dbecd63017c9201da9dbe077f1b82adc08c50169f56fc7b5a3b28ec6b89254de3e2fd12838a761053437883c3e01ba616670cea843754548ef84bcc397de2369adcca2ab54cd73c55dc68d87aec3fc2fe4f10";

U256 modulus() { return U256.fromHex("73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001")!; }

i32 reverseBits(i32 v, i32 bits) {
  i32 out = 0;
  for (i32 b = 0; b < bits; b++) { out = out | (((v >> b) & 1) << (bits - 1 - b)); }
  return out;
}

u8[] be64(i32 v) {
  u8[] out = u8[].filled(8, 0);
  for (i32 i = 0; i < 4; i++) { out[7 - i] = ((v >> (8 * i)) & 0xff) as! u8; }
  return out;
}

/** A scalar as `bls` takes one: eight 32-bit limbs, least significant first. */
u32[] limbs(U256 v) {
  u8[] b = v.toBytes();
  u32[] k = u32[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) {
    i32 o = 28 - 4 * i;
    k[i] = ((b[o] as u32) << 24) | ((b[o + 1] as u32) << 16) | ((b[o + 2] as u32) << 8) | (b[o + 3] as u32);
  }
  return k;
}

/**
 * Whether every `proofs[k]` proves `cells[k]` to be cell `indices[k]` of the blob `commitments[k]` commits to.
 * False too for a malformed commitment, proof or cell, or a cell index past 127.
 */
export bool verifyCellProofs(u8[][] commitments, i32[] indices, u8[][] cells, u8[][] proofs) {
  i32 n = cells.len();
  if (commitments.len() != n || indices.len() != n || proofs.len() != n) { return false; }
  if (n == 0) { return true; }
  U256 r = modulus();
  Field f = Field.create(r);

  // The commitments, each once, and which one each cell is of.
  u8[][] unique = u8[][].defaulted(0);
  i32[] which = i32[].filled(n, 0);
  for (i32 k = 0; k < n; k++) {
    if (commitments[k].len() != 48 || cells[k].len() != 32 * CELL_ELEMENTS || proofs[k].len() != 48) { return false; }
    if (indices[k] < 0 || indices[k] >= CELLS) { return false; }
    i32 found = -1;
    for (i32 u = 0; u < unique.len() && found < 0; u++) {
      bool same = true;
      for (i32 b = 0; b < 48 && same; b++) { same = unique[u][b] == commitments[k][b]; }
      if (same) { found = u; }
    }
    if (found < 0) {
      u8[][] grown = u8[][].defaulted(unique.len() + 1);
      for (i32 u = 0; u < unique.len(); u++) { grown[u] = unique[u]; }
      grown[unique.len()] = commitments[k];
      found = unique.len();
      unique = grown;
    }
    which[k] = found;
  }

  // The challenge: everything above, hashed.
  i32 size = 16 + 24 + 48 * unique.len() + 16 * n + (32 * CELL_ELEMENTS + 48) * n;
  u8[] t = u8[].filled(size, 0);
  i32 at = 0;
  u8[] domain = "RCKZGCBATCH__V1_".toBytes();
  for (i32 i = 0; i < 16; i++) { t[at + i] = domain[i]; }
  at += 16;
  u8[][] counts = [be64(CELL_ELEMENTS), be64(unique.len()), be64(n)];
  for (i32 c = 0; c < 3; c++) {
    for (i32 i = 0; i < 8; i++) { t[at + i] = counts[c][i]; }
    at += 8;
  }
  for (i32 u = 0; u < unique.len(); u++) {
    for (i32 i = 0; i < 48; i++) { t[at + i] = unique[u][i]; }
    at += 48;
  }
  for (i32 k = 0; k < n; k++) {
    u8[] w = be64(which[k]);
    for (i32 i = 0; i < 8; i++) { t[at + i] = w[i]; }
    at += 8;
  }
  for (i32 k = 0; k < n; k++) {
    u8[] w = be64(indices[k]);
    for (i32 i = 0; i < 8; i++) { t[at + i] = w[i]; }
    at += 8;
  }
  for (i32 k = 0; k < n; k++) {
    for (i32 i = 0; i < cells[k].len(); i++) { t[at + i] = cells[k][i]; }
    at += cells[k].len();
  }
  for (i32 k = 0; k < n; k++) {
    for (i32 i = 0; i < 48; i++) { t[at + i] = proofs[k][i]; }
    at += 48;
  }
  u64[] chal = f.fromU256(U256.fromBytes(sha256(t), 0, 32).mod(r));

  // The 8192nd roots of unity, ω⁰…: each cell's coset shift is a power of ω, and ω¹²⁸ generates the 64th.
  u64[] w8192 = f.pow(f.fromU256(U256.ofU64(7)), r.sub(U256.one()).div(U256.ofU64(8192)));
  u64[] w64 = f.pow(w8192, U256.ofU64(128));
  u64[] w64inv = f.inv(w64);

  // Powers of r, and each cell's evaluations folded into its row, weighted by its power.
  u64[][] rp = u64[][].defaulted(n);
  rp[0] = f.one();
  for (i32 k = 1; k < n; k++) { rp[k] = f.mul(rp[k - 1], chal); }
  // Each row (cell index) used, and its folded evaluations; a row nobody sent is skipped.
  bool[] used = bool[].filled(CELLS, false);
  u64[][][] rows = u64[][][].filled(CELLS, u64[][].defaulted(0));
  for (i32 k = 0; k < n; k++) {
    i32 row = indices[k];
    if (!used[row]) {
      used[row] = true;
      u64[][] zeros = u64[][].defaulted(CELL_ELEMENTS);
      for (i32 j = 0; j < CELL_ELEMENTS; j++) { zeros[j] = f.zero(); }
      rows[row] = zeros;
    }
    for (i32 j = 0; j < CELL_ELEMENTS; j++) {
      U256 v = U256.fromBytes(cells[k], 32 * j, 32);
      if (!v.lt(r)) { return false; }
      u64[][] cur = rows[row];
      cur[j] = f.add(cur[j], f.mul(f.fromU256(v), rp[k]));
    }
  }

  // The aggregate interpolation polynomial: for each row used, the inverse DFT of its evaluations (which
  // are in bit-reversed order) gives I(h·x), and dividing coefficient i by hⁱ gives I(x).
  u64[] inv64 = f.inv(f.fromU256(U256.ofU64(64)));
  u64[][] agg = u64[][].defaulted(CELL_ELEMENTS);
  for (i32 i = 0; i < CELL_ELEMENTS; i++) { agg[i] = f.zero(); }
  for (i32 row = 0; row < CELLS; row++) {
    if (!used[row]) { continue; }
    u64[][] natural = u64[][].defaulted(CELL_ELEMENTS);
    u64[][] evals = rows[row];
    for (i32 j = 0; j < CELL_ELEMENTS; j++) { natural[j] = evals[reverseBits(j, 6)]; }
    u64[] hInv = f.inv(f.pow(w8192, U256.ofI32(reverseBits(row, 7))));
    u64[] shift = f.one();
    u64[] wk = f.one();
    for (i32 i = 0; i < CELL_ELEMENTS; i++) {
      // c_i = (1/64)·Σ_j v_j·ω₆₄^(−ij)
      u64[] c = f.zero();
      u64[] wij = f.one();
      for (i32 j = 0; j < CELL_ELEMENTS; j++) {
        c = f.add(c, f.mul(natural[j], wij));
        wij = f.mul(wij, wk);
      }
      agg[i] = f.add(agg[i], f.mul(f.mul(c, inv64), shift));
      shift = f.mul(shift, hInv);
      wk = f.mul(wk, w64inv);
    }
  }

  // The three G1 sums: commitments by their summed weights, minus the interpolation's commitment, plus
  // each proof by its weight times its coset shift to the 64th; and the proofs by their weights alone.
  G1 lhs = g1Infinity();
  for (i32 u = 0; u < unique.len(); u++) {
    u64[] weight = f.zero();
    for (i32 k = 0; k < n; k++) {
      if (which[k] == u) { weight = f.add(weight, rp[k]); }
    }
    G1? c = g1FromBytes(unique[u]);
    if (c is null) { return false; }
    lhs = g1Add(lhs, g1Mul(c!, limbs(f.toU256(weight))));
  }
  G1 interp = g1Infinity();
  for (i32 i = 0; i < CELL_ELEMENTS; i++) {
    G1 p = g1FromBytes(hexToBytes(G1_MONOMIAL[i])!)!;
    interp = g1Add(interp, g1Mul(p, limbs(f.toU256(agg[i]))));
  }
  lhs = g1Add(lhs, g1Negate(interp));
  G1 proofSum = g1Infinity();
  for (i32 k = 0; k < n; k++) {
    G1? p = g1FromBytes(proofs[k]);
    if (p is null) { return false; }
    u64[] hk64 = f.pow(w8192, U256.ofI32((reverseBits(indices[k], 7) * CELL_ELEMENTS) % 8192));
    lhs = g1Add(lhs, g1Mul(p!, limbs(f.toU256(f.mul(rp[k], hk64)))));
    proofSum = g1Add(proofSum, g1Mul(p!, limbs(f.toU256(rp[k]))));
  }

  // e(lhs, G2) · e(proofSum, −[τ⁶⁴]G2) = 1
  G2 tau64 = g2FromBytes(hexToBytes(TAU64_G2)!)!;
  G1[] g1s = [lhs, proofSum];
  G2[] g2s = [g2Generator(), g2Negate(tau64)];
  i32 m = 0;
  for (i32 i = 0; i < 2; i++) {
    if (!g1IsInfinity(g1s[i])) { m++; }
  }
  if (m == 0) { return true; }
  Pair[] pairs = Pair[].defaulted(m);
  i32 j = 0;
  for (i32 i = 0; i < 2; i++) {
    if (g1IsInfinity(g1s[i])) { continue; }
    pairs[j] = Pair(g1AffineX(g1s[i])!, g1AffineY(g1s[i])!, g2AffineX(g2s[i])!, g2AffineY(g2s[i])!);
    j++;
  }
  Fp12? e = finalExponentiate(millerLoopMulti(pairs));
  return e is not null && fp12IsOne(e!);
}

/** An in-place radix-2 NTT of `a` (length a power of two) with `w` a primitive root of that order. */
void ntt(Field f, u64[][] a, u64[] w) {
  i32 n = a.len();
  i32 bits = 0;
  while ((1 << bits) < n) { bits++; }
  for (i32 i = 0; i < n; i++) {
    i32 j = reverseBits(i, bits);
    if (j > i) {
      u64[] tmp = a[i];
      a[i] = a[j];
      a[j] = tmp;
    }
  }
  for (i32 len = 2; len <= n; len = len * 2) {
    u64[] step = f.pow(w, U256.ofI32(n / len));
    for (i32 start = 0; start < n; start += len) {
      u64[] wk = f.one();
      for (i32 k = 0; k < len / 2; k++) {
        u64[] u = a[start + k];
        u64[] v = f.mul(a[start + k + len / 2], wk);
        a[start + k] = f.add(u, v);
        a[start + k + len / 2] = f.sub(u, v);
        wk = f.mul(wk, step);
      }
    }
  }
}

/**
 * A blob's 128 cells, each 64 elements of 32 bytes: its polynomial's evaluations on the 8192nd roots of
 * unity, in bit-reversed order, cut in 64s. Null for a blob with an element not below r.
 */
export u8[][]? computeCells(u8[] blob) {
  if (blob.len() != 131072) { return null; }
  U256 r = modulus();
  Field f = Field.create(r);
  u64[] w8192 = f.pow(f.fromU256(U256.ofU64(7)), r.sub(U256.one()).div(U256.ofU64(8192)));
  u64[] w4096 = f.square(w8192);
  // The blob holds its polynomial's values at the 4096th roots in bit-reversed order; natural order first.
  u64[][] a = u64[][].defaulted(8192);
  for (i32 j = 0; j < 4096; j++) {
    U256 v = U256.fromBytes(blob, 32 * reverseBits(j, 12), 32);
    if (!v.lt(r)) { return null; }
    a[j] = f.fromU256(v);
  }
  u64[][] half = u64[][].defaulted(4096);
  for (i32 j = 0; j < 4096; j++) { half[j] = a[j]; }
  // Coefficients, by the inverse transform: ω⁻¹, then a factor of 1/4096.
  ntt(f, half, f.inv(w4096));
  u64[] inv4096 = f.inv(f.fromU256(U256.ofU64(4096)));
  for (i32 j = 0; j < 4096; j++) { a[j] = f.mul(half[j], inv4096); }
  for (i32 j = 4096; j < 8192; j++) { a[j] = f.zero(); }
  ntt(f, a, w8192);
  u8[][] cells = u8[][].defaulted(CELLS);
  for (i32 c = 0; c < CELLS; c++) {
    u8[] cell = u8[].filled(32 * CELL_ELEMENTS, 0);
    for (i32 j = 0; j < CELL_ELEMENTS; j++) {
      f.toU256(a[reverseBits(64 * c + j, 13)]).writeBytes(cell, 32 * j);
    }
    cells[c] = cell;
  }
  return cells;
}
